<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- Clinical Medical Light Color Palette -->
    <Color x:Key="Color.Background.Dark">#F8FAFC</Color> <!-- Slate 50 canvas -->
    <Color x:Key="Color.Surface.Card">#FFFFFF</Color> <!-- Pure White Card -->
    <Color x:Key="Color.Surface.Elevated">#F1F5F9</Color> <!-- Slate 100 -->
    <Color x:Key="Color.Surface.Hover">#E2E8F0</Color> <!-- Slate 200 -->
    <Color x:Key="Color.Border.Default">#CBD5E1</Color> <!-- Slate 300 -->
    <Color x:Key="Color.Border.Highlight">#2563EB</Color> <!-- Cobalt Blue -->
    <Color x:Key="Color.Border.DropTarget">#0E7490</Color> <!-- Cyan 700 (5.36:1 with white) -->
    <Color x:Key="Color.Accent.Primary">#2563EB</Color> <!-- Cobalt Blue 600 -->
    <Color x:Key="Color.Accent.PrimaryHover">#1D4ED8</Color> <!-- Cobalt Blue 700 -->
    <Color x:Key="Color.Status.Online">#047857</Color> <!-- Emerald 700 -->
    <Color x:Key="Color.Status.Offline">#5B6B82</Color> <!-- Same grey as Text.Muted: 3:1 as a dot on every surface -->
    <Color x:Key="Color.Status.Routed">#2563EB</Color> <!-- Cobalt Blue 600 -->
    <Color x:Key="Color.Text.Primary">#0F172A</Color> <!-- Slate 900 (15.8:1 AAA contrast) -->
    <Color x:Key="Color.Text.Secondary">#475569</Color> <!-- Slate 600 (7.0:1 AAA contrast) -->
    <Color x:Key="Color.Text.Muted">#5B6B82</Color> <!-- Slate 500 darkened (5.19:1 on Background, 5.43:1 on Card, 4.95:1 on Elevated) -->
    <Color x:Key="Color.Action.Danger">#DC2626</Color> <!-- Red 600 -->

    <!-- MultiView Composer: Staged Status -->
    <Color x:Key="Color.Status.Staged">#B45309</Color> <!-- Amber 700 (5.0:1 with white, 4.5:1 on its Amber 100 fill) -->
    <Color x:Key="Color.Status.StagedText">#92400E</Color> <!-- Amber 800 -->
    <Color x:Key="Color.Status.StagedChipText">#78350F</Color> <!-- Amber 900 -->

    <!-- Focus & Accent -->
    <Color x:Key="Color.Focus.Ring">#2563EB</Color>
    <Color x:Key="Color.Text.Accent">#1D4ED8</Color>

    <!-- Action Take -->
    <Color x:Key="Color.Action.Take">#2563EB</Color>
    <Color x:Key="Color.Action.TakeHover">#1D4ED8</Color>
    <Color x:Key="Color.Action.TakePressed">#1E40AF</Color>
    <Color x:Key="Color.Text.OnAction">#FFFFFF</Color>

    <!-- ScrollBar -->
    <Color x:Key="Color.ScrollBar.Thumb">#94A3B8</Color>

    <!-- Display Card Overlays & Popups -->
    <Color x:Key="Color.Surface.CopyTarget">#ECFEFF</Color> <!-- Cyan 50 -->
    <Color x:Key="Color.Text.OnCopyTarget">#083344</Color> <!-- Cyan 950 -->
    <Color x:Key="Color.Text.CopyAccent">#0E7490</Color> <!-- Cyan 700 -->
    <Color x:Key="Color.Text.OnDropTarget">#FFFFFF</Color>
    <Color x:Key="Color.Surface.UndoToast">#ECFDF5</Color> <!-- Emerald 50 -->
    <Color x:Key="Color.Text.UndoToast">#065F46</Color> <!-- Emerald 800 -->
    <Color x:Key="Color.Surface.Overlay">#FFFFFF</Color> <!-- White Overlay -->
    <Color x:Key="Color.Text.OnOverlay">#0F172A</Color>
    <Color x:Key="Color.Surface.Popup">#FFFFFF</Color>
    <Color x:Key="Color.Border.Control">#7B8CA4</Color> <!-- 3.3:1 on the canvas, 3.4:1 on a card, 3.1:1 on Elevated (non-text minimum) -->
    <Color x:Key="Color.Surface.Selected">#DBEAFE</Color> <!-- Blue 100 -->
    <Color x:Key="Color.Surface.Danger">#FEF2F2</Color> <!-- Red 50 -->
    <Color x:Key="Color.Border.Danger">#F87171</Color> <!-- Red 400 -->
    <Color x:Key="Color.Surface.Staged">#FEF3C7</Color> <!-- Amber 100 -->
    <Color x:Key="Color.Surface.StagedHover">#FDE68A</Color> <!-- Amber 200 -->

    <!-- Chrome tints and preview-fixed colours (video backdrops and scrim text keep the same value in both themes) -->
    <Color x:Key="Color.Text.Soft">#334155</Color>
    <Color x:Key="Color.Text.Strong">#1E293B</Color>
    <Color x:Key="Color.Border.Strong">#94A3B8</Color>
    <Color x:Key="Color.Text.Danger">#B91C1C</Color>
    <Color x:Key="Color.Text.DangerSoft">#DC2626</Color>
    <Color x:Key="Color.Text.OnDangerHover">#7F1D1D</Color>
    <Color x:Key="Color.Surface.Inset">#F1F5F9</Color>
    <Color x:Key="Color.Surface.Field">#F8FAFC</Color>
    <Color x:Key="Color.Surface.SchematicActive">#BFDBFE</Color>
    <Color x:Key="Color.Text.OnSchematicActive">#1E3A8A</Color>
    <Color x:Key="Color.Surface.Info">#DBEAFE</Color>
    <Color x:Key="Color.Surface.DangerStrong">#FEE2E2</Color>
    <Color x:Key="Color.Surface.Brand">#DBEAFE</Color>
    <Color x:Key="Color.Surface.PreviewBackdrop">#070A0F</Color>
    <Color x:Key="Color.Surface.PreviewTile">#0B0F17</Color>
    <Color x:Key="Color.Surface.PreviewBlack">#050505</Color>
    <Color x:Key="Color.Surface.PreviewMat">#000000</Color>
    <Color x:Key="Color.Text.OnPreview">#CBD5E1</Color>
    <Color x:Key="Color.Text.OnPreviewMuted">#94A3B8</Color>
    <Color x:Key="Color.Text.OnScrim">#F1F5F9</Color>
    <Color x:Key="Color.Text.OnScrimAccent">#A5F3FC</Color>
    <Color x:Key="Color.Text.OnScrimDanger">#FCA5A5</Color>

    <!-- Clinical badges, scrims and overlays -->
    <Color x:Key="Color.Surface.OnlineBadge">#ECFDF5</Color>
    <Color x:Key="Color.Border.OnlineBadge">#6EE7B7</Color>
    <Color x:Key="Color.Surface.RoutedBadge">#DBEAFE</Color>
    <Color x:Key="Color.Border.RoutedBadge">#93C5FD</Color>
    <Color x:Key="Color.Text.OnRoutedBadge">#1E40AF</Color>
    <Color x:Key="Color.Surface.OfflineOverlay">#B3F1F5F9</Color>
    <Color x:Key="Color.Surface.ModalScrim">#EBFFFFFF</Color>
    <Color x:Key="Color.Surface.Scrim">#D9070A0F</Color>
    <Color x:Key="Color.Border.Scrim">#33FFFFFF</Color>
    <Color x:Key="Color.Surface.ScrimAccent">#D904232B</Color>
    <Color x:Key="Color.Surface.ScrimTint">#2906B6D4</Color>
    <Color x:Key="Color.Surface.ScrimDanger">#F21F0A0A</Color>
    <Color x:Key="Color.Surface.FloatingStrip">#F2FFFFFF</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Background.Dark" Color="{StaticResource Color.Background.Dark}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Card" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Elevated" Color="{StaticResource Color.Surface.Elevated}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Border.Highlight" Color="{StaticResource Color.Border.Highlight}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Border.DropTarget" Color="{StaticResource Color.Border.DropTarget}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Accent.PrimaryHover" Color="{StaticResource Color.Accent.PrimaryHover}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Status.Online" Color="{StaticResource Color.Status.Online}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Status.Offline" Color="{StaticResource Color.Status.Offline}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Status.Routed" Color="{StaticResource Color.Status.Routed}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Action.Danger" Color="{StaticResource Color.Action.Danger}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Status.Staged" Color="{StaticResource Color.Status.Staged}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Status.StagedText" Color="{StaticResource Color.Status.StagedText}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Status.StagedChipText" Color="{StaticResource Color.Status.StagedChipText}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Focus.Ring" Color="{StaticResource Color.Focus.Ring}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.Accent" Color="{StaticResource Color.Text.Accent}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Action.Take" Color="{StaticResource Color.Action.Take}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Action.TakeHover" Color="{StaticResource Color.Action.TakeHover}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Action.TakePressed" Color="{StaticResource Color.Action.TakePressed}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.OnAction" Color="{StaticResource Color.Text.OnAction}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.ScrollBar.Thumb" Color="{StaticResource Color.ScrollBar.Thumb}" />

    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.CopyTarget" Color="{StaticResource Color.Surface.CopyTarget}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.OnCopyTarget" Color="{StaticResource Color.Text.OnCopyTarget}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.CopyAccent" Color="{StaticResource Color.Text.CopyAccent}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.OnDropTarget" Color="{StaticResource Color.Text.OnDropTarget}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.UndoToast" Color="{StaticResource Color.Surface.UndoToast}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.UndoToast" Color="{StaticResource Color.Text.UndoToast}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Overlay" Color="{StaticResource Color.Surface.Overlay}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.OnOverlay" Color="{StaticResource Color.Text.OnOverlay}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Popup" Color="{StaticResource Color.Surface.Popup}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Border.Control" Color="{StaticResource Color.Border.Control}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Selected" Color="{StaticResource Color.Surface.Selected}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Danger" Color="{StaticResource Color.Surface.Danger}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Border.Danger" Color="{StaticResource Color.Border.Danger}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Staged" Color="{StaticResource Color.Surface.Staged}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.StagedHover" Color="{StaticResource Color.Surface.StagedHover}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.Soft" Color="{StaticResource Color.Text.Soft}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.Strong" Color="{StaticResource Color.Text.Strong}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.Danger" Color="{StaticResource Color.Text.Danger}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.DangerSoft" Color="{StaticResource Color.Text.DangerSoft}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.OnDangerHover" Color="{StaticResource Color.Text.OnDangerHover}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Inset" Color="{StaticResource Color.Surface.Inset}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Field" Color="{StaticResource Color.Surface.Field}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.SchematicActive" Color="{StaticResource Color.Surface.SchematicActive}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.OnSchematicActive" Color="{StaticResource Color.Text.OnSchematicActive}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Info" Color="{StaticResource Color.Surface.Info}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.DangerStrong" Color="{StaticResource Color.Surface.DangerStrong}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Brand" Color="{StaticResource Color.Surface.Brand}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.PreviewBackdrop" Color="{StaticResource Color.Surface.PreviewBackdrop}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.PreviewTile" Color="{StaticResource Color.Surface.PreviewTile}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.PreviewBlack" Color="{StaticResource Color.Surface.PreviewBlack}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.PreviewMat" Color="{StaticResource Color.Surface.PreviewMat}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.OnPreview" Color="{StaticResource Color.Text.OnPreview}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.OnPreviewMuted" Color="{StaticResource Color.Text.OnPreviewMuted}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.OnScrim" Color="{StaticResource Color.Text.OnScrim}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.OnScrimAccent" Color="{StaticResource Color.Text.OnScrimAccent}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.OnScrimDanger" Color="{StaticResource Color.Text.OnScrimDanger}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.OnlineBadge" Color="{StaticResource Color.Surface.OnlineBadge}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Border.OnlineBadge" Color="{StaticResource Color.Border.OnlineBadge}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.RoutedBadge" Color="{StaticResource Color.Surface.RoutedBadge}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Border.RoutedBadge" Color="{StaticResource Color.Border.RoutedBadge}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Text.OnRoutedBadge" Color="{StaticResource Color.Text.OnRoutedBadge}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.OfflineOverlay" Color="{StaticResource Color.Surface.OfflineOverlay}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.ModalScrim" Color="{StaticResource Color.Surface.ModalScrim}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.Scrim" Color="{StaticResource Color.Surface.Scrim}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Border.Scrim" Color="{StaticResource Color.Border.Scrim}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.ScrimAccent" Color="{StaticResource Color.Surface.ScrimAccent}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.ScrimTint" Color="{StaticResource Color.Surface.ScrimTint}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.ScrimDanger" Color="{StaticResource Color.Surface.ScrimDanger}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Surface.FloatingStrip" Color="{StaticResource Color.Surface.FloatingStrip}" />

    <!-- Brand Mark (P1B 'AV' Clasp) Palette & Gradients -->
    <Color x:Key="Color.Logo.AChevron.Start">#06B6D4</Color>
    <Color x:Key="Color.Logo.AChevron.End">#38BDF8</Color>
    <Color x:Key="Color.Logo.VChevron.Start">#3B82F6</Color>
    <Color x:Key="Color.Logo.VChevron.End">#1D4ED8</Color>
    <Color x:Key="Color.Logo.StreamIn">#06B6D4</Color>
    <Color x:Key="Color.Logo.StreamOut">#60A5FA</Color>
    <Color x:Key="Color.Logo.TileBorder">#38BDF8</Color>
    <LinearGradientBrush po:Freeze="True" x:Key="Brush.Logo.AChevron" StartPoint="0.2,0.8" EndPoint="0.5,0.2">
        <GradientStop Color="#06B6D4" Offset="0.0" />
        <GradientStop Color="#38BDF8" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush po:Freeze="True" x:Key="Brush.Logo.VChevron" StartPoint="0.2,0.2" EndPoint="0.5,0.8">
        <GradientStop Color="#3B82F6" Offset="0.0" />
        <GradientStop Color="#1D4ED8" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Logo.StreamIn" Color="{StaticResource Color.Logo.StreamIn}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Logo.StreamOut" Color="{StaticResource Color.Logo.StreamOut}" />
    <SolidColorBrush po:Freeze="True" x:Key="Brush.Logo.TileBorder" Color="{StaticResource Color.Logo.TileBorder}" />

</ResourceDictionary>
