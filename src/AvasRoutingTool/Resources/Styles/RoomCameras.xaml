<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:views="clr-namespace:AvasRoutingTool.Views">

    <!--
        Room Cameras styles and Size.Camera.* tokens (owner: Room Cameras lane, RC9). Merged right after Composer.xaml (a test compares App.xaml and TestResources).
        Flat surfaces: tone steps and one blue only, for a pressed key, the selected chip and the primary action. Brushes are DynamicResource theme keys only.
    -->

    <!-- ===== Tokens (content-specific) ===== -->
    <sys:Double x:Key="Size.Camera.Rail.Min">300</sys:Double>
    <sys:Double x:Key="Size.Camera.Rail.Max">360</sys:Double>
    <sys:Double x:Key="Size.Camera.PadKey">56</sys:Double>
    <sys:Double x:Key="Size.Camera.Knob">28</sys:Double>
    <!-- A camera chip is a primary tap target: the same 48 px as Size.Touch.Min (a test pins the equality) -->
    <sys:Double x:Key="Size.Camera.Chip.Min">48</sys:Double>
    <!-- A long camera name truncates inside its chip (full name in the tooltip) -->
    <sys:Double x:Key="Size.Camera.Chip.Name.Max">240</sys:Double>
    <!-- Camera editor dialog (RC12): window width and port box width -->
    <sys:Double x:Key="Size.Camera.Dialog.Width">560</sys:Double>
    <sys:Double x:Key="Size.Camera.Dialog.Port">140</sys:Double>

    <!-- ===== PTZ direction key: flat tile, blue only while pressed ===== -->
    <Style x:Key="Style.Button.PtzKey" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="MinWidth" Value="{StaticResource Size.Camera.PadKey}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Camera.PadKey}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Lead}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="KeyBody"
                            Background="{DynamicResource Brush.Surface.Elevated}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="KeyBody" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="KeyBody" Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter TargetName="KeyBody" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAction}" />
                        </Trigger>
                        <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                            <Setter TargetName="KeyBody" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />
                            <Setter TargetName="KeyBody" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="KeyBody" Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                            <Setter TargetName="KeyBody" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Home: the centre key of the pad, same flat tile, a word instead of an arrow -->
    <Style x:Key="Style.Button.PtzHome" TargetType="Button" BasedOn="{StaticResource Style.Button.PtzKey}">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    </Style>

    <!-- ===== PTZ slider (zoom, focus): a 28 px knob inside a 48 px touch thumb, on a thin tone-step track ===== -->
    <Style x:Key="Style.Slider.Ptz" TargetType="Slider">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border x:Name="PtzTrack"
                                Height="6"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Surface.Inset}"
                                BorderBrush="{DynamicResource Brush.Border.Control}"
                                BorderThickness="1" />
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton OverridesDefaultStyle="True" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton OverridesDefaultStyle="True" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="PtzThumb"
                                       Width="{StaticResource Size.Touch.Min}"
                                       Height="{StaticResource Size.Touch.Min}"
                                       MinWidth="{StaticResource Size.Touch.Min}"
                                       MinHeight="{StaticResource Size.Touch.Min}"
                                       Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBody"
                                                    Width="{StaticResource Size.Camera.Knob}"
                                                    Height="{StaticResource Size.Camera.Knob}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource Brush.Surface.Elevated}"
                                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                                    BorderThickness="2"
                                                    CornerRadius="14" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBody" Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}" />
                                                </Trigger>
                                                <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                                                    <Setter TargetName="ThumbBody" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                                                    <Setter TargetName="ThumbBody" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PtzTrack" Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Speed segmented control (Slow | Medium | Fast): the checked segment is blue ===== -->
    <Style x:Key="Style.ToggleButton.Segment" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="MinWidth" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SegmentBody"
                            Background="{DynamicResource Brush.Surface.Elevated}"
                            BorderBrush="{DynamicResource Brush.Border.Control}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SegmentBody" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SegmentBody" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SegmentBody" Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter TargetName="SegmentBody" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAction}" />
                        </Trigger>
                        <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                            <Setter TargetName="SegmentBody" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />
                            <Setter TargetName="SegmentBody" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SegmentBody" Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Camera chip: a selectable RadioButton, name plus a status dot; the selected chip is blue ===== -->
    <Style x:Key="Style.Chip.Camera" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Camera.Chip.Min}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ChipBody"
                            MinHeight="{StaticResource Size.Camera.Chip.Min}"
                            Background="{DynamicResource Brush.Surface.Elevated}"
                            BorderBrush="{DynamicResource Brush.Border.Control}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Width="{StaticResource Size.Dot.M}"
                                     Height="{StaticResource Size.Dot.M}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.Text.Muted}" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Brush.Status.Online}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChipBody" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Brush.Text.OnAction}" />
                            <Setter TargetName="ChipBody" Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter TargetName="ChipBody" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAction}" />
                        </Trigger>
                        <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                            <Setter TargetName="ChipBody" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />
                            <Setter TargetName="ChipBody" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ChipBody" Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <!-- Unreachable (R16): red wins over grey, green and the selected white -->
                        <DataTrigger Binding="{Binding Path=DataContext.LinkIsUnreachable, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Brush.Text.Danger}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Rail link dot: the online/offline dot, red once the camera is unreachable (R16) ===== -->
    <Style x:Key="Style.StatusDot.Link" TargetType="Ellipse" BasedOn="{StaticResource Style.StatusDot}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding LinkIsUnreachable}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource Brush.Text.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Status line under the picture and in the rail: 12 px minimum, from the font token ===== -->
    <Style x:Key="Style.Text.CameraStatus" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

</ResourceDictionary>
