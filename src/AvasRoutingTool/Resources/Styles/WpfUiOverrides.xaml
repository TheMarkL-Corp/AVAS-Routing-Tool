<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        WPF-UI's ControlsDictionary (theme and control styles only, D1) also ships IMPLICIT styles for plain WPF controls.
        The ones that must not leak into this app are neutralised here, after the WPF-UI dictionaries.

        Window: WPF-UI restyles every Window (own template, OverridesDefaultStyle, 1100x600, AllowsTransparency), which throws on
        a window built in code and re-chromes the normal Windows window. An empty implicit style keeps the stock Window.
    -->
    <Style TargetType="{x:Type Window}" />

    <!--
        ListBox / ListBoxItem: WPF-UI gives items 12 px of padding (a Logs row would grow from 22 to 44 px) and a PassiveScrollViewer that
        bypasses the app's 16 px scroll gutters. Empty implicit styles keep the stock list until it uses Style.ListBox.Virtualized (Lists.xaml).
    -->
    <Style TargetType="{x:Type ListBox}" />
    <Style TargetType="{x:Type ListBoxItem}" />

</ResourceDictionary>
