<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        Badges on chrome (not over video: chips over a picture stay Border + scrim). One look per meaning, all on ui:Badge.
        One accent: blue is selection and the primary action, cyan is the armed target only, amber is staged only. A device's status is a dot
        plus a plain word (Text.Status), never a coloured pill, and the tags that carry no state are Neutral:
          Info    - a fact the Composer shows (its output and rate notes)    Surface.RoutedBadge / Border.RoutedBadge / Text.OnRoutedBadge
          Staged  - something kept but not on screen (in N blocks, draft)  Surface.Staged / Status.Staged / Status.StagedChipText
          Armed   - tapped and waiting for a target (Placing)             Surface.CopyTarget / Border.DropTarget / Text.CopyAccent
          Neutral - a tag that carries no state (DUAL LINK, the mode tag) Surface.Elevated / Border.Default / Text.Secondary
        Each pair is contrast-tested (>= 4.5:1) in Dark and Light.

        WPF-UI's own Badge template forces a Foreground and a Border background per Appearance through template triggers, which beat any style
        setter (the default Primary look gives black text on our dark fills). Style.Badge.Base therefore keeps the ui:Badge control and its
        style chain but swaps in a plain template; the three looks only set brushes.
    -->

    <Style x:Key="Style.Badge.Base" TargetType="{x:Type ui:Badge}" BasedOn="{StaticResource {x:Type ui:Badge}}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Badge}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Badge.Info" TargetType="{x:Type ui:Badge}" BasedOn="{StaticResource Style.Badge.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.RoutedBadge}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.RoutedBadge}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnRoutedBadge}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Style.Badge.Staged" TargetType="{x:Type ui:Badge}" BasedOn="{StaticResource Style.Badge.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Staged}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Staged}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.StagedChipText}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Style.Badge.Armed" TargetType="{x:Type ui:Badge}" BasedOn="{StaticResource Style.Badge.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.CopyTarget}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.CopyAccent}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- A tag that carries no state: the card surface tone with a 1 px border and secondary text -->
    <Style x:Key="Style.Badge.Neutral" TargetType="{x:Type ui:Badge}" BasedOn="{StaticResource Style.Badge.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>
