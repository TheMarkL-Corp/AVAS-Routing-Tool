<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
                    xmlns:views="clr-namespace:AvasRoutingTool.Views">

    <!--
        Display card styles (owner: Main Window session). Merged after Buttons, Text, Badges and Cards, so BasedOn works with their keys.
        State comes from the card's DataContext (DataTrigger) or a Tag; colours are DynamicResource palette keys.
    -->

    <!-- Card frame: 1 px neutral border whether routed or not (routed is said by the picture and the mode tag, not the frame); drop target: cyan 2 px. Frame 2 + padding 24 = the 26 px of GridSpec.DisplayCard.ChromeHeight -->
    <Style x:Key="Style.Card.Display" TargetType="{x:Type ui:Card}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Card}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDragOver, Mode=OneWay}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Vector icon in a card-action button: follows the button's text colour (filled or stroked), Size.Icon.S -->
    <Style x:Key="Style.Icon.Button" TargetType="Path">
        <Setter Property="Width" Value="{StaticResource Size.Icon.S}" />
        <Setter Property="Height" Value="{StaticResource Size.Icon.S}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,1" />
        <Setter Property="Fill" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <Style x:Key="Style.Icon.Button.Stroke" TargetType="Path" BasedOn="{StaticResource Style.Icon.Button}">
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- The power icon of the Turn Off button -->
    <Style x:Key="Style.Icon.Power" TargetType="Path" BasedOn="{StaticResource Style.Icon.Button.Stroke}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

    <!-- Large state icon on the picture (monitor): Size.Icon.L; the view sets its Fill (accent when routed, muted when not) -->
    <Style x:Key="Style.Icon.State" TargetType="Path">
        <Setter Property="Width" Value="{StaticResource Size.Icon.L}" />
        <Setter Property="Height" Value="{StaticResource Size.Icon.L}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Primary}" />
    </Style>

    <!-- Dashed neutral frame around the empty display tile (critique M7). Neutral, never cyan: cyan is the drop ring and "armed" -->
    <Style x:Key="Style.Shape.EmptyFrame" TargetType="Rectangle">
        <Setter Property="Stroke" Value="{DynamicResource Brush.Border.Control}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeDashArray" Value="4 3" />
        <Setter Property="RadiusX" Value="6" />
        <Setter Property="RadiusY" Value="6" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!--
        Copy layout: a ghost button beside the layout segments (the same quiet look as Style.Button.Ghost, with a neutral hover).
        While this display is the copy source it is solid drop-target cyan, so the armed state is a colour and the words.
    -->
    <Style x:Key="Style.Button.CopyLayout" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="MinWidth" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <!-- Keyboard focus: a 2 px ring of its own, shown only when the keyboard moved focus here -->
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource Brush.Focus.Ring}"
                                BorderThickness="2"
                                CornerRadius="6"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Armed: the hover fill above is set on bd, which the style's trigger cannot reach; this one comes after it and keeps the cyan and its text -->
                        <DataTrigger Binding="{Binding IsCopySource, Mode=OneWay}" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Border.DropTarget}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDropTarget}" />
                        </DataTrigger>
                        <!-- Nothing to copy: the handle stays enabled (focus, tap, the reason on press) but looks off; the reason is its name and help text -->
                        <DataTrigger Binding="{Binding CanCopyFrom, Mode=OneWay}" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Root" Property="Cursor" Value="Arrow" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCopySource, Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Border.DropTarget}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDropTarget}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A multiview window on the card: border follows assigned / drag-over -->
    <Style x:Key="Style.Slot.Tile" TargetType="Border">
        <Setter Property="Margin" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.PreviewTile}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="ClipToBounds" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAssigned, Mode=OneWay}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Routed}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDragOver, Mode=OneWay}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Placement of a window in the FractionalLayoutPanel (ItemContainerStyle of the slots) -->
    <Style x:Key="Style.Slot.Fractional" TargetType="ContentPresenter">
        <Setter Property="controls:FractionalLayoutPanel.X" Value="{Binding NormalizedX, Mode=OneWay}" />
        <Setter Property="controls:FractionalLayoutPanel.Y" Value="{Binding NormalizedY, Mode=OneWay}" />
        <Setter Property="controls:FractionalLayoutPanel.W" Value="{Binding NormalizedWidth, Mode=OneWay}" />
        <Setter Property="controls:FractionalLayoutPanel.H" Value="{Binding NormalizedHeight, Mode=OneWay}" />
    </Style>

    <!-- A layout tile of the Layout menu. Part bd is read by the tests. On screen = accent border, selected fill (and the words "On screen" in the tile). -->
    <Style x:Key="Style.Button.LayoutMenuTile" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource Size.LayoutTile.Min}" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{DynamicResource Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Control}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="8,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Id, Mode=OneWay}" Value="off">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Danger}" />
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Danger}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOnScreen, Mode=OneWay}" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                        </DataTrigger>
                        <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One segment of the display card's layout control: the one-tap presets and the Layout dropdown share one joined outline, drawn by the
        view (LayoutSegments: fill, outline), so a segment has no border of its own. Touch size; own template, not based on WPF-UI.
        Hover lifts the fill; the 2 px keyboard ring shows through InputModality.ShowsFocus. Part bd is read by the tests.
    -->
    <Style x:Key="Style.Button.LayoutSegment" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Margin="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <!-- Keyboard focus: a 2 px ring of its own, shown only when the keyboard moved focus here -->
                        <Border x:Name="FocusRing"
                                Margin="3"
                                BorderBrush="{DynamicResource Brush.Focus.Ring}"
                                BorderThickness="2"
                                CornerRadius="6"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A one-tap layout preset (a segment with its glyph; cards from Size.Breakpoint.CardPresets wide). On screen: the selected fill and the
        accent colour for the glyph and the check mark, so the state is not colour alone (the check is the view's). Content is set by the view.
    -->
    <Style x:Key="Style.Button.LayoutPreset" TargetType="Button" BasedOn="{StaticResource Style.Button.LayoutSegment}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOnScreen, Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The check badge of the layout on screen: a small accent disc in the segment's top-right corner (Size.Icon.S square) -->
    <Style x:Key="Style.Badge.OnScreenCheck" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Size.Icon.S}" />
        <Setter Property="Height" Value="{StaticResource Size.Icon.S}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,-3,-3,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- The outline cell of a LayoutGlyph: an outline only (no fill), its colour set by the glyph's Foreground binding in the view -->
    <Style x:Key="Style.Border.GlyphCell" TargetType="Border">
        <Setter Property="Margin" Value="1" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

</ResourceDictionary>
