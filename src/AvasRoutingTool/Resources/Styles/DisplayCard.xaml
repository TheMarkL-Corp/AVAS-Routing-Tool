<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
                    xmlns:views="clr-namespace:AvasRoutingTool.Views">

    <!--
        Display card styles (owner: Main Window session). Merged after Buttons, Text, Badges and Cards, so BasedOn works with their keys.
        State comes from the card's DataContext (DataTrigger) or a Tag; colours are DynamicResource palette keys.
    -->

    <!-- Card frame: 1 px border (routed: routed colour, drop target: cyan 2 px); frame 2 + padding 24 = the 26 px of GridSpec.DisplayCard.ChromeHeight -->
    <Style x:Key="Style.Card.Display" TargetType="{x:Type ui:Card}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Card}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDragOver, Mode=OneWay}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsRouted, Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding IsDragOver, Mode=OneWay}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Routed}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Vector icon in a card-action button: follows the button's text colour (filled or stroked), Size.Icon.S -->
    <Style x:Key="Style.Icon.Button" TargetType="Path">
        <Setter Property="Width" Value="{StaticResource Size.Icon.S}" />
        <Setter Property="Height" Value="{StaticResource Size.Icon.S}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,1" />
        <Setter Property="Fill" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <Style x:Key="Style.Icon.Button.Stroke" TargetType="Path" BasedOn="{StaticResource Style.Icon.Button}">
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- The power icon of the Turn Off button -->
    <Style x:Key="Style.Icon.Power" TargetType="Path" BasedOn="{StaticResource Style.Icon.Button.Stroke}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

    <!-- Large state icon on the picture (monitor): Size.Icon.L; the view sets its Fill (accent when routed, muted when not) -->
    <Style x:Key="Style.Icon.State" TargetType="Path">
        <Setter Property="Width" Value="{StaticResource Size.Icon.L}" />
        <Setter Property="Height" Value="{StaticResource Size.Icon.L}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Primary}" />
    </Style>

    <!-- Copy layout: the copy colours, solid cyan while this display is the copy source -->
    <Style x:Key="Style.Button.CardAction.Copy" TargetType="Button" BasedOn="{StaticResource Style.Button.CardAction}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.CopyTarget}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.CopyAccent}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCopySource, Mode=OneWay}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Border.DropTarget}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDropTarget}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A multiview window on the card: border follows assigned / drag-over -->
    <Style x:Key="Style.Slot.Tile" TargetType="Border">
        <Setter Property="Margin" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.PreviewTile}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="ClipToBounds" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAssigned, Mode=OneWay}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Routed}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDragOver, Mode=OneWay}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Placement of a window in the FractionalLayoutPanel (ItemContainerStyle of the slots) -->
    <Style x:Key="Style.Slot.Fractional" TargetType="ContentPresenter">
        <Setter Property="controls:FractionalLayoutPanel.X" Value="{Binding NormalizedX, Mode=OneWay}" />
        <Setter Property="controls:FractionalLayoutPanel.Y" Value="{Binding NormalizedY, Mode=OneWay}" />
        <Setter Property="controls:FractionalLayoutPanel.W" Value="{Binding NormalizedWidth, Mode=OneWay}" />
        <Setter Property="controls:FractionalLayoutPanel.H" Value="{Binding NormalizedHeight, Mode=OneWay}" />
    </Style>

    <!-- A layout tile of the Layout menu. Part bd is read by the tests. On screen = accent border, selected fill (and the words "On screen" in the tile). -->
    <Style x:Key="Style.Button.LayoutMenuTile" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource Size.LayoutTile.Min}" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{DynamicResource Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Control}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="8,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Id, Mode=OneWay}" Value="off">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Danger}" />
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Danger}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOnScreen, Mode=OneWay}" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                        </DataTrigger>
                        <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
