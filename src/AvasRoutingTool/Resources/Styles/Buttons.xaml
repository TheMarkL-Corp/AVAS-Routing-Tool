<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:views="clr-namespace:AvasRoutingTool.Views">

    <!--
        Button family (native Button with central styles, D12). Sizes and font sizes come from Tokens.xaml; brushes are DynamicResource
        palette keys only. Style.Button.Take (content-specific 72 px) stays in Theme.xaml until the Composer takes it over.
    -->

    <!-- Keyboard focus on a non-button element (e.g. a display card's picture): the 2 px ring, not the dotted default -->
    <Style x:Key="Style.FocusVisual.Ring">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{DynamicResource Brush.Focus.Ring}" StrokeThickness="2" RadiusX="6" RadiusY="6" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Button.Primary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAction}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Accent.PrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Button.Secondary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Button.Unroute" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.DangerSoft}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Danger}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.DangerStrong}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDangerHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Ghost button (the quiet look of Turn Off and Stop): no fill or border at rest, a neutral hover (the row hover, as
        Style.Button.CopyLayout), and the 2 px keyboard ring through InputModality.ShowsFocus. Red is for errors only, so nothing here
        is red. Own template, not based on WPF-UI.
    -->
    <Style x:Key="Style.Button.Ghost" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <!-- Keyboard focus: a 2 px ring of its own, shown only when the keyboard moved focus here -->
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource Brush.Focus.Ring}"
                                BorderThickness="2"
                                CornerRadius="6"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Pencil (rename): an icon-only button for a card header. 48 x 48 hit box (Size.Touch.Min) whose whole box takes the press (transparent
        root Grid); the icon is the secondary text colour at rest and the accent (blue) under the mouse and on keyboard focus; the fill is
        the neutral row hover, under the mouse only; a 2 px ring through InputModality.ShowsFocus. Red is for errors only, so nothing here is red.
        The view lays it out with negative vertical margins, so the 48 px box does not change its row's height.
    -->
    <Style x:Key="Style.Button.IconPencil" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="MinWidth" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="HoverFill"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="4" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        <!-- Keyboard focus: a 2 px ring of its own, shown only when the keyboard moved focus here -->
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource Brush.Focus.Ring}"
                                BorderThickness="2"
                                CornerRadius="6"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverFill" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MultiView Composer and the generic touch button: 48 px (D4), 16 px semibold, own focus ring so it shows over any local border colour -->
    <Style x:Key="Style.Button.Composer" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="MinWidth" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Lead}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <!-- Keyboard focus: a 2 px ring of its own, so it shows whatever border colour a button sets locally -->
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource Brush.Focus.Ring}"
                                BorderThickness="2"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Display-card action bar: one button family (48 px, 1 px border, icon beside a 13 px semibold label) -->
    <Style x:Key="Style.Button.CardAction" TargetType="Button" BasedOn="{StaticResource Style.Button.Composer}">
        <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="MinWidth" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- App-bar action button: ghost (no fill or border until hover) at touch size; icon + label. -->
    <Style x:Key="Style.Button.AppBar" TargetType="Button" BasedOn="{StaticResource Style.Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="MinWidth" Value="{StaticResource Size.Touch.Min}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusVisual.Ring}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Stroked vector icon that follows the button's text colour (app bar). -->
    <Style x:Key="Style.Icon.AppBar" TargetType="Path">
        <Setter Property="Width" Value="{StaticResource Size.Icon.S}" />
        <Setter Property="Height" Value="{StaticResource Size.Icon.S}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!-- Stock glyph inside a button (ui:SymbolIcon): takes the button's text colour, Size.Icon.M -->
    <Style x:Key="Style.Icon.Action" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="{StaticResource Size.Icon.M}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The theme action's icon names the ACTIVE theme: sun in Light, moon in Dark (DataContext = MainViewModel) -->
    <Style x:Key="Style.Icon.ThemeToggle" TargetType="ui:SymbolIcon" BasedOn="{StaticResource Style.Icon.Action}">
        <Setter Property="Symbol" Value="WeatherMoon24" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLightMode}" Value="True">
                <Setter Property="Symbol" Value="WeatherSunny24" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Staged chip (display-card draft chip, and the Composer's unplaced-source chips): a 1 px outlined frame in the staged colours,
        hover tint, and the keyboard-focus ring through InputModality.ShowsFocus. The content brings its own text.
        Part name DraftFrame is kept. Extracted from DisplayCardView; Visibility rules stay with the user (BasedOn).
    -->
    <Style x:Key="Style.Button.Chip.Staged" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle x:Name="DraftFrame"
                                   Fill="{DynamicResource Brush.Surface.Staged}"
                                   Stroke="{DynamicResource Brush.Status.Staged}"
                                   StrokeThickness="1"
                                   RadiusX="8" RadiusY="8" />
                        <ContentPresenter Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DraftFrame" Property="Fill" Value="{DynamicResource Brush.Surface.StagedHover}" />
                        </Trigger>
                        <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                            <Setter TargetName="DraftFrame" Property="Stroke" Value="{DynamicResource Brush.Focus.Ring}" />
                            <Setter TargetName="DraftFrame" Property="StrokeThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
