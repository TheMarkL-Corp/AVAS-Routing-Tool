<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Color Palette -->
    <Color x:Key="Color.Background.Dark">#0B0F17</Color>
    <Color x:Key="Color.Surface.Card">#151E2E</Color>
    <Color x:Key="Color.Surface.Elevated">#1E293B</Color>
    <Color x:Key="Color.Surface.Hover">#24334A</Color>
    <Color x:Key="Color.Border.Default">#223049</Color>
    <Color x:Key="Color.Border.Highlight">#3B82F6</Color>
    <Color x:Key="Color.Border.DropTarget">#06B6D4</Color>
    <Color x:Key="Color.Accent.Primary">#3B82F6</Color>
    <Color x:Key="Color.Accent.PrimaryHover">#2563EB</Color>
    <Color x:Key="Color.Status.Online">#10B981</Color>
    <Color x:Key="Color.Status.Offline">#64748B</Color>
    <Color x:Key="Color.Status.Routed">#3B82F6</Color>
    <Color x:Key="Color.Text.Primary">#F8FAFC</Color>
    <Color x:Key="Color.Text.Secondary">#94A3B8</Color>
    <Color x:Key="Color.Text.Muted">#64748B</Color>
    <Color x:Key="Color.Action.Danger">#EF4444</Color>
    <!-- MultiView Composer: staged, not on screen yet (always paired with a dashed line and a STAGED label) -->
    <Color x:Key="Color.Status.Staged">#F59E0B</Color>
    <Color x:Key="Color.Status.StagedText">#FCD34D</Color>
    <Color x:Key="Color.Status.StagedChipText">#FDE68A</Color>
    <!-- Keyboard focus ring (2 px) and the light accent used for text on the dark surfaces -->
    <Color x:Key="Color.Focus.Ring">#93C5FD</Color>
    <Color x:Key="Color.Text.Accent">#93C5FD</Color>
    <!-- Take: white label >= 4.5:1 in every state (#2563EB 5.2:1, #1D4ED8 6.7:1, #1E40AF 8.7:1) -->
    <Color x:Key="Color.Action.Take">#2563EB</Color>
    <Color x:Key="Color.Action.TakeHover">#1D4ED8</Color>
    <Color x:Key="Color.Action.TakePressed">#1E40AF</Color>
    <Color x:Key="Color.Text.OnAction">#FFFFFF</Color>
    <!-- Scroll thumb: >= 3:1 against the page (#0B0F17, 4.0:1) and the cards (#151E2E, 3.5:1) -->
    <Color x:Key="Color.ScrollBar.Thumb">#64748B</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="Brush.Background.Dark" Color="{StaticResource Color.Background.Dark}" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{StaticResource Color.Surface.Elevated}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Brush.Border.Highlight" Color="{StaticResource Color.Border.Highlight}" />
    <SolidColorBrush x:Key="Brush.Border.DropTarget" Color="{StaticResource Color.Border.DropTarget}" />
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent.PrimaryHover" Color="{StaticResource Color.Accent.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.Status.Online" Color="{StaticResource Color.Status.Online}" />
    <SolidColorBrush x:Key="Brush.Status.Offline" Color="{StaticResource Color.Status.Offline}" />
    <SolidColorBrush x:Key="Brush.Status.Routed" Color="{StaticResource Color.Status.Routed}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Brush.Action.Danger" Color="{StaticResource Color.Action.Danger}" />
    <SolidColorBrush x:Key="Brush.Status.Staged" Color="{StaticResource Color.Status.Staged}" />
    <SolidColorBrush x:Key="Brush.Status.StagedText" Color="{StaticResource Color.Status.StagedText}" />
    <SolidColorBrush x:Key="Brush.Status.StagedChipText" Color="{StaticResource Color.Status.StagedChipText}" />
    <SolidColorBrush x:Key="Brush.Focus.Ring" Color="{StaticResource Color.Focus.Ring}" />
    <SolidColorBrush x:Key="Brush.Text.Accent" Color="{StaticResource Color.Text.Accent}" />
    <SolidColorBrush x:Key="Brush.Action.Take" Color="{StaticResource Color.Action.Take}" />
    <SolidColorBrush x:Key="Brush.Action.TakeHover" Color="{StaticResource Color.Action.TakeHover}" />
    <SolidColorBrush x:Key="Brush.Action.TakePressed" Color="{StaticResource Color.Action.TakePressed}" />
    <SolidColorBrush x:Key="Brush.Text.OnAction" Color="{StaticResource Color.Text.OnAction}" />
    <SolidColorBrush x:Key="Brush.ScrollBar.Thumb" Color="{StaticResource Color.ScrollBar.Thumb}" />

    <!--
        Display card and overview (spec 5.1, 15). Copy / arm states sit on a dark cyan surface with light cyan text;
        text on the cyan DropTarget fill is near-black. Overlays and popups are opaque dark surfaces.
    -->
    <Color x:Key="Color.Surface.CopyTarget">#082F3A</Color>
    <Color x:Key="Color.Text.OnCopyTarget">#CFFAFE</Color>
    <Color x:Key="Color.Text.CopyAccent">#A5F3FC</Color>
    <Color x:Key="Color.Text.OnDropTarget">#04232B</Color>
    <Color x:Key="Color.Surface.UndoToast">#0B2A1E</Color>
    <Color x:Key="Color.Text.UndoToast">#A7F3D0</Color>
    <Color x:Key="Color.Surface.Overlay">#0A0E16</Color>
    <Color x:Key="Color.Text.OnOverlay">#F1F5F9</Color>
    <Color x:Key="Color.Surface.Popup">#0F1626</Color>
    <Color x:Key="Color.Border.Control">#334155</Color>
    <Color x:Key="Color.Surface.Selected">#172554</Color>
    <Color x:Key="Color.Surface.Danger">#1A0B0B</Color>
    <Color x:Key="Color.Border.Danger">#7F1D1D</Color>
    <Color x:Key="Color.Surface.Staged">#2A1F08</Color>
    <Color x:Key="Color.Surface.StagedHover">#3A2B0B</Color>
    <SolidColorBrush x:Key="Brush.Surface.CopyTarget" Color="{StaticResource Color.Surface.CopyTarget}" />
    <SolidColorBrush x:Key="Brush.Text.OnCopyTarget" Color="{StaticResource Color.Text.OnCopyTarget}" />
    <SolidColorBrush x:Key="Brush.Text.CopyAccent" Color="{StaticResource Color.Text.CopyAccent}" />
    <SolidColorBrush x:Key="Brush.Text.OnDropTarget" Color="{StaticResource Color.Text.OnDropTarget}" />
    <SolidColorBrush x:Key="Brush.Surface.UndoToast" Color="{StaticResource Color.Surface.UndoToast}" />
    <SolidColorBrush x:Key="Brush.Text.UndoToast" Color="{StaticResource Color.Text.UndoToast}" />
    <SolidColorBrush x:Key="Brush.Surface.Overlay" Color="{StaticResource Color.Surface.Overlay}" />
    <SolidColorBrush x:Key="Brush.Text.OnOverlay" Color="{StaticResource Color.Text.OnOverlay}" />
    <SolidColorBrush x:Key="Brush.Surface.Popup" Color="{StaticResource Color.Surface.Popup}" />
    <SolidColorBrush x:Key="Brush.Border.Control" Color="{StaticResource Color.Border.Control}" />
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="{StaticResource Color.Surface.Selected}" />
    <SolidColorBrush x:Key="Brush.Surface.Danger" Color="{StaticResource Color.Surface.Danger}" />
    <SolidColorBrush x:Key="Brush.Border.Danger" Color="{StaticResource Color.Border.Danger}" />
    <SolidColorBrush x:Key="Brush.Surface.Staged" Color="{StaticResource Color.Surface.Staged}" />
    <SolidColorBrush x:Key="Brush.Surface.StagedHover" Color="{StaticResource Color.Surface.StagedHover}" />

    <!-- Keyboard focus on a non-button element (e.g. a display card's picture): the 2 px ring, not the dotted default -->
    <Style x:Key="Style.FocusVisual.Ring">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{StaticResource Brush.Focus.Ring}" StrokeThickness="2" RadiusX="6" RadiusY="6" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button Styles -->
    <Style x:Key="Style.Button.Primary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Accent.PrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Button.Secondary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Elevated}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Surface.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Button.Unroute" TargetType="Button">
        <Setter Property="Background" Value="#33EF4444" />
        <Setter Property="Foreground" Value="#F87171" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#66EF4444" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#66EF4444" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MultiView Composer: Take (primary, >= 72 px, 16 px semibold). Disabled keeps a readable label (no opacity fade). -->
    <Style x:Key="Style.Button.Take" TargetType="Button">
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.OnAction}" />
        <Setter Property="Background" Value="{StaticResource Brush.Action.Take}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Action.Take}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Action.TakeHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Action.TakePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Focus.Ring}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource Brush.Surface.Elevated}" />
                            <Setter Property="BorderBrush" Value="#334155" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MultiView Composer: every other button (>= 56 px for gloved touch, 16 px semibold) -->
    <Style x:Key="Style.Button.Composer" TargetType="Button">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <!-- Keyboard focus: a 2 px ring of its own, so it shows whatever border colour a button sets locally -->
                        <Border x:Name="FocusRing"
                                BorderBrush="{StaticResource Brush.Focus.Ring}"
                                BorderThickness="2"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MultiView Composer: body and label text (>= 14 px, >= 4.5:1 on the card and background colours) -->
    <Style x:Key="Style.Text.ComposerLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ScrollBar & ScrollViewer Dark Style: a thin 8 px bar, thumb sized to the viewport, page up / down on the track -->
    <Style x:Key="Style.RepeatButton.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Thumb.Scroll" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- The whole 16 px gutter grabs; the visible thumb is 8 px, inset by 4 px -->
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="ThumbVisual" Margin="4" Background="{StaticResource Brush.ScrollBar.Thumb}" CornerRadius="4" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.ScrollBar.Thin" TargetType="ScrollBar">
        <Style.Resources>
            <!-- Track sizes its smallest thumb as half the "scroll button" length: 48 -> a thumb of at least 24 px -->
            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">48</sys:Double>
            <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">48</sys:Double>
        </Style.Resources>
        <!-- The system theme sizes the bar at 17 px (Width / Height and their minimums); the 16 px gutter sets the size instead -->
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track"
                               Orientation="Vertical"
                               IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{Binding Value, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Style.RepeatButton.ScrollPage}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Style.RepeatButton.ScrollPage}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Style.Thumb.Scroll}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track"
                                       Orientation="Horizontal"
                                       IsDirectionReversed="False"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       Value="{Binding Value, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Style.RepeatButton.ScrollPage}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Style.RepeatButton.ScrollPage}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Style.Thumb.Scroll}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <!--
                    The bars sit in reserved 16 px gutters (touch-sized hit area, 8 px visible thumb): the content width
                    does not change when a bar appears. A direction that cannot scroll (Disabled / Hidden) has no gutter.
                -->
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <Border x:Name="VerticalGutter" Grid.Column="1" Grid.Row="0" Width="16">
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource Style.ScrollBar.Thin}"
                                       Orientation="Vertical"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Border>
                        <Border x:Name="HorizontalGutter" Grid.Column="0" Grid.Row="1" Height="16">
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Style="{StaticResource Style.ScrollBar.Thin}"
                                       Orientation="Horizontal"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="VerticalScrollBarVisibility" Value="Disabled">
                            <Setter TargetName="VerticalGutter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="VerticalScrollBarVisibility" Value="Hidden">
                            <Setter TargetName="VerticalGutter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HorizontalScrollBarVisibility" Value="Disabled">
                            <Setter TargetName="HorizontalGutter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HorizontalScrollBarVisibility" Value="Hidden">
                            <Setter TargetName="HorizontalGutter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
