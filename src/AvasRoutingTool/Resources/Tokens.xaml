<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Size and font-size tokens (UI v2). Views never carry a numeric Width/Height/Min*/Max* or FontSize literal:
        they reference these keys ({StaticResource Size.*}, Font.Size.*). Naming: Size.<Role>[.<Variant>], Font.Size.<Role>.
        Theme independent, so this file is not part of the Dark/Light palette pair. Composer-only tokens (Size.Composer.*)
        live in Styles/Composer.xaml.
    -->

    <!-- Touch targets (D4): Min for primary actions, Compact for dense secondary controls (keep >= 8 px between them) -->
    <sys:Double x:Key="Size.Touch.Min">48</sys:Double>
    <sys:Double x:Key="Size.Touch.Compact">36</sys:Double>

    <!-- Icons: the Width/Height of a MaterialIcon (or of a Path / ui:SymbolIcon font size where a view still uses one) -->
    <sys:Double x:Key="Size.Icon.S">16</sys:Double>
    <sys:Double x:Key="Size.Icon.M">22</sys:Double>
    <sys:Double x:Key="Size.Icon.L">28</sys:Double>
    <sys:Double x:Key="Size.Icon.Brand">28</sys:Double>
    <!-- The action bar icons on the display card (More layouts grid, its chevron, Copy layout, power) -->
    <sys:Double x:Key="Size.Icon.Layout">20</sys:Double>
    <sys:Double x:Key="Size.Icon.Layout.Chevron">20</sys:Double>
    <!-- Action bar (More layouts, Copy layout, power): the gap between an icon and its label, and between two buttons (8); the horizontal padding
         inside a button (12 each side). The Thickness forms are for Margin and Padding, which cannot take a Double. -->
    <sys:Double x:Key="Size.Space.Action">8</sys:Double>
    <sys:Double x:Key="Size.Action.PadX">12</sys:Double>
    <Thickness x:Key="Size.Action.Padding">12,0</Thickness>
    <Thickness x:Key="Size.Space.Action.Before">8,0,0,0</Thickness>
    <!-- The brand mark on an unrouted display's empty tile (the tile's one picture) -->
    <sys:Double x:Key="Size.Brand.Empty">64</sys:Double>

    <!-- Status dots -->
    <sys:Double x:Key="Size.Dot.S">8</sys:Double>
    <sys:Double x:Key="Size.Dot.M">10</sys:Double>

    <!-- Cards: minimum width (= GridSpec.Default.MinCardWidth), the display card's own minimum (= GridSpec.DisplayCard.MinCardWidth: the action bar needs about 350 px of the 374 inside a 400 px card) and the fixed rows of the display card around the 16:9 picture -->
    <sys:Double x:Key="Size.Card.Min">320</sys:Double>
    <sys:Double x:Key="Size.Card.Display.Min">400</sys:Double>
    <sys:Double x:Key="Size.Card.Row.Header">24</sys:Double>
    <sys:Double x:Key="Size.Card.Row.ActionBar">56</sys:Double>
    <sys:Double x:Key="Size.Card.Row.Dock">64</sys:Double>
    <!-- The same rows as GridLength, for RowDefinition.Height (a Double cannot be assigned to a GridLength) -->
    <GridLength x:Key="Size.Card.RowLength.Header">24</GridLength>
    <GridLength x:Key="Size.Card.RowLength.ActionBar">56</GridLength>
    <GridLength x:Key="Size.Card.RowLength.Dock">64</GridLength>

    <!-- Source strip (critique M2): dense tiles with a 16:9 thumbnail (276 x 155 inside a 300 px tile). The strip holds two tile rows before it scrolls. -->
    <sys:Double x:Key="Size.Strip.Tile.Width">300</sys:Double>
    <!-- The compact tile (Composer palette) keeps its own width, independent of the strip tile -->
    <sys:Double x:Key="Size.Strip.Compact.Tile.Width">240</sys:Double>
    <sys:Double x:Key="Size.Strip.Thumb.Height">155</sys:Double>
    <!-- The Sources strip never takes more than this share of the overview height (2/5.4 = 0.37, the old Sources share); beyond it the strip scrolls -->
    <sys:Double x:Key="Size.Strip.Max.Fraction">0.37</sys:Double>
    <!-- One whole tile row (a 289 px tile + its 10 px bottom margin): the strip's cap never goes below it, so a short window never clips a tile -->
    <sys:Double x:Key="Size.Strip.Row.Min.Height">299</sys:Double>
    <!-- The space around each tile: left and right 5 px (a 10 px gap between tiles, so a centred row is centred on the tiles), bottom 10 px -->
    <Thickness x:Key="Size.Strip.TileMargin">5,0,5,10</Thickness>

    <!-- Compact tile (the Composer palette, SourceCardView.IsCompact): a 16:9 thumbnail (112 x 63) on the left, the name and status beside it; card padding 8 instead of 12 -->
    <sys:Double x:Key="Size.Strip.Compact.Thumb.Width">112</sys:Double>
    <sys:Double x:Key="Size.Strip.Compact.Thumb.Height">63</sys:Double>
    <Thickness x:Key="Size.Strip.Compact.Padding">8</Thickness>

    <!-- The device name in the compact tile: wraps to at most two lines. BlockLineHeight makes each line exactly LineHeight, so MaxHeight (two lines) is exact. -->
    <sys:Double x:Key="Size.Strip.Compact.Name.LineHeight">18</sys:Double>
    <sys:Double x:Key="Size.Strip.Compact.Name.MaxHeight">36</sys:Double>

    <!-- Section header row (Displays): the arm banner shares this row with the header, so arming never changes its height. 56 = Touch.Min + 4 px above and below: the 48 px Stop button clears the banner's 2 px ring, so its own keyboard ring is not drawn on the same pixels -->
    <sys:Double x:Key="Size.Section.Header.Height">56</sys:Double>

    <!-- The displays row fades its edge over this width where more cards continue, so a card is never cut mid-word with nothing to say it goes on -->
    <sys:Double x:Key="Size.Scroll.Edge.Fade">24</sys:Double>

    <!-- Main window and app bar -->
    <sys:Double x:Key="Size.AppBar.Height">56</sys:Double>
    <sys:Double x:Key="Size.Tab.MinWidth">120</sys:Double>
    <sys:Double x:Key="Size.Breakpoint.AppBarLabels">1400</sys:Double>
    <sys:Double x:Key="Size.Window.Default.Width">1280</sys:Double>
    <sys:Double x:Key="Size.Window.Default.Height">860</sys:Double>
    <sys:Double x:Key="Size.Window.Min.Width">1024</sys:Double>
    <sys:Double x:Key="Size.Window.Min.Height">720</sys:Double>

    <!-- Display card: dock content, Undo toast, notices, layout menu popup and tiles -->
    <sys:Double x:Key="Size.Dock.Content">56</sys:Double>
    <sys:Double x:Key="Size.Toast.Min">56</sys:Double>
    <sys:Double x:Key="Size.Notice.Max">320</sys:Double>
    <sys:Double x:Key="Size.Popup.LayoutMenu">336</sys:Double>
    <sys:Double x:Key="Size.LayoutTile.Min">88</sys:Double>
    <sys:Double x:Key="Size.Schematic.Menu.Width">72</sys:Double>
    <sys:Double x:Key="Size.Schematic.Menu.Height">40</sys:Double>

    <!-- Settings dialog -->
    <sys:Double x:Key="Size.Dialog.Settings.Width">480</sys:Double>
    <sys:Double x:Key="Size.Button.Dialog.Min">110</sys:Double>

    <!-- Logs grid columns (GridLength: a shared-size scope would jitter while rows recycle) -->
    <GridLength x:Key="Size.Log.Col.Time">170</GridLength>
    <GridLength x:Key="Size.Log.Col.Level">70</GridLength>
    <GridLength x:Key="Size.Log.Col.Category">120</GridLength>

    <!-- Font sizes (D8): four roles, nothing below 12 -->
    <sys:Double x:Key="Font.Size.Lead">16</sys:Double>
    <sys:Double x:Key="Font.Size.Title">14</sys:Double>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.Caption">12</sys:Double>

</ResourceDictionary>
