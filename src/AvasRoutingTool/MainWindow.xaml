<Window x:Class="AvasRoutingTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AvasRoutingTool.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Icon="Assets/AppIcon.ico"
        Title="AVAS Routing Tool - Advantech AVAS-223 Video Management"
        Height="{StaticResource Size.Window.Default.Height}" Width="{StaticResource Size.Window.Default.Width}"
        WindowState="Maximized"
        MinHeight="{StaticResource Size.Window.Min.Height}" MinWidth="{StaticResource Size.Window.Min.Width}"
        Background="{DynamicResource Brush.Background.Dark}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Global App Bar -->
        <Border x:Name="AppBar" Grid.Row="0"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <Grid MinHeight="{StaticResource Size.AppBar.Height}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel x:Name="BrandBlock" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Brand mark: tile follows P1B ('AV' Clasp) with gradient chevrons and medical cross. -->
                    <Border x:Name="BrandLogo"
                            Width="{StaticResource Size.Icon.Brand}" Height="{StaticResource Size.Icon.Brand}"
                            CornerRadius="6" Margin="0,0,8,0"
                            Background="{DynamicResource Brush.Background.Dark}"
                            BorderBrush="{DynamicResource Brush.Logo.TileBorder}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="AVAS Routing Tool logo">
                        <views:BrandMark Margin="2" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AVAS ROUTING TOOL"
                                   Style="{StaticResource Style.Text.Lead}"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="AppVersionText"
                                   Style="{StaticResource Style.Text.Caption}"
                                   AutomationProperties.Name="Application version" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs (Visual Routing vs BAVM Console vs Diagnostics & Logs) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Margin="8,0,0,0">
                    <RadioButton x:Name="TabVisualRouting"
                                 Style="{StaticResource Style.Tab.Nav}"
                                 Content="Visual Routing"
                                 GroupName="MainTabs"
                                 IsChecked="True"
                                 Checked="Tab_Checked"
                                 Margin="0,0,6,0"
                                 AutomationProperties.Name="Visual Routing" />

                    <RadioButton x:Name="TabRoomCameras"
                                 Style="{StaticResource Style.Tab.Nav}"
                                 Content="Room Cameras"
                                 GroupName="MainTabs"
                                 Checked="Tab_Checked"
                                 Margin="0,0,6,0"
                                 AutomationProperties.Name="Room Cameras" />

                    <RadioButton x:Name="TabBavmConsole"
                                 Style="{StaticResource Style.Tab.Nav}"
                                 Content="BAVM Console"
                                 GroupName="MainTabs"
                                 Checked="Tab_Checked"
                                 Margin="0,0,6,0"
                                 AutomationProperties.Name="BAVM Console" />

                    <RadioButton x:Name="TabLogs"
                                 Style="{StaticResource Style.Tab.Nav}"
                                 Content="Logs"
                                 GroupName="MainTabs"
                                 Checked="Tab_Checked"
                                 Visibility="Collapsed"
                                 AutomationProperties.Name="Diagnostics and Logs"
                                 ToolTip="Diagnostics and live logs" />
                </StackPanel>

                <!-- Actions & Status Area -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Connection Status Badge -->
                    <Border x:Name="ConnectionBadge"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="8,0"
                            MinHeight="{StaticResource Size.Touch.Min}"
                            Margin="0,0,6,0"
                            ToolTip="{Binding ConnectionStatus}"
                            AutomationProperties.Name="{Binding ConnectionStatus, StringFormat='Connection status: {0}'}"
                            AutomationProperties.LiveSetting="Polite">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource Style.StatusDot.Connection}" Tag="{Binding ConnectionHealth}" Margin="0,0,6,0" />
                            <TextBlock x:Name="ConnectionText" Text="{Binding ConnectionStatus}"
                                       Style="{StaticResource Style.Text.Body}"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </Border>

                    <!-- Divider: status readout | actions -->
                    <Border x:Name="AppBarDivider"
                            BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            Margin="0,10,10,10" />

                    <!-- Icon only at every width (the tooltip and automation name say what it does); the icon shows the active theme. -->
                    <Button x:Name="ThemeToggleButton"
                            Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource Style.Button.AppBar}"
                            Margin="0,0,2,0"
                            ToolTip="{Binding ThemeButtonToolTip}"
                            AutomationProperties.Name="Toggle theme mode"
                            AutomationProperties.HelpText="{Binding ThemeButtonToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource Style.Icon.ThemeToggle}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RefreshButton"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource Style.Button.AppBar}"
                            Margin="0,0,2,0"
                            ToolTip="Refresh discovered transceivers"
                            AutomationProperties.Name="Refresh devices"
                            AutomationProperties.HelpText="Refresh discovered transceivers">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" Style="{StaticResource Style.Icon.Action}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SettingsButton"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource Style.Button.AppBar}"
                            ToolTip="Configure BAVM URL, host IP, and ports"
                            AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource Style.Icon.Action}" />
                            <TextBlock x:Name="SettingsLabel" Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding ActualWidth, ElementName=AppBar, Converter={StaticResource Converter.WidthAtLeast}, ConverterParameter={StaticResource Size.Breakpoint.AppBarLabels}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Mode 1: Visual Routing Canvas -->
            <views:VisualRoutingView x:Name="ViewVisualRouting" Visibility="Visible" />

            <!-- Mode 1b: Room Cameras (PTZ control and the bound TX picture) -->
            <views:RoomCamerasView x:Name="ViewRoomCameras" Visibility="Collapsed" />

            <!-- Mode 2: Embedded BAVM Console in WebView2 -->
            <Grid x:Name="ViewBavmConsole" Visibility="Collapsed">
                <wv2:WebView2 x:Name="BavmWebView" />
            </Grid>

            <!-- Mode 3: Diagnostics & Live Logs -->
            <Grid x:Name="ViewLogs" Visibility="Collapsed" Background="{DynamicResource Brush.Background.Dark}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Logs Toolbar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.Surface.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log File:" Style="{StaticResource Style.Text.Body}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding LogFilePath}" Style="{StaticResource Style.Text.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LogFilePath}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ClearLogsButton"
                                    Command="{Binding ClearLogsCommand}"
                                    Style="{StaticResource Style.Button.Secondary}"
                                    MinHeight="{StaticResource Size.Touch.Min}"
                                    Margin="0,0,8,0"
                                    ToolTip="Clear the list on screen (the log file is kept)"
                                    AutomationProperties.Name="Clear log view">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Broom24" Style="{StaticResource Style.Icon.Action}" />
                                    <TextBlock Text="Clear view" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenLogFolderButton"
                                    Command="{Binding OpenLogFolderCommand}"
                                    Style="{StaticResource Style.Button.Secondary}"
                                    MinHeight="{StaticResource Size.Touch.Min}"
                                    ToolTip="Open the folder with the log files"
                                    AutomationProperties.Name="Open log folder">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" Style="{StaticResource Style.Icon.Action}" />
                                    <TextBlock Text="Open log folder" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log Entries List: the one virtualized list (D11); keep it out of any ScrollViewer -->
                <ListBox x:Name="LogList"
                         Grid.Row="1"
                         Style="{StaticResource Style.ListBox.Virtualized}"
                         ItemsSource="{Binding Logs}"
                         Margin="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource Size.Log.Col.Time}" />
                                    <ColumnDefinition Width="{StaticResource Size.Log.Col.Level}" />
                                    <ColumnDefinition Width="{StaticResource Size.Log.Col.Category}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Style.Text.Mono}" Foreground="{DynamicResource Brush.Text.Muted}"
                                           Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Style.Text.LogLevel}" Tag="{Binding Level}" Text="{Binding Level}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Style.Text.Mono}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontWeight="Medium" Text="{Binding Category}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource Style.Text.Mono}" TextWrapping="Wrap" Text="{Binding Message}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
