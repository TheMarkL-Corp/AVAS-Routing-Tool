<Window x:Class="AvasRoutingTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AvasRoutingTool.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="Assets/AppIcon.ico"
        Title="AVAS Routing Tool - Advantech AVAS-223 Video Management"
        Height="860" Width="1280"
        WindowState="Maximized"
        MinHeight="720" MinWidth="1024"
        Background="{DynamicResource Brush.Background.Dark}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Global App Bar -->
        <Border x:Name="AppBar" Grid.Row="0"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <Grid MinHeight="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel x:Name="BrandBlock" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Brand mark: tile follows P1B ('AV' Clasp) with gradient chevrons and medical cross. -->
                    <Border x:Name="BrandLogo" Width="28" Height="28" CornerRadius="6" Margin="0,0,8,0"
                            Background="{DynamicResource Brush.Background.Dark}"
                            BorderBrush="{DynamicResource Brush.Logo.TileBorder}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="AVAS Routing Tool logo">
                        <Viewbox Margin="2">
                            <Canvas Width="64" Height="64">
                                <!-- Upward Chevron "A" (Cyan to Sky Blue Gradient) -->
                                <Path Data="{StaticResource Icon.Logo.AChevron}"
                                      Stroke="{DynamicResource Brush.Logo.AChevron}"
                                      StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />

                                <!-- Downward Chevron "V" (Cobalt Blue Gradient) -->
                                <Path Data="{StaticResource Icon.Logo.VChevron}"
                                      Stroke="{DynamicResource Brush.Logo.VChevron}"
                                      StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />

                                <!-- Horizontal Routing Stream Bus (Left Input, Right Output) -->
                                <Path Data="{StaticResource Icon.Logo.StreamIn}"
                                      Stroke="{DynamicResource Brush.Logo.StreamIn}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="7" Canvas.Top="30" Width="4" Height="4" Fill="{DynamicResource Brush.Logo.StreamIn}" />

                                <Path Data="{StaticResource Icon.Logo.StreamOut}"
                                      Stroke="{DynamicResource Brush.Logo.StreamOut}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="53" Canvas.Top="30" Width="4" Height="4" Fill="{DynamicResource Brush.Logo.StreamOut}" />

                                <!-- Central Surgical Cross Core Node -->
                                <Border Canvas.Left="26" Canvas.Top="26" Width="12" Height="12" CornerRadius="3"
                                        Background="{DynamicResource Brush.Accent.Primary}"
                                        BorderBrush="{DynamicResource Brush.Text.OnAction}"
                                        BorderThickness="1.2">
                                    <Path Data="{StaticResource Icon.Logo.Cross}"
                                          Stroke="{DynamicResource Brush.Text.OnAction}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Border>

                                <!-- Chevrons Apex Accents -->
                                <Ellipse Canvas.Left="30" Canvas.Top="11" Width="4" Height="4" Fill="{DynamicResource Brush.Text.OnAction}" />
                                <Ellipse Canvas.Left="30" Canvas.Top="49" Width="4" Height="4" Fill="{DynamicResource Brush.Text.OnAction}" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AVAS ROUTING TOOL"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock x:Name="AppVersionText"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   AutomationProperties.Name="Application version" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs (Visual Routing vs BAVM Console vs Diagnostics & Logs) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Margin="8,0,0,0">
                    <RadioButton x:Name="TabVisualRouting"
                                 Style="{StaticResource Style.Tab.Nav}"
                                 Content="Visual Routing"
                                 GroupName="MainTabs"
                                 IsChecked="True"
                                 Checked="Tab_Checked"
                                 Margin="0,0,6,0"
                                 AutomationProperties.Name="Visual Routing" />

                    <RadioButton x:Name="TabBavmConsole"
                                 Style="{StaticResource Style.Tab.Nav}"
                                 Content="BAVM Console"
                                 GroupName="MainTabs"
                                 Checked="Tab_Checked"
                                 Margin="0,0,6,0"
                                 AutomationProperties.Name="BAVM Console" />

                    <RadioButton x:Name="TabLogs"
                                 Style="{StaticResource Style.Tab.Nav}"
                                 Content="Logs"
                                 GroupName="MainTabs"
                                 Checked="Tab_Checked"
                                 Visibility="Collapsed"
                                 AutomationProperties.Name="Diagnostics and Logs"
                                 ToolTip="Diagnostics and live logs" />
                </StackPanel>

                <!-- Actions & Status Area -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Connection Status Badge -->
                    <Border x:Name="ConnectionBadge"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="8,0"
                            MinHeight="48"
                            Margin="0,0,6,0"
                            ToolTip="{Binding ConnectionStatus}"
                            AutomationProperties.Name="Connection status">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Status.Offline}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Online}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatus}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </Border>

                    <!-- Divider: status readout | actions -->
                    <Rectangle x:Name="AppBarDivider"
                               Width="1" Height="28"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource Brush.Border.Default}" />

                    <!-- Icon-only: the sun/moon shows the active theme; the tooltip names what a click switches to. -->
                    <Button x:Name="ThemeToggleButton"
                            Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource Style.Button.AppBar}"
                            Margin="0,0,2,0"
                            ToolTip="{Binding ThemeButtonToolTip}"
                            AutomationProperties.Name="Toggle theme mode">
                        <Path>
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource Style.Icon.AppBar}">
                                    <Setter Property="Data" Value="{StaticResource Icon.Moon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightMode}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource Icon.Sun}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <Button x:Name="RefreshButton"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource Style.Button.AppBar}"
                            Margin="0,0,2,0"
                            ToolTip="Refresh discovered transceivers"
                            AutomationProperties.Name="Refresh devices">
                        <Path Style="{StaticResource Style.Icon.AppBar}" Data="{StaticResource Icon.Refresh}" />
                    </Button>

                    <Button x:Name="SettingsButton"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource Style.Button.AppBar}"
                            ToolTip="Configure BAVM URL, host IP, and ports"
                            AutomationProperties.Name="Settings">
                        <Path Style="{StaticResource Style.Icon.AppBar}" Data="{StaticResource Icon.Settings}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Mode 1: Visual Routing Canvas -->
            <views:VisualRoutingView x:Name="ViewVisualRouting" Visibility="Visible" />

            <!-- Mode 2: Embedded BAVM Console in WebView2 -->
            <Grid x:Name="ViewBavmConsole" Visibility="Collapsed">
                <wv2:WebView2 x:Name="BavmWebView" />
            </Grid>

            <!-- Mode 3: Diagnostics & Live Logs -->
            <Grid x:Name="ViewLogs" Visibility="Collapsed" Background="{DynamicResource Brush.Background.Dark}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Logs Toolbar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.Surface.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Log File:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LogFilePath}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="650" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding ClearLogsCommand}" Style="{StaticResource Style.Button.Secondary}" Padding="10,6" Margin="0,0,6,0">
                                <TextBlock Text="🧹  Clear View" FontSize="11" />
                            </Button>
                            <Button Command="{Binding OpenLogFolderCommand}" Style="{StaticResource Style.Button.Secondary}" Padding="10,6">
                                <TextBlock Text="📂  Open Log Folder" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log Entries List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Logs}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="12"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}" Foreground="{DynamicResource Brush.Text.Muted}" />
                                <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Staged}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Action.Danger}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Debug">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{DynamicResource Brush.Text.Secondary}" FontWeight="Medium" />
                                <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
