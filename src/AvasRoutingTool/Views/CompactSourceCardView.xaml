<UserControl x:Class="AvasRoutingTool.Views.CompactSourceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="{StaticResource Size.Composer.Palette.Card.Min}"
             Cursor="Hand"
             Focusable="True"
             IsTabStop="True"
             FocusVisualStyle="{x:Null}"
             AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}"
             KeyDown="Card_KeyDown"
             PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
             MouseMove="Card_MouseMove"
             MouseLeftButtonUp="Card_MouseLeftButtonUp">

    <!--
        A source in the Composer's palette strip (Ruling R21): name, online state, link mode, a small live thumbnail,
        and the Composer marks (armed ring + "Placing", "in N blocks"). Tap arms, drag places - as the full card.
    -->
    <Grid>
        <Border Style="{StaticResource Style.Surface.PaletteCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Size.Composer.Palette.Thumb}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Thumbnail (the source card's own live bitmap, fitted at 16:9) -->
                <!-- A StackPanel hands the panel an unbounded height, so it derives it from the 16:9 ratio -->
                <StackPanel VerticalAlignment="Top">
                <controls:FractionalLayoutPanel AspectRatio="{x:Static views:AspectRatioConverter.Default}">
                    <Border controls:FractionalLayoutPanel.W="1" controls:FractionalLayoutPanel.H="1"
                            Background="{DynamicResource Brush.Surface.PreviewBlack}" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding PreviewBitmap, Mode=OneWay}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                            <TextBlock Text="NO PREVIEW" Style="{StaticResource Style.Text.Block.Tiny}" Foreground="{DynamicResource Brush.Text.OnPreview}"
                                       Visibility="{Binding IsPreviewSupported, Mode=OneWay, Converter={StaticResource Converter.Visible.False}}" />
                        </Grid>
                    </Border>
                </controls:FractionalLayoutPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{Binding DeviceName, Mode=OneWay}" Style="{StaticResource Style.Text.Palette.Name}"
                               ToolTip="{Binding DeviceName, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Style.Text.Palette.Status}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ui:Badge x:Name="UsedInBlocksBadge" Style="{StaticResource Style.Badge.UsedIn}" Content="{Binding UsedInBlocks, Mode=OneWay}" />
                        <ui:Badge Style="{StaticResource Style.Badge.Armed}" Content="Placing"
                                  Visibility="{Binding IsArmed, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Offline: dimmed (the status line says "Offline" in words) -->
        <Border Style="{StaticResource Style.Shape.OfflineOverlay}" Background="{DynamicResource Brush.Surface.OfflineOverlay}" />

        <Border x:Name="FocusRing" Style="{StaticResource Style.Shape.CardFocusRing}" />

        <Border x:Name="ArmedRing" Style="{StaticResource Style.Shape.ArmedRing}" />
    </Grid>
</UserControl>
