<UserControl x:Class="AvasRoutingTool.Views.CompactSourceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             Width="292"
             Height="96"
             Cursor="Hand"
             Focusable="True"
             IsTabStop="True"
             FocusVisualStyle="{x:Null}"
             AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}"
             KeyDown="Card_KeyDown"
             PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
             MouseMove="Card_MouseMove"
             MouseLeftButtonUp="Card_MouseLeftButtonUp">

    <!--
        A source in the Composer's palette strip (Ruling R21): name, online state, link mode, a small live thumbnail,
        and the Composer marks (armed ring + "Placing", "in N blocks"). Tap arms, drag places - as the full card.
    -->
    <Grid>
        <Border Background="{DynamicResource Brush.Surface.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Thumbnail (the source card's own live bitmap, fitted) -->
                <Border Width="112" Height="63" Background="{DynamicResource Brush.Surface.PreviewBlack}" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Top">
                    <Grid>
                        <Image Source="{Binding PreviewBitmap, Mode=OneWay}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                        <TextBlock Text="NO PREVIEW" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnPreview}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewSupported, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{Binding DeviceName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DeviceName, Mode=OneWay}" />
                    <TextBlock FontSize="14" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding LinkMode, Mode=OneWay, StringFormat='Online · {0}'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="False">
                                        <Setter Property="Text" Value="Offline" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border x:Name="UsedInBlocksBadge"
                                Background="{DynamicResource Brush.Surface.Staged}"
                                BorderBrush="{DynamicResource Brush.Status.Staged}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="5,0"
                                Margin="0,0,4,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsedInBlocks, Mode=OneWay}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.StagedChipText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding UsedInBlocks, Mode=OneWay, StringFormat='in {0} blocks'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsedInBlocks, Mode=OneWay}" Value="1">
                                                <Setter Property="Text" Value="in 1 block" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Border Background="{DynamicResource Brush.Surface.CopyTarget}"
                                BorderBrush="{DynamicResource Brush.Border.DropTarget}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="5,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsArmed, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Placing" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.CopyAccent}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Offline: dimmed (the status line says "Offline" in words) -->
        <Border Background="{DynamicResource Brush.Surface.OfflineOverlay}" CornerRadius="8" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Keyboard focus: a 2 px ring just inside the edge (inside the armed ring), drawn here so it also renders -->
        <Border x:Name="FocusRing"
                Margin="3"
                BorderBrush="{DynamicResource Brush.Focus.Ring}"
                BorderThickness="2"
                CornerRadius="6"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding (views:InputModality.ShowsFocus), RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Armed ring (cyan), drawn over the edge so nothing moves -->
        <Border x:Name="ArmedRing"
                BorderBrush="{DynamicResource Brush.Border.DropTarget}"
                BorderThickness="3"
                CornerRadius="8"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsArmed, Mode=OneWay}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
