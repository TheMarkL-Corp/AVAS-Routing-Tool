<Window x:Class="AvasRoutingTool.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="System Settings"
        SizeToContent="Height"
        Width="{StaticResource Size.Dialog.Settings.Width}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background.Dark}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">

    <!-- Normal Windows chrome. The height follows the content up to the screen height (MaxHeight is set in code); the form scrolls beyond that. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Configuration &amp; Network" Style="{StaticResource Style.Text.Lead}" />
            <TextBlock Text="Customize server endpoints, ports, and SDVoE multicast parameters."
                       Style="{StaticResource Style.Text.Caption}"
                       Margin="0,4,0,0" />
            <TextBlock x:Name="VersionText"
                       Style="{StaticResource Style.Text.Caption}"
                       Foreground="{DynamicResource Brush.Text.Muted}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- BAVM Web URL -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="BAVM Web Management URL" Style="{StaticResource Style.Text.Body}" FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <ui:TextBox x:Name="TxtBavmUrl"
                                Style="{StaticResource Style.TextBox.Field}"
                                Margin="0,6,0,0"
                                AutomationProperties.Name="BAVM Web Management URL"
                                TextChanged="TxtBavmUrl_TextChanged" />
                    <TextBlock Text="Default: http://localhost:80 (Saved persistently across sessions)" Style="{StaticResource Style.Text.Caption}" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Derived Control Server IP -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Derived Control Server IP (Synced with BAVM Host)" Style="{StaticResource Style.Text.Body}" FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <ui:TextBox x:Name="TxtControlServerIp"
                                Style="{StaticResource Style.TextBox.Field}"
                                Margin="0,6,0,0"
                                AutomationProperties.Name="Derived Control Server IP (Synced with BAVM Host)"
                                Background="{DynamicResource Brush.Surface.Field}"
                                Foreground="{DynamicResource Brush.Text.Secondary}"
                                IsReadOnly="True" />
                </StackPanel>

                <!-- Ports -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Telnet Control Port" Style="{StaticResource Style.Text.Body}" FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <ui:TextBox x:Name="TxtTelnetPort"
                                Style="{StaticResource Style.TextBox.Field}"
                                Margin="0,6,0,0"
                                AutomationProperties.Name="Telnet Control Port" />
                </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="REST API Port" Style="{StaticResource Style.Text.Body}" FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <ui:TextBox x:Name="TxtRestPort"
                                Style="{StaticResource Style.TextBox.Field}"
                                Margin="0,6,0,0"
                                AutomationProperties.Name="REST API Port" />
                </StackPanel>
                </Grid>

                <!-- Multicast Range -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Multicast Pool Start" Style="{StaticResource Style.Text.Body}" FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <ui:TextBox x:Name="TxtMcastStart"
                                Style="{StaticResource Style.TextBox.Field}"
                                Margin="0,6,0,0"
                                AutomationProperties.Name="Multicast Pool Start" />
                </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Multicast Pool End" Style="{StaticResource Style.Text.Body}" FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <ui:TextBox x:Name="TxtMcastEnd"
                                Style="{StaticResource Style.TextBox.Field}"
                                Margin="0,6,0,0"
                                AutomationProperties.Name="Multicast Pool End" />
                </StackPanel>
                </Grid>

                <StackPanel>
                    <TextBlock Text="Stream 1 Scaler Preview Port" Style="{StaticResource Style.Text.Body}" FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <ui:TextBox x:Name="TxtBasePort"
                                Style="{StaticResource Style.TextBox.Field}"
                                Margin="0,6,0,0"
                                AutomationProperties.Name="Stream 1 Scaler Preview Port" />
                </StackPanel>

                <!-- Diagnostics -->
                <ui:ToggleSwitch x:Name="ChkShowLogs"
                                 Style="{StaticResource Style.ToggleSwitch.Setting}"
                                 Content="Show Logs tab (diagnostics)"
                                 Margin="0,16,0,0"
                                 AutomationProperties.Name="Show Logs tab" />

                <ui:ToggleSwitch x:Name="ChkShowAdvanced"
                                 Style="{StaticResource Style.ToggleSwitch.Setting}"
                                 Content="Show Advanced tab (maintenance)"
                                 Margin="0,8,0,0"
                                 AutomationProperties.Name="Show Advanced tab" />
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource Style.Button.Secondary}"
                    MinWidth="{StaticResource Size.Button.Dialog.Min}"
                    MinHeight="{StaticResource Size.Touch.Min}"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click" />
            <Button Content="Save &amp; Apply"
                    Style="{StaticResource Style.Button.Primary}"
                    MinWidth="{StaticResource Size.Button.Dialog.Min}"
                    MinHeight="{StaticResource Size.Touch.Min}"
                    Click="BtnSave_Click" />
        </StackPanel>
    </Grid>
</Window>
