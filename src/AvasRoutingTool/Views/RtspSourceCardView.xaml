<UserControl x:Class="AvasRoutingTool.Views.RtspSourceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="{StaticResource Size.Strip.Tile.Width}"
             Focusable="False"
             IsTabStop="False">

    <!-- DataContext: the MainViewModel. The tile is view only: no arm, drag, press or route handler of any kind. -->
    <ui:Card Style="{StaticResource Style.Card.Source}" Cursor="Arrow">
        <Grid>
            <!-- EMPTY: one box for the whole address. It is never echoed anywhere else. -->
            <StackPanel x:Name="EmptyLayout"
                        Visibility="{Binding ViewOnlySource, Mode=OneWay, Converter={StaticResource Converter.Visible.Null}}">
                <TextBlock Text="Add RTSP stream" Style="{StaticResource Style.Text.Title}" Margin="0,0,0,8" />
                <Grid>
                    <ui:TextBox x:Name="AddressBox"
                                Style="{StaticResource Style.TextBox.Field}"
                                MinHeight="{StaticResource Size.Touch.Min}"
                                AutomationProperties.Name="RTSP address"
                                TextChanged="AddressBox_TextChanged"
                                KeyDown="AddressBox_KeyDown" />
                    <TextBlock x:Name="AddressPlaceholder"
                               Text="rtsp://..."
                               Style="{StaticResource Style.Text.Caption}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </Grid>
                <TextBlock x:Name="ReasonText"
                           Style="{StaticResource Style.Text.Caption}"
                           TextWrapping="Wrap"
                           MinHeight="{StaticResource Size.Touch.Compact}"
                           Margin="0,6,0,0" />
                <Button x:Name="StartAddButton"
                        Content="Start"
                        Style="{StaticResource Style.Button.Secondary}"
                        MinHeight="{StaticResource Size.Touch.Min}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"
                        AutomationProperties.Name="Start RTSP stream"
                        Click="StartAddButton_Click" />
            </StackPanel>

            <!-- ACTIVE -->
            <Grid x:Name="ActiveLayout"
                  DataContext="{Binding ViewOnlySource, Mode=OneWay}"
                  Visibility="{Binding DataContext, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={StaticResource Converter.Visible.NotNull}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: dot, name, Remove -->
                <Grid Grid.Row="0" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="HeaderDot" Grid.Column="0" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource Style.StatusDot.Small}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Live">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Status.Online}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Action.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="RTSP stream" Style="{StaticResource Style.Text.Title}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button x:Name="RemoveButton" Grid.Column="2"
                            Style="{StaticResource Style.Button.IconPencil}"
                            Click="RemoveButton_Click"
                            AutomationProperties.Name="Remove RTSP stream"
                            ToolTip="Remove RTSP stream"
                            Margin="0,-12,0,-12">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="{StaticResource Size.Icon.S}" />
                    </Button>
                </Grid>

                <!-- Masked address; its tooltip is masked too -->
                <TextBlock x:Name="MaskedAddressText" Grid.Row="1"
                           Text="{Binding MaskedAddress, Mode=OneWay}"
                           ToolTip="{Binding MaskedAddress, Mode=OneWay}"
                           Style="{StaticResource Style.Text.Caption}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,8" />

                <!-- Picture: the frame while Live, otherwise the status as the message -->
                <Border Grid.Row="2"
                        Height="{StaticResource Size.Strip.Thumb.Height}"
                        Background="{DynamicResource Brush.Surface.PreviewTile}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="LiveImage"
                               Source="{Binding PreviewBitmap, Mode=OneWay}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="LowQuality"
                               Visibility="{Binding IsLive, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}" />
                        <TextBlock x:Name="PictureMessage"
                                   Text="{Binding StatusText, Mode=OneWay}"
                                   Foreground="{DynamicResource Brush.Text.OnPreviewMuted}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Caption}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Live">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Always visible: what this tile cannot do -->
                <TextBlock x:Name="ViewOnlyBadge" Grid.Row="3"
                           Text="View only - cannot be routed to a display"
                           AutomationProperties.HelpText="View only - cannot be routed to a display"
                           Style="{StaticResource Style.Text.Status}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <!-- Footer: the state word plus its text (never colour alone), and the actions this state allows -->
                <Grid Grid.Row="4" Margin="0,4,0,0" MinHeight="{StaticResource Size.Touch.Min}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StateWord" Style="{StaticResource Style.Text.Status}" Text="{Binding State, Mode=OneWay}" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusLine" Grid.Column="1" Text="{Binding StatusDetail, Mode=OneWay}" Style="{StaticResource Style.Text.Caption}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding StatusText, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="StopButton"
                                Command="{Binding StopCommand, Mode=OneWay}"
                                AutomationProperties.Name="Stop RTSP stream" ToolTip="Stop">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Style.Button.IconPencil}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Connecting"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Live"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Lost"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ui:SymbolIcon Symbol="Stop24" FontSize="{StaticResource Size.Icon.S}" />
                        </Button>
                        <Button x:Name="StartButton"
                                Command="{Binding StartCommand, Mode=OneWay}"
                                AutomationProperties.Name="Start RTSP stream" ToolTip="Start">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Style.Button.IconPencil}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Stopped"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ui:SymbolIcon Symbol="Play24" FontSize="{StaticResource Size.Icon.S}" />
                        </Button>
                        <Button x:Name="RetryButton"
                                Command="{Binding RetryCommand, Mode=OneWay}"
                                AutomationProperties.Name="Retry RTSP stream" ToolTip="Retry">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Style.Button.IconPencil}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Lost"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="{StaticResource Size.Icon.S}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ui:Card>
</UserControl>
