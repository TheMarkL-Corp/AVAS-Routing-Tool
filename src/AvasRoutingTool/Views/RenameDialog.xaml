<Window x:Class="AvasRoutingTool.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        SizeToContent="Height"
        Width="{StaticResource Size.Dialog.Settings.Width}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background.Dark}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">

    <!-- Normal Windows chrome, like the settings dialog. Enter presses Rename (while it is enabled), Esc presses Cancel. -->
    <StackPanel Margin="24">
        <!-- Header -->
        <TextBlock Text="{Binding Title}"
                   Style="{StaticResource Style.Text.Lead}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="The new name is written to the Control Server."
                   Style="{StaticResource Style.Text.Caption}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />

        <!-- The field has no MaxLength: a name that is too long stays visible, and the line under it says why it is refused. -->
        <ui:TextBox x:Name="NameBox"
                    Style="{StaticResource Style.TextBox.Field}"
                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,20,0,0"
                    AutomationProperties.Name="New name" />

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Why Rename is off. A rule that is broken reads as an error; "Type a different name" is just a hint. -->
            <TextBlock x:Name="ReasonText"
                       Grid.Column="0"
                       Text="{Binding Reason}"
                       Visibility="{Binding HasReason, Converter={StaticResource Converter.Visible.True}}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Caption}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="CountText"
                       Grid.Column="1"
                       Text="{Binding CountText}"
                       Style="{StaticResource Style.Text.Caption}"
                       HorizontalAlignment="Right" />
        </Grid>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Style="{StaticResource Style.Button.Secondary}"
                    MinWidth="{StaticResource Size.Button.Dialog.Min}"
                    MinHeight="{StaticResource Size.Touch.Min}"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="BtnCancel_Click" />
            <Button x:Name="RenameButton"
                    Content="Rename"
                    Style="{StaticResource Style.Button.Primary}"
                    MinWidth="{StaticResource Size.Button.Dialog.Min}"
                    MinHeight="{StaticResource Size.Touch.Min}"
                    IsDefault="True"
                    IsEnabled="{Binding CanRename}"
                    Click="BtnRename_Click" />
        </StackPanel>
    </StackPanel>
</Window>
