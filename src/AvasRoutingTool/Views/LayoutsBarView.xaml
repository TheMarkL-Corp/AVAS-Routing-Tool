<UserControl x:Class="AvasRoutingTool.Views.LayoutsBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             Height="110">

    <Border Background="{DynamicResource Brush.Surface.Card}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bar Header -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource Icon.Grid}"
                      Fill="{DynamicResource Brush.Accent.Primary}"
                      Width="14" Height="14"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Margin="0,0,6,0" />
                <TextBlock Grid.Column="1"
                           Text="LAYOUT MODES"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="• Drag a layout onto a display - or use Layout ▾ on the display's card. MultiView opens the Composer; Single View and Off apply now."
                           FontSize="11"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </Grid>

            <!-- Layout tiles: the real block geometry as a schematic, and the name (drag one onto a display card) -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Layouts}" HorizontalAlignment="Left" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="LayoutTile"
                                MinWidth="132"
                                Margin="0,0,8,0"
                                Background="{DynamicResource Brush.Surface.Elevated}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,5"
                                Cursor="Hand"
                                ToolTip="{Binding Subtitle, Mode=OneWay}"
                                PreviewMouseLeftButtonDown="LayoutCard_PreviewMouseLeftButtonDown"
                                MouseMove="LayoutCard_MouseMove">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable, Mode=OneWay}" Value="False">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel VerticalAlignment="Center">
                                <views:LayoutSchematic LayoutId="{Binding Id, Mode=OneWay}" Width="64" Height="36" HorizontalAlignment="Center" />
                                <TextBlock x:Name="LayoutTileTitle"
                                           Text="{Binding Title, Mode=OneWay}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
