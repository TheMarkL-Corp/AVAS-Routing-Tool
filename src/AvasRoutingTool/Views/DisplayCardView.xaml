<UserControl x:Class="AvasRoutingTool.Views.DisplayCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             MinWidth="320"
             AllowDrop="True"
             DragEnter="Card_DragOver"
             DragOver="Card_DragOver"
             DragLeave="Card_DragLeave"
             Drop="Card_Drop"
             PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
             PreviewMouseMove="Card_PreviewMouseMove"
             PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp"
             MouseLeftButtonUp="Card_MouseLeftButtonUp">

    <UserControl.Resources>
        <!-- A dark panel over the card body that states a choice or a copy target state in words -->
        <Style x:Key="BodyOverlay" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="CardFrame"
                Background="{StaticResource Brush.Surface.Card}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.DropTarget}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRouted}" Value="True" />
                                <Condition Binding="{Binding IsDragOver}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Routed}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <!--
                Rows: 0 name + badge, 1 the header's buttons (Layout, Copy layout: at the top, so they stay in view
                when a short window shows only the top of the card), 2 why Copy layout is off, 3 the picture,
                4 the draft chip, 5 telemetry, 6 Turn Off. Rows 2 and 6 are the same height and (almost) never shown
                together, so the picture keeps 16:9 with GridSpec.DisplayCard.
            -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card header: name and what is on screen (with the fill) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status indicator dot -->
                    <Ellipse Grid.Column="0"
                             Width="8" Height="8"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.Status.Offline}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Status.Online}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Strict BAVM Device Name -->
                    <TextBlock x:Name="DeviceNameText"
                               Grid.Column="1"
                               Text="{Binding DeviceName, Mode=OneWay}"
                               ToolTip="{Binding DeviceName, Mode=OneWay}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <!-- Routed status pill: the layout and its fill ("MATRIX 2X2 · 3/4") -->
                    <Border Grid.Column="2"
                                VerticalAlignment="Center"
                                CornerRadius="4"
                                Padding="6,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#223049" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                            <Setter Property="Background" Value="#263B82F6" />
                                            <Setter Property="BorderBrush" Value="#4D3B82F6" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMultiView}" Value="True">
                                            <Setter Property="Background" Value="#263B82F6" />
                                            <Setter Property="BorderBrush" Value="#4D3B82F6" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock x:Name="ModeBadgeText" Text="{Binding ModeBadge, Mode=OneWay}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMultiView}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                    </Border>
                </Grid>

                <!-- The header's buttons: Layout ▾ (spec 5.1) and Copy layout (spec 15, the only start of a copy drag) -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Layout ▾: Single View, the four MultiView presets, Off -->
                    <Button x:Name="LayoutButton"
                            Grid.Column="0"
                            Style="{StaticResource Style.Button.Composer}"
                            Padding="8,6"
                            AutomationProperties.Name="Layout"
                            ToolTip="Choose a layout for this display"
                            Click="LayoutButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Grid}"
                                  Fill="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Layout ▾" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!--
                        Copy layout: a tap arms this display (tap again to stop); a drag (8 px threshold) copies it onto
                        the card it is released on. Only this handle starts a copy drag.
                    -->
                    <Button x:Name="CopyLayoutHandle"
                            Grid.Column="2"
                            Padding="8,6"
                            IsEnabled="{Binding CanCopyFrom, Mode=OneWay}"
                            AutomationProperties.Name="Copy layout"
                            ToolTip="Drag onto another display to copy this picture there - or tap, then tap a display"
                            ToolTipService.ShowOnDisabled="True"
                            Click="CopyHandle_Click"
                            PreviewMouseLeftButtonDown="CopyHandle_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="CopyHandle_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="CopyHandle_PreviewMouseLeftButtonUp">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Composer}">
                                <Setter Property="Background" Value="#082F3A" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.DropTarget}" />
                                <Setter Property="Foreground" Value="#A5F3FC" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCopySource, Mode=OneWay}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.Border.DropTarget}" />
                                        <Setter Property="Foreground" Value="#04232B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Copy}"
                                  Stroke="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Copy layout" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Why Copy layout is off, in words ("RX1 shows nothing to copy"), under the handle -->
                <TextBlock x:Name="CopyFromBlockedLabel"
                           Grid.Row="2"
                           Text="{Binding CopyFromBlockedText, Mode=OneWay}"
                           FontSize="13"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           TextWrapping="Wrap"
                           TextAlignment="Right"
                           MinHeight="22"
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanCopyFrom, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Live Video Preview Surface -->
                <Border x:Name="PreviewSurface"
                        Grid.Row="3"
                        Margin="0,6,0,0"
                        Background="#070A0F"
                        BorderBrush="{StaticResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="6"
                        ClipToBounds="True">
                  <Grid>
                    <!-- Multiview: one drop zone + mirrored preview per window -->
                    <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMultiView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:FractionalLayoutPanel
                                    AspectRatio="{Binding DataContext.CanvasAspect, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="controls:FractionalLayoutPanel.X" Value="{Binding NormalizedX, Mode=OneWay}" />
                                <Setter Property="controls:FractionalLayoutPanel.Y" Value="{Binding NormalizedY, Mode=OneWay}" />
                                <Setter Property="controls:FractionalLayoutPanel.W" Value="{Binding NormalizedWidth, Mode=OneWay}" />
                                <Setter Property="controls:FractionalLayoutPanel.H" Value="{Binding NormalizedHeight, Mode=OneWay}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="1"
                                        Background="#0B0F17"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        ClipToBounds="True"
                                        AllowDrop="True"
                                        DragEnter="Slot_DragOver"
                                        DragOver="Slot_DragOver"
                                        DragLeave="Slot_DragLeave"
                                        Drop="Slot_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Routed}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.DropTarget}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Image Source="{Binding PreviewBitmap}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="LowQuality" />

                                        <!-- Source tag -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="4"
                                                Background="#D90B0F17"
                                                BorderBrush="#33FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="4,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SourceName, Mode=OneWay}"
                                                       Foreground="{StaticResource Brush.Text.Primary}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>

                                        <!-- Assigned but no preview (non-AVAS source) -->
                                        <TextBlock Text="Preview not available"
                                                   FontSize="9"
                                                   Foreground="{StaticResource Brush.Text.Muted}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsAssigned}" Value="True" />
                                                                <Condition Binding="{Binding IsPreviewSupported}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Empty window hint -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding Label, Mode=OneWay}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource Brush.Text.Muted}"
                                                       HorizontalAlignment="Center"
                                                       Opacity="0.6" />
                                            <TextBlock Text="Drop source"
                                                       FontSize="9"
                                                       Foreground="#475569"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Single View surface (hidden while a multiview layout is active) -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMultiView}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- Actual Mirrored Video Image -->
                        <Image Source="{Binding PreviewBitmap}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="LowQuality" />

                        <!-- Active Source overlay tag (visible when video is playing) -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8"
                                Background="#D90B0F17"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsRouted}" Value="True" />
                                                <Condition Binding="{Binding IsPreviewSupported}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="● " Foreground="#10B981" FontSize="9" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveSourceName}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Routed to Non-AVAS Device Overlay (No preview stream available) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsRouted}" Value="True" />
                                                <Condition Binding="{Binding IsPreviewSupported}" Value="False" />
                                                <Condition Binding="{Binding IsExternalLayout}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource Icon.Monitor}"
                                  Fill="{StaticResource Brush.Accent.Primary}"
                                  Width="26" Height="26"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="Routed to Source"
                                       FontSize="10"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,2" />
                            <TextBlock Text="{Binding ActiveSourceName}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Preview Not Available (Non-AVAS Device)"
                                       FontSize="10"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Decoder runs a multiview layout set elsewhere (found when restoring state): read-only notice -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320" Margin="12"
                                    ToolTip="{Binding ExternalLayoutName, Mode=OneWay}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExternalLayout}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource Icon.Monitor}"
                                  Fill="{StaticResource Brush.Accent.Primary}"
                                  Width="26" Height="26"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ExternalLayoutText, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="Drop a source to switch this display to Single View"
                                       FontSize="9"
                                       Foreground="#475569"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Unrouted / Drop Target Placeholder -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Path Data="{StaticResource Icon.Monitor}"
                                  Fill="{StaticResource Brush.Text.Muted}"
                                  Width="28" Height="28"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Opacity="0.35" />

                            <TextBlock Text="Drop Source Here to Route"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="Drag any TX card above or 'Off' to turn off"
                                       FontSize="9"
                                       Foreground="#475569"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Why the last layout / multiview action was refused (above both surfaces) -->
                    <Border VerticalAlignment="Bottom"
                            Margin="6"
                            Background="#E61F0A0A"
                            BorderBrush="#4DEF4444"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding LastError, Mode=OneWay}"
                                   Foreground="#FCA5A5"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </Border>
                  </Grid>
                </Border>

                <!-- Draft chip: Composer changes that are not on screen; a tap resumes them (spec 5.1, 15) -->
                <Button x:Name="DraftChip"
                        Grid.Row="4"
                        Margin="0,6,0,0"
                        MinHeight="56"
                        Cursor="Hand"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Draft, not on screen. Resume"
                        ToolTip="Open the Composer with the draft"
                        Click="DraftChip_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDraft, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Rectangle x:Name="DraftFrame"
                                           Fill="#2A1F08"
                                           Stroke="{StaticResource Brush.Status.Staged}"
                                           StrokeThickness="1.5"
                                           StrokeDashArray="4 3"
                                           RadiusX="8" RadiusY="8" />
                                <ContentPresenter Margin="10,6" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DraftFrame" Property="Fill" Value="#3A2B0B" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="DraftFrame" Property="Stroke" Value="{StaticResource Brush.Focus.Ring}" />
                                    <Setter TargetName="DraftFrame" Property="StrokeThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <DockPanel>
                        <Border DockPanel.Dock="Right"
                                BorderBrush="{StaticResource Brush.Status.Staged}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,5"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="Resume" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Status.StagedChipText}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DRAFT - not on screen"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Status.StagedChipText}"
                                       TextWrapping="Wrap" />
                            <!-- A copy replaced the screen the draft was made on -->
                            <TextBlock x:Name="DraftNoticeText"
                                       Text="{Binding DraftNotice, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{StaticResource Brush.Status.StagedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DraftNotice, Mode=OneWay}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <!-- Card Telemetry Row (one line; the output format line only in MultiView) -->
                <Grid Grid.Row="5" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding IpAddress, Mode=OneWay}" />
                            <Run Text=" · " Foreground="{StaticResource Brush.Text.Muted}" />
                            <Run Text="{Binding MacAddress, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Muted}" />
                        </TextBlock>
                        <!-- Decoder output format from the display's EDID (multiview only) -->
                        <TextBlock Text="{Binding CanvasInfo, Mode=OneWay}"
                                   ToolTip="{Binding CanvasInfo, Mode=OneWay}"
                                   FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Accent}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanvasInfo, Mode=OneWay}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Active Source Label / Status -->
                    <TextBlock Grid.Column="1" FontSize="10" Foreground="{StaticResource Brush.Text.Muted}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,1,0,0">
                        <Run Text="SOURCE: " />
                        <Run Text="{Binding SourceLabel, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Secondary}" FontWeight="Medium" />
                    </TextBlock>
                </Grid>

                <!-- Turn Off / Disconnect Button (Phase 1; the Layout menu's Off does the same) -->
                <Button Grid.Row="6"
                        Margin="0,4,0,0"
                        MinHeight="22"
                        HorizontalAlignment="Left"
                        Command="{Binding UnrouteCommand}"
                        ToolTip="Turn off display feed / Unroute video"
                        Background="#26EF4444"
                        Foreground="#EF4444"
                        BorderBrush="#4DEF4444"
                        BorderThickness="1"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Padding="8,3"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏻" FontSize="10" Margin="0,0,4,0" />
                        <TextBlock Text="Turn Off" />
                    </StackPanel>
                </Button>
                <!--
                    Card body overlays (picture, draft chip and telemetry rows), above the live picture: the drop choice
                    and the copy target states. Always words, never colour alone.
                -->

                <!-- A source dropped / tapped on a MultiView card: it asks; nothing is replaced silently -->
                <Border x:Name="DropChoicePanel"
                        Grid.Row="3" Grid.RowSpan="3"
                        Background="#0A0E16"
                        BorderBrush="{StaticResource Brush.Border.DropTarget}"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BodyOverlay}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropChoiceOpen, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" Margin="10,8">
                        <TextBlock x:Name="DropChoiceTitle"
                                   Text="{Binding DropChoiceSource.DeviceName, Mode=OneWay, StringFormat='Where should {0} go?'}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button x:Name="FullScreenButton"
                                    Style="{StaticResource Style.Button.Composer}"
                                    Background="{StaticResource Brush.Action.Take}"
                                    BorderBrush="{StaticResource Brush.Action.Take}"
                                    Foreground="{StaticResource Brush.Text.OnAction}"
                                    Padding="8,6"
                                    Margin="0,0,5,0"
                                    AutomationProperties.Name="Full screen, Single View, goes on screen now"
                                    Click="FullScreen_Click">
                                <TextBlock Text="Full screen (Single View)" TextWrapping="Wrap" TextAlignment="Center" />
                            </Button>
                            <Button x:Name="IntoBlockButton"
                                    Style="{StaticResource Style.Button.Composer}"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource Brush.Border.DropTarget}"
                                    Foreground="#A5F3FC"
                                    Padding="8,6"
                                    Margin="5,0,0,0"
                                    AutomationProperties.Name="Into a block, opens the Composer"
                                    Click="IntoBlock_Click">
                                <TextBlock Text="Into a block…" TextWrapping="Wrap" TextAlignment="Center" />
                            </Button>
                        </UniformGrid>
                        <TextBlock Text="Full screen goes on screen now. Into a block opens the Composer."
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Copy target, allowed: "Release to copy here" + what will be copied (the view model's text) -->
                <Border x:Name="CopyTargetAllowedPanel"
                        Grid.Row="3" Grid.RowSpan="3"
                        Background="#082F3A">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BodyOverlay}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCopyTargetAllowed, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Top" Margin="12,14,12,8">
                        <TextBlock Text="Release to copy here"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#A5F3FC"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="CopyTargetAllowedText"
                                   Text="{Binding CopyTargetText, Mode=OneWay}"
                                   FontSize="14"
                                   Foreground="#CFFAFE"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Copy target, blocked: lock + the reason; no ring -->
                <Border x:Name="CopyTargetBlockedPanel"
                        Grid.Row="3" Grid.RowSpan="3"
                        Background="#0A0E16">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BodyOverlay}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCopyTargetBlocked, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Top" Margin="12,14,12,8">
                        <Path x:Name="CopyTargetLock"
                              Data="{StaticResource Icon.Lock}"
                              Stroke="#E2E8F0"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              Width="26" Height="26"
                              Stretch="Uniform"
                              HorizontalAlignment="Center" />
                        <TextBlock x:Name="CopyTargetBlockedText"
                                   Text="{Binding CopyTargetText, Mode=OneWay}"
                                   FontSize="14"
                                   Foreground="#F1F5F9"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- This display is the copy source (armed by a tap, or being dragged) -->
                <Border x:Name="CopySourceChip"
                        Grid.Row="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="6"
                        Background="{StaticResource Brush.Border.DropTarget}"
                        CornerRadius="4"
                        Padding="8,3"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCopySource, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="COPYING FROM HERE" FontSize="12" FontWeight="Bold" Foreground="#04232B" />
                </Border>

                <!-- After a copy onto this display: what it shows now, and Undo for 10 s (on top: Undo stays reachable) -->
                <Border x:Name="UndoToast"
                        Grid.Row="3"
                        VerticalAlignment="Bottom"
                        Margin="6"
                        Background="#F20B2A1E"
                        BorderBrush="{StaticResource Brush.Status.Online}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="10,4,4,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <!-- CanUndoScreen, not the command's CanExecute -->
                                <DataTrigger Binding="{Binding CanUndoScreen, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button x:Name="UndoScreenButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Style.Button.Composer}"
                                Background="Transparent"
                                BorderBrush="{StaticResource Brush.Status.Online}"
                                Foreground="#A7F3D0"
                                Content="Undo"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Undo the copy"
                                Click="UndoScreen_Click" />
                        <TextBlock x:Name="UndoToastLabel"
                                   Text="{Binding UndoToastText, Mode=OneWay}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#A7F3D0"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Copy target, allowed: a cyan ring around the card (an overlay, so nothing moves) -->
        <Border x:Name="CopyTargetRing"
                BorderBrush="{StaticResource Brush.Border.DropTarget}"
                BorderThickness="3"
                CornerRadius="8"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCopyTargetAllowed, Mode=OneWay}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- The header's Layout menu: six schematic tiles (the layout on screen marked) -->
        <Popup x:Name="LayoutMenuPopup"
               PlacementTarget="{Binding ElementName=LayoutButton}"
               Placement="Custom"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsLayoutMenuOpen, Mode=TwoWay}"
               Closed="LayoutMenu_Closed">
            <Border x:Name="LayoutMenuFrame"
                    Width="336"
                    Background="#0F1626"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding DeviceName, Mode=OneWay, StringFormat='Layout for {0}'}"
                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="A MultiView layout opens the Composer: nothing changes on screen until Take. Single View and Off apply now."
                               FontSize="13"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,6" />
                    <ItemsControl x:Name="LayoutMenuItems" ItemsSource="{Binding LayoutMenu, Mode=OneWay}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="LayoutMenuTile"
                                        MinHeight="88"
                                        Margin="4"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Cursor="Hand"
                                        AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                                        ToolTip="{Binding Subtitle, Mode=OneWay}"
                                        Click="LayoutMenuTile_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd"
                                                    Background="{StaticResource Brush.Surface.Card}"
                                                    BorderBrush="#334155"
                                                    BorderThickness="2"
                                                    CornerRadius="8"
                                                    Padding="8,6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Surface.Hover}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Id, Mode=OneWay}" Value="off">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#7F1D1D" />
                                                    <Setter TargetName="bd" Property="Background" Value="#1A0B0B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}" />
                                                    <Setter TargetName="bd" Property="Background" Value="#172554" />
                                                </DataTrigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Focus.Ring}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <views:LayoutSchematic LayoutId="{Binding Id, Mode=OneWay}" Width="72" Height="40" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LayoutMenuTitle"
                                                   Text="{Binding Title, Mode=OneWay}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <!-- The layout on screen, in words (an unrouted display shows nothing, so nothing is marked) -->
                                        <TextBlock Text="✓ On screen"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.Text.Accent}"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, Mode=OneWay}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.IsRouted, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>

        <!-- The drag ghost: the source's mini picture follows the pointer while a copy is dragged -->
        <Popup x:Name="CopyGhost"
               PlacementTarget="{Binding ElementName=CardFrame}"
               Placement="Relative"
               AllowsTransparency="True"
               IsHitTestVisible="False"
               Focusable="False">
            <Border Width="184"
                    Background="#0F1626"
                    BorderBrush="{StaticResource Brush.Border.DropTarget}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="6"
                    IsHitTestVisible="False">
                <StackPanel>
                    <Rectangle x:Name="GhostPicture" Height="90" RadiusX="4" RadiusY="4" />
                    <TextBlock Text="{Binding DeviceName, Mode=OneWay, StringFormat='Copying {0}'}"
                               FontSize="12" FontWeight="Bold" Foreground="#A5F3FC" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ModeBadge, Mode=OneWay}" FontSize="11" Foreground="#CFFAFE" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
