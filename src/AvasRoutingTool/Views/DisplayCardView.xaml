<UserControl x:Class="AvasRoutingTool.Views.DisplayCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300" Height="220"
             Margin="8"
             AllowDrop="True"
             DragEnter="Card_DragEnter"
             DragOver="Card_DragOver"
             DragLeave="Card_DragLeave"
             Drop="Card_Drop">

    <Border Background="{StaticResource Brush.Surface.Card}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.DropTarget}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsRouted}" Value="True" />
                            <Condition Binding="{Binding IsDragOver}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Routed}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Card Header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status indicator dot -->
                <Ellipse Grid.Column="0"
                         Width="8" Height="8"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Brush.Status.Offline}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Status.Online}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Strict BAVM Device Name -->
                <TextBlock Grid.Column="1"
                           Text="{Binding DeviceName}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!-- Routed Status Pill -->
                <Border Grid.Column="2"
                        CornerRadius="4"
                        Padding="6,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#223049" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                    <Setter Property="Background" Value="#263B82F6" />
                                    <Setter Property="BorderBrush" Value="#4D3B82F6" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock FontSize="10" FontWeight="Medium">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="UNROUTED" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                        <Setter Property="Text" Value="SINGLE VIEW" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- Display Routing Body -->
            <Border Grid.Row="1"
                    Background="#0B0F17"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <Grid>
                    <!-- Routed State View -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Path Data="{StaticResource Icon.Monitor}"
                              Fill="{StaticResource Brush.Accent.Primary}"
                              Width="26" Height="26"
                              Stretch="Uniform"
                              HorizontalAlignment="Center" />

                        <TextBlock Text="Active Source"
                                   FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,2" />

                        <TextBlock Text="{Binding ActiveSourceName}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <Button Content="✕  Unroute Video"
                                Style="{StaticResource Style.Button.Unroute}"
                                Command="{Binding UnrouteCommand}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Unrouted / Drop Target Placeholder -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Path Data="{StaticResource Icon.Monitor}"
                              Fill="{StaticResource Brush.Text.Muted}"
                              Width="26" Height="26"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Opacity="0.4" />

                        <TextBlock Text="Drop Source Here to Route"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card Footer -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding IpAddress}"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding MacAddress}"
                               FontSize="10"
                               Foreground="{StaticResource Brush.Text.Muted}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource Brush.Surface.Elevated}"
                        CornerRadius="4"
                        Padding="6,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="TARGET DISPLAY"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
