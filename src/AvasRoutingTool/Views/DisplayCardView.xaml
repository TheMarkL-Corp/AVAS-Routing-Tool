<UserControl x:Class="AvasRoutingTool.Views.DisplayCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             MinWidth="320"
             AllowDrop="True"
             DragEnter="Card_DragEnter"
             DragOver="Card_DragOver"
             DragLeave="Card_DragLeave"
             Drop="Card_Drop">

    <Border Background="{StaticResource Brush.Surface.Card}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.DropTarget}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsRouted}" Value="True" />
                            <Condition Binding="{Binding IsDragOver}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Routed}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Card Header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status indicator dot -->
                <Ellipse Grid.Column="0"
                         Width="8" Height="8"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Brush.Status.Offline}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Status.Online}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Strict BAVM Device Name -->
                <TextBlock Grid.Column="1"
                           Text="{Binding DeviceName}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!-- Routed Status Pill -->
                <Border Grid.Column="2"
                        CornerRadius="4"
                        Padding="6,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#223049" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                    <Setter Property="Background" Value="#263B82F6" />
                                    <Setter Property="BorderBrush" Value="#4D3B82F6" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMultiView}" Value="True">
                                    <Setter Property="Background" Value="#263B82F6" />
                                    <Setter Property="BorderBrush" Value="#4D3B82F6" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="{Binding ModeBadge, Mode=OneWay}" FontSize="10" FontWeight="Medium">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Primary}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMultiView}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- Live Video Preview Surface -->
            <Border Grid.Row="1"
                    Background="#070A0F"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
              <Grid>
                <!-- Multiview: one drop zone + mirrored preview per window -->
                <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:FractionalLayoutPanel
                                AspectRatio="{Binding DataContext.CanvasAspect, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="controls:FractionalLayoutPanel.X" Value="{Binding NormalizedX, Mode=OneWay}" />
                            <Setter Property="controls:FractionalLayoutPanel.Y" Value="{Binding NormalizedY, Mode=OneWay}" />
                            <Setter Property="controls:FractionalLayoutPanel.W" Value="{Binding NormalizedWidth, Mode=OneWay}" />
                            <Setter Property="controls:FractionalLayoutPanel.H" Value="{Binding NormalizedHeight, Mode=OneWay}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="1"
                                    Background="#0B0F17"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    ClipToBounds="True"
                                    AllowDrop="True"
                                    DragEnter="Slot_DragOver"
                                    DragOver="Slot_DragOver"
                                    DragLeave="Slot_DragLeave"
                                    Drop="Slot_Drop">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Routed}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.DropTarget}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Source="{Binding PreviewBitmap}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="LowQuality" />

                                    <!-- Source tag -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="4"
                                            Background="#D90B0F17"
                                            BorderBrush="#33FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="4,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SourceName, Mode=OneWay}"
                                                   Foreground="{StaticResource Brush.Text.Primary}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- Assigned but no preview (non-AVAS source) -->
                                    <TextBlock Text="Preview not available"
                                               FontSize="9"
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsAssigned}" Value="True" />
                                                            <Condition Binding="{Binding IsPreviewSupported}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Empty window hint -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Label, Mode=OneWay}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.Text.Muted}"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.6" />
                                        <TextBlock Text="Drop source"
                                                   FontSize="9"
                                                   Foreground="#475569"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Single View surface (hidden while a multiview layout is active) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <!-- Actual Mirrored Video Image -->
                    <Image Source="{Binding PreviewBitmap}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="LowQuality" />

                    <!-- Active Source overlay tag (visible when video is playing) -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="8"
                            Background="#D90B0F17"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsRouted}" Value="True" />
                                            <Condition Binding="{Binding IsPreviewSupported}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="● " Foreground="#10B981" FontSize="9" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveSourceName}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Routed to Non-AVAS Device Overlay (No preview stream available) -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsRouted}" Value="True" />
                                            <Condition Binding="{Binding IsPreviewSupported}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource Icon.Monitor}"
                              Fill="{StaticResource Brush.Accent.Primary}"
                              Width="26" Height="26"
                              Stretch="Uniform"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="Routed to Source"
                                   FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,2" />
                        <TextBlock Text="{Binding ActiveSourceName}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Preview Not Available (Non-AVAS Device)"
                                   FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Unrouted / Drop Target Placeholder -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Path Data="{StaticResource Icon.Monitor}"
                              Fill="{StaticResource Brush.Text.Muted}"
                              Width="28" Height="28"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Opacity="0.35" />

                        <TextBlock Text="Drop Source Here to Route"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="Drag any TX card above or 'Off' to turn off"
                                   FontSize="9"
                                   Foreground="#475569"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Why the last layout / multiview action was refused (above both surfaces) -->
                <Border VerticalAlignment="Bottom"
                        Margin="6"
                        Background="#E61F0A0A"
                        BorderBrush="#4DEF4444"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding LastError, Mode=OneWay}"
                               Foreground="#FCA5A5"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </Border>
              </Grid>
            </Border>

            <!-- Card Telemetry Row -->
            <Grid Grid.Row="2" Margin="0,6,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding IpAddress}"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding MacAddress}"
                               FontSize="10"
                               Foreground="{StaticResource Brush.Text.Muted}" />
                    <!-- Decoder output format from the display's EDID (multiview only) -->
                    <TextBlock Text="{Binding CanvasInfo, Mode=OneWay}"
                               ToolTip="{Binding CanvasInfo, Mode=OneWay}"
                               FontSize="9"
                               Foreground="{StaticResource Brush.Accent.Primary}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="260" />
                </StackPanel>

                <!-- Active Source Label / Status -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock FontSize="10" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Right">
                        <Run Text="SOURCE: " />
                        <Run Text="{Binding SourceLabel, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Secondary}" FontWeight="Medium" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Card Action & Drop Hint Row -->
            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Turn Off / Disconnect Button -->
                <Button Grid.Column="0"
                        Command="{Binding UnrouteCommand}"
                        ToolTip="Turn off display feed / Unroute video"
                        Background="#26EF4444"
                        Foreground="#EF4444"
                        BorderBrush="#4DEF4444"
                        BorderThickness="1"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Padding="8,3"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏻" FontSize="10" Margin="0,0,4,0" />
                        <TextBlock Text="Turn Off" />
                    </StackPanel>
                </Button>

                <!-- Drop Target / State Hint -->
                <Border Grid.Column="2"
                        Background="{StaticResource Brush.Surface.Elevated}"
                        CornerRadius="4"
                        Padding="6,3"
                        VerticalAlignment="Center">
                    <TextBlock FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Secondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="TARGET DISPLAY" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRouted}" Value="True">
                                        <Setter Property="Text" Value="DROP TO SWITCH" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
