<UserControl x:Class="AvasRoutingTool.Views.DisplayCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             MinWidth="{StaticResource Size.Card.Display.Min}"
             AllowDrop="True"
             DragEnter="Card_DragOver"
             DragOver="Card_DragOver"
             DragLeave="Card_DragLeave"
             Drop="Card_Drop"
             PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
             PreviewMouseMove="Card_PreviewMouseMove"
             PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp"
             MouseLeftButtonUp="Card_MouseLeftButtonUp"
             PreviewKeyDown="Card_PreviewKeyDown"
             KeyDown="Card_KeyDown"
             GotKeyboardFocus="Card_GotKeyboardFocus">

    <Grid>
        <ui:Card x:Name="CardFrame" Style="{StaticResource Style.Card.Display}">

            <!--
                Rows (nothing but the picture ever lies on the 16:9 video):
                0: Header (status dot, device name and copy-source tag, rename pencil, info badge, mode badge)
                1: Action bar (layout presets when wide, Layout, Copy layout, draft chip, Turn Off) - always visible
                2: Live video preview surface (16:9; only its own state overlays lie on it)
                3: Status and toast dock (SOURCE / output format / notices, or the Undo toast)
                The fixed rows are the Size.Card.Row.* tokens: GridSpec.DisplayCard.ChromeHeight is their sum + 26.
            -->
            <Grid x:Name="CardGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource Size.Card.RowLength.Header}" />
                    <RowDefinition Height="{StaticResource Size.Card.RowLength.ActionBar}" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="{StaticResource Size.Card.RowLength.Dock}" />
                </Grid.RowDefinitions>

                <!-- Card header: name and copy-source tag, rename pencil, network info badge and mode badge.
                     Panel.ZIndex 1: the pencil's 48 px box reaches 12 px into the action bar below, and its whole box takes the press. -->
                <Grid Grid.Row="0" Panel.ZIndex="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status indicator dot -->
                    <Ellipse Grid.Column="0"
                             Style="{StaticResource Style.StatusDot.Small}"
                             Tag="{Binding IsActive, Mode=OneWay}"
                             Margin="0,0,8,0" />

                    <!--
                        The name's cell: the copy-source tag (when this display is the copy source) and the name, which takes what is left.
                        On the narrowest card (Size.Card.Display.Min) the pencil, the info badge and the mode badge leave little room: the tag, then the name,
                        give way (both ellipsize; the name's tooltip has the full name) so that the mode badge is never pushed out of the card.
                    -->
                    <DockPanel Grid.Column="1">
                        <!-- This display is the copy source (armed by a tap, or being dragged): the tag lies outside the picture -->
                        <Border x:Name="CopySourceChip"
                                DockPanel.Dock="Right"
                                Margin="{StaticResource Size.Space.Action.Before}"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Border.DropTarget}"
                                CornerRadius="4"
                                Padding="8,2"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsCopySource, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                            <TextBlock Text="COPYING FROM HERE" Style="{StaticResource Style.Text.Caption}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnDropTarget}" TextTrimming="WordEllipsis" />
                        </Border>

                        <!-- Strict BAVM Device Name -->
                        <TextBlock x:Name="DeviceNameText"
                                   Text="{Binding DeviceName, Mode=OneWay}"
                                   ToolTip="{Binding DeviceName, Mode=OneWay}"
                                   Style="{StaticResource Style.Text.Title}"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                    </DockPanel>

                    <!-- Rename pencil: icon only, a real button (a press on it is not a tap on the card).
                         The box is 48 x 48 (Size.Touch.Min) in a header row that is only 24 high (Size.Card.Row.Header): Margin -12 above and below keeps the
                         row's footprint, and so the card's chrome height, exactly what it was (the same hit-area technique as the tile's info badge).
                         It sits between the name and the info badge, clear of the badges. -->
                    <Button x:Name="RenamePencil"
                            Grid.Column="2"
                            Style="{StaticResource Style.Button.IconPencil}"
                            Command="{Binding RenameCommand, Mode=OneWay}"
                            AutomationProperties.Name="{Binding RenameAutomationName, Mode=OneWay}"
                            ToolTip="{Binding RenameToolTip, Mode=OneWay}"
                            IsTabStop="True"
                            Margin="0,-12,2,-12"
                            VerticalAlignment="Center">
                        <controls:MaterialIcon Kind="edit" Width="{StaticResource Size.Icon.Layout}" Height="{StaticResource Size.Icon.Layout}" />
                    </Button>

                    <!-- Network telemetry (IP, MAC) lives in this badge's tooltip, reachable by keyboard -->
                    <Border x:Name="DeviceInfoBadge"
                            Grid.Column="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Focusable="True"
                            KeyboardNavigation.IsTabStop="True"
                            FocusVisualStyle="{StaticResource Style.FocusVisual.Ring}"
                            AutomationProperties.Name="Device network telemetry: IP, MAC"
                            Background="Transparent"
                            Padding="2,0"
                            Cursor="Help">
                        <Border.ToolTip>
                            <TextBlock>
                                <Run Text="IP: " /><Run Text="{Binding IpAddress, Mode=OneWay}" /><Run Text=" &#183; MAC: " /><Run Text="{Binding MacAddress, Mode=OneWay}" />
                            </TextBlock>
                        </Border.ToolTip>
                        <controls:MaterialIcon Kind="info"
                                               Width="{StaticResource Size.Icon.Layout}"
                                               Height="{StaticResource Size.Icon.Layout}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </Border>

                    <!-- Mode tag: the layout and its fill ("MATRIX 2X2 &#183; 3/4"); neutral, the picture and the card say routed -->
                    <ui:Badge x:Name="ModeBadge"
                              Grid.Column="4"
                              Margin="{StaticResource Size.Space.Action.Before}"
                              Style="{StaticResource Style.Badge.Neutral}">
                        <TextBlock x:Name="ModeBadgeText" Text="{Binding ModeBadge, Mode=OneWay}" />
                    </ui:Badge>
                </Grid>

                <!--
                    Action bar (Row 1): always visible, never on the picture. Hosts Layout, Copy layout, the draft chip and Turn Off.
                -->
                <Border x:Name="FloatingActionDock"
                        Grid.Row="1"
                        MinHeight="{StaticResource Size.Touch.Min}"
                        Margin="0"
                        Background="Transparent"
                        IsHitTestVisible="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            More layouts: a ghost action-bar button (Style.Button.ActionBar) in column 0: [grid icon] label [chevron]. No fill and no outline;
                            it looks like Copy layout beside it. Its menu holds every layout and marks the one on screen.
                        -->
                        <Button x:Name="LayoutButton"
                                Grid.Column="0"
                                Style="{StaticResource Style.Button.ActionBar}"
                                AutomationProperties.Name="{Binding DeviceName, Mode=OneWay, StringFormat='More layouts for {0}'}"
                                ToolTip="More layouts"
                                PreviewKeyDown="LayoutButton_PreviewKeyDown"
                                PreviewMouseLeftButtonDown="LayoutButton_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="LayoutButton_PreviewMouseLeftButtonUp"
                                Click="LayoutButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:MaterialIcon x:Name="LayoutIcon"
                                                       Kind="grid_view"
                                                       Width="{StaticResource Size.Icon.Layout}"
                                                       Height="{StaticResource Size.Icon.Layout}"
                                                       VerticalAlignment="Center" />
                                <TextBlock x:Name="LayoutLabel" Text="More layouts" Style="{StaticResource Style.Text.ActionBar.LayoutLabel}" />
                                <controls:MaterialIcon x:Name="LayoutChevron"
                                                       Kind="expand_more"
                                                       Width="{StaticResource Size.Icon.Layout}"
                                                       Height="{StaticResource Size.Icon.Layout}"
                                                       VerticalAlignment="Center"
                                                       Margin="{StaticResource Size.Space.Action.Before}" />
                            </StackPanel>
                        </Button>

                        <!-- Copy layout: the same ghost style as More layouts, Size.Space.Action to its right; its full label always shows (no trimming) -->
                        <Button x:Name="CopyLayoutHandle"
                                Grid.Column="1"
                                Style="{StaticResource Style.Button.ActionBar.Copy}"
                                Margin="{StaticResource Size.Space.Action.Before}"
                                AutomationProperties.Name="{Binding CopyHandleAutomationName, Mode=OneWay}"
                                AutomationProperties.HelpText="{Binding CopyFromBlockedText, Mode=OneWay}"
                                ToolTip="{Binding CopyHandleToolTip, Mode=OneWay}"
                                Click="CopyHandle_Click"
                                PreviewMouseLeftButtonDown="CopyHandle_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="CopyHandle_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="CopyHandle_PreviewMouseLeftButtonUp">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:MaterialIcon x:Name="CopyIcon"
                                                       Kind="content_copy"
                                                       Width="{StaticResource Size.Icon.Layout}"
                                                       Height="{StaticResource Size.Icon.Layout}"
                                                       VerticalAlignment="Center" />
                                <TextBlock Text="Copy layout" VerticalAlignment="Center" Margin="{StaticResource Size.Space.Action.Before}" />
                            </StackPanel>
                        </Button>

                        <!--
                            Draft chip: Composer changes that are not on screen; a tap resumes them (spec 5.1, 15).
                            Placed in the action bar, keeps touch height >= 48.
                        -->
                        <Button x:Name="DraftChip"
                                Grid.Column="2"
                                Style="{StaticResource Style.Button.ActionBar.Staged}"
                                Margin="{StaticResource Size.Space.Action.Before}"
                                AutomationProperties.Name="{Binding DeviceName, Mode=OneWay, StringFormat='Resume draft for {0}, not on screen'}"
                                ToolTip="DRAFT - not on screen. Tap to resume it in the Composer."
                                Visibility="{Binding HasDraft, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}"
                                Click="DraftChip_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:MaterialIcon Kind="play_arrow"
                                                       Width="{StaticResource Size.Icon.Layout}"
                                                       Height="{StaticResource Size.Icon.Layout}"
                                                       VerticalAlignment="Center" />
                                <TextBlock x:Name="DraftChipLabel"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource Size.Space.Action.Before}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"><Run Text="DRAFT" /><Run x:Name="DraftChipResume" Text=" &#183; Resume" /></TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Quick Power / Turn Off Button: a vector power icon, an action-bar ghost button (no red at rest) -->
                        <Button x:Name="TurnOffButton"
                                Grid.Column="4"
                                Style="{StaticResource Style.Button.ActionBar}"
                                VerticalAlignment="Center"
                                MinWidth="{StaticResource Size.Touch.Min}"
                                Command="{Binding UnrouteCommand, Mode=OneWay}"
                                ToolTip="Turn off display feed / Unroute video"
                                AutomationProperties.Name="{Binding DeviceName, Mode=OneWay, StringFormat='Turn off {0}'}"
                                Visibility="{Binding IsRouted, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                            <controls:MaterialIcon Kind="power_settings_new" Width="{StaticResource Size.Icon.Layout}" Height="{StaticResource Size.Icon.Layout}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!--
                    Live Video Preview Surface (Row 2).
                    Takes all remaining vertical height.
                    On a MultiView card a tap (or Enter when focused) opens the Composer on
                    what is on screen (MainViewModel.TapPictureAsync, spec 5.1); otherwise it is a tap on the card.
                -->
                <Border x:Name="PreviewSurface"
                        Grid.Row="2"
                        Focusable="True"
                        FocusVisualStyle="{x:Null}"
                        KeyDown="PreviewSurface_KeyDown"
                        AutomationProperties.Name="{Binding PictureAutomationName, Mode=OneWay}"
                        Background="{DynamicResource Brush.Surface.PreviewBackdrop}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="6"
                        ClipToBounds="True">
                  <Grid>
                    <!-- Multiview: one drop zone + mirrored preview per window. Not virtualized: every window mirrors a live preview. -->
                    <ItemsControl ItemsSource="{Binding Slots, Mode=OneWay}"
                                  Focusable="False"
                                  ItemContainerStyle="{StaticResource Style.Slot.Fractional}"
                                  Visibility="{Binding IsMultiView, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:FractionalLayoutPanel
                                    AspectRatio="{Binding DataContext.CanvasAspect, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Style.Slot.Tile}"
                                        AllowDrop="True"
                                        DragEnter="Slot_DragOver"
                                        DragOver="Slot_DragOver"
                                        DragLeave="Slot_DragLeave"
                                        Drop="Slot_Drop">
                                    <Grid>
                                        <Image Source="{Binding PreviewBitmap, Mode=OneWay}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="LowQuality" />

                                        <!-- Source tag -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="4"
                                                Background="{DynamicResource Brush.Surface.Scrim}"
                                                BorderBrush="{DynamicResource Brush.Border.Scrim}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="4,1"
                                                Visibility="{Binding IsAssigned, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                                            <TextBlock Text="{Binding SourceName, Mode=OneWay}"
                                                       Style="{StaticResource Style.Text.Caption}"
                                                       Foreground="{DynamicResource Brush.Text.OnScrim}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>

                                        <!-- Assigned but no preview (non-AVAS source) -->
                                        <TextBlock Text="Preview not available"
                                                   Style="{StaticResource Style.Text.Caption}"
                                                   Foreground="{DynamicResource Brush.Text.OnPreviewMuted}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ShowPreviewUnavailable, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}" />

                                        <!-- Empty window hint -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding IsAssigned, Mode=OneWay, Converter={StaticResource Converter.Visible.False}}">
                                            <TextBlock Text="{Binding Label, Mode=OneWay}"
                                                       Style="{StaticResource Style.Text.Title}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Text.OnPreviewMuted}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Drop source"
                                                       Style="{StaticResource Style.Text.Caption}"
                                                       Foreground="{DynamicResource Brush.Text.OnPreviewMuted}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Single View surface (hidden while a multiview layout is active) -->
                    <Grid Visibility="{Binding ShowSingleViewPicture, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                        <!-- Actual Mirrored Video Image -->
                        <Image Source="{Binding PreviewBitmap, Mode=OneWay}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="LowQuality" />

                        <!-- Active Source overlay tag (visible when video is playing, docked bottom-left) -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="8,0,0,8"
                                Background="{DynamicResource Brush.Surface.Scrim}"
                                BorderBrush="{DynamicResource Brush.Border.Scrim}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                Visibility="{Binding ShowActiveSourceTag, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Style.StatusDot.Small}" Fill="{DynamicResource Brush.Status.Online}" Margin="0,0,6,0" />
                                <TextBlock x:Name="ActiveSourceTagText"
                                           Text="{Binding ActiveSourceName, Mode=OneWay}"
                                           Style="{StaticResource Style.Text.Caption}"
                                           Foreground="{DynamicResource Brush.Text.OnScrim}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Routed to Non-AVAS Device Overlay (No preview stream available) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding ShowRoutedNonAvasNotice, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                            <controls:MaterialIcon Kind="desktop_windows" Style="{StaticResource Style.Icon.State}" />
                            <TextBlock Text="Routed to Source"
                                       Style="{StaticResource Style.Text.Caption}"
                                       Foreground="{DynamicResource Brush.Text.OnPreviewMuted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,2" />
                            <TextBlock x:Name="RoutedSourceNameText"
                                       Text="{Binding ActiveSourceName, Mode=OneWay}"
                                       Style="{StaticResource Style.Text.Body}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.OnPreview}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Preview Not Available (Non-AVAS Device)"
                                       Style="{StaticResource Style.Text.Caption}"
                                       Foreground="{DynamicResource Brush.Text.OnPreviewMuted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Decoder runs a multiview layout set elsewhere (found when restoring state): read-only notice -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="{StaticResource Size.Notice.Max}" Margin="12"
                                    ToolTip="{Binding ExternalLayoutName, Mode=OneWay}"
                                    Visibility="{Binding IsExternalLayout, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                            <controls:MaterialIcon Kind="desktop_windows" Style="{StaticResource Style.Icon.State}" />
                            <TextBlock Text="{Binding ExternalLayoutText, Mode=OneWay}"
                                       Style="{StaticResource Style.Text.Caption}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="Drop a source to switch this display to Single View"
                                       Style="{StaticResource Style.Text.Caption}"
                                       Foreground="{DynamicResource Brush.Text.OnPreviewMuted}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Unrouted: the empty tile (critique M7) - the brand mark, one line of what to do, one hint, inside a dashed neutral frame. Cyan stays on the drop ring. -->
                        <Grid x:Name="UnroutedPlaceholder"
                              Visibility="{Binding ShowUnroutedPlaceholder, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                            <Rectangle x:Name="EmptyFrame" Style="{StaticResource Style.Shape.EmptyFrame}" />

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <views:BrandMark Width="{StaticResource Size.Brand.Empty}"
                                                 Height="{StaticResource Size.Brand.Empty}"
                                                 Opacity="0.6"
                                                 HorizontalAlignment="Center" />

                                <TextBlock x:Name="ReadyToRouteText"
                                           Text="Ready to route a source"
                                           Style="{StaticResource Style.Text.Title}"
                                           Foreground="{DynamicResource Brush.Text.OnPreview}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                                <TextBlock x:Name="ReadyToRouteHint"
                                           Text="Pick a source above, then tap here or drag it in."
                                           Style="{StaticResource Style.Text.Caption}"
                                           Foreground="{DynamicResource Brush.Text.OnPreviewMuted}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Why the last layout / multiview action was refused (above both surfaces) -->
                    <Border x:Name="ErrorBanner"
                            VerticalAlignment="Bottom"
                            Margin="6"
                            Background="{DynamicResource Brush.Surface.ScrimDanger}"
                            BorderBrush="{DynamicResource Brush.Border.Danger}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,3"
                            Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                        <TextBlock x:Name="ErrorBannerText"
                                   AutomationProperties.LiveSetting="Assertive"
                                   Text="{Binding LastError, Mode=OneWay}"
                                   Style="{StaticResource Style.Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.OnScrimDanger}"
                                   TextWrapping="Wrap" />
                    </Border>

                  </Grid>
                </Border>

                <!--
                    Status dock (Row 3): line 1 the source (or the idle line) and the output format; line 2 the stale-draft notice.
                    The Undo toast takes this row while it shows - never the picture.
                -->
                <Grid Grid.Row="3" Margin="0,8,0,0" Height="{StaticResource Size.Dock.Content}"
                      Visibility="{Binding ShowUndoToast, Mode=OneWay, Converter={StaticResource Converter.Visible.False}}">
                    <StackPanel VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Source footer: "SOURCE: <name>" once routed; empty while idle (the empty tile says "Ready to route a source" once) -->
                            <TextBlock x:Name="SourceFooter" Grid.Column="0"
                                       Text="{Binding SourceFooterText, Mode=OneWay}"
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Decoder output format from the display's EDID (multiview and Single View); the SOURCE line above keeps the row's height -->
                            <TextBlock x:Name="OutputLine" Grid.Column="1"
                                       Text="{Binding CanvasInfoShort, Mode=OneWay}"
                                       ToolTip="{Binding CanvasInfo, Mode=OneWay}"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Accent}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding CanvasInfo, Mode=OneWay, Converter={StaticResource Converter.Visible.NotEmpty}}" />
                        </Grid>

                        <!-- A copy replaced the screen the kept draft was made on; the copy tag takes its place while this display is the copy source -->
                        <TextBlock x:Name="DraftNoticeLine"
                                   Text="{Binding DraftNotice, Mode=OneWay}"
                                   ToolTip="{Binding DraftNotice, Mode=OneWay}"
                                   Style="{StaticResource Style.Text.Caption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Status.StagedText}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ShowDraftNotice, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}" />
                    </StackPanel>
                </Grid>

                <!--
                    Card body overlays, above the live picture and exactly its size: the drop choice
                    and the copy target states. Always words, never colour alone.
                -->

                <!-- A source dropped / tapped on a MultiView card: it asks; nothing is replaced silently -->
                <Border x:Name="DropChoicePanel"
                        Grid.Row="2"
                        Style="{StaticResource Style.Overlay.Body}"
                        Background="{DynamicResource Brush.Surface.Overlay}"
                        BorderBrush="{DynamicResource Brush.Border.DropTarget}"
                        BorderThickness="1"
                        Visibility="{Binding IsDropChoiceOpen, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                    <StackPanel x:Name="DropChoiceContent" VerticalAlignment="Center" Margin="10,8">
                        <TextBlock x:Name="DropChoiceTitle"
                                   Text="{Binding DropChoiceSource.DeviceName, Mode=OneWay, StringFormat='Where should {0} go?'}"
                                   Style="{StaticResource Style.Text.Lead}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button x:Name="FullScreenButton"
                                    Style="{StaticResource Style.Button.Composer}"
                                    Background="{DynamicResource Brush.Action.Take}"
                                    BorderBrush="{DynamicResource Brush.Action.Take}"
                                    Foreground="{DynamicResource Brush.Text.OnAction}"
                                    Padding="8,6"
                                    Margin="0,0,5,0"
                                    AutomationProperties.Name="{Binding FullScreenAutomationName, Mode=OneWay}"
                                    Click="FullScreen_Click">
                                <TextBlock Text="Full screen (Single View)" TextWrapping="Wrap" TextAlignment="Center" />
                            </Button>
                            <Button x:Name="IntoBlockButton"
                                    Style="{StaticResource Style.Button.Composer}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource Brush.Border.DropTarget}"
                                    Foreground="{DynamicResource Brush.Text.CopyAccent}"
                                    Padding="8,6"
                                    Margin="5,0,0,0"
                                    AutomationProperties.Name="{Binding IntoBlockAutomationName, Mode=OneWay}"
                                    Click="IntoBlock_Click">
                                <TextBlock Text="Into a block…" TextWrapping="Wrap" TextAlignment="Center" />
                            </Button>
                        </UniformGrid>
                        <TextBlock Text="Full screen goes on screen now. Into a block opens the Composer."
                                   Style="{StaticResource Style.Text.Caption}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Copy target, allowed: "Release to copy here" + what will be copied (the view model's text) -->
                <Border x:Name="CopyTargetAllowedPanel"
                        Grid.Row="2"
                        Style="{StaticResource Style.Overlay.Body}"
                        Background="{DynamicResource Brush.Surface.CopyTarget}"
                        Visibility="{Binding IsCopyTargetAllowed, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                    <StackPanel x:Name="CopyTargetAllowedContent" VerticalAlignment="Top" Margin="12,14,12,8">
                        <TextBlock Text="Release to copy here"
                                   Style="{StaticResource Style.Text.Lead}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.CopyAccent}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="CopyTargetAllowedText"
                                   Text="{Binding CopyTargetText, Mode=OneWay}"
                                   Style="{StaticResource Style.Text.Title}"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource Brush.Text.OnCopyTarget}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Copy target, blocked: lock + the reason; no ring -->
                <Border x:Name="CopyTargetBlockedPanel"
                        Grid.Row="2"
                        Style="{StaticResource Style.Overlay.Body}"
                        Background="{DynamicResource Brush.Surface.Overlay}"
                        Visibility="{Binding IsCopyTargetBlocked, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                    <StackPanel x:Name="CopyTargetBlockedContent" VerticalAlignment="Top" Margin="12,14,12,8">
                        <controls:MaterialIcon x:Name="CopyTargetLock"
                                               Kind="lock"
                                               Width="{StaticResource Size.Icon.L}"
                                               Height="{StaticResource Size.Icon.L}"
                                               Foreground="{DynamicResource Brush.Text.OnOverlay}"
                                               HorizontalAlignment="Center" />
                        <TextBlock x:Name="CopyTargetBlockedText"
                                   Text="{Binding CopyTargetText, Mode=OneWay}"
                                   Style="{StaticResource Style.Text.Title}"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource Brush.Text.OnOverlay}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- After a copy onto this display: what it shows now, and Undo for 10 s (in the status dock, below the picture, never on it) -->
                <Border x:Name="UndoToast"
                        Grid.Row="3"
                        MinHeight="{StaticResource Size.Toast.Min}"
                        VerticalAlignment="Stretch"
                        Margin="0,4,0,0"
                        Background="{DynamicResource Brush.Surface.UndoToast}"
                        BorderBrush="{DynamicResource Brush.Status.Online}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="10,0,0,0"
                        Visibility="{Binding ShowUndoToast, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                    <DockPanel>
                        <Button x:Name="UndoScreenButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Style.Button.Composer}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Status.Online}"
                                Foreground="{DynamicResource Brush.Text.UndoToast}"
                                Content="Undo"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Undo the copy"
                                Click="UndoScreen_Click" />
                        <TextBlock x:Name="UndoToastLabel"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding UndoToastText, Mode=OneWay}"
                                   Style="{StaticResource Style.Text.Title}"
                                   Foreground="{DynamicResource Brush.Text.UndoToast}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!--
                    Keyboard focus on the picture: a 2 px ring over the picture and over any state panel lying on it. It is drawn
                    here rather than as a focus adorner so it also renders (and so a copy target reads as focused).
                -->
                <Border x:Name="PictureFocusRing"
                        Grid.Row="2"
                        BorderBrush="{DynamicResource Brush.Focus.Ring}"
                        BorderThickness="2"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Visibility="{Binding (views:InputModality.ShowsFocus), ElementName=PreviewSurface, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}" />
            </Grid>
        </ui:Card>

        <!-- Copy target, allowed: a cyan ring around the card (an overlay, so nothing moves) -->
        <Border x:Name="CopyTargetRing"
                Style="{StaticResource Style.Ring.Armed}"
                Visibility="{Binding IsCopyTargetAllowed, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}" />

        <!-- The header's Layout menu: six schematic tiles (the layout on screen marked) -->
        <Popup x:Name="LayoutMenuPopup"
               PlacementTarget="{Binding ElementName=LayoutButton}"
               Placement="Custom"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsLayoutMenuOpen, Mode=TwoWay}"
               Opened="LayoutMenu_Opened"
               Closed="LayoutMenu_Closed">
            <Border x:Name="LayoutMenuFrame"
                    Width="{StaticResource Size.Popup.LayoutMenu}"
                    Background="{DynamicResource Brush.Surface.Popup}"
                    BorderBrush="{DynamicResource Brush.Border.Control}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    PreviewKeyDown="LayoutMenuFrame_PreviewKeyDown">
                <StackPanel>
                    <TextBlock Text="{Binding DeviceName, Mode=OneWay, StringFormat='Layout for {0}'}"
                               Style="{StaticResource Style.Text.Title}"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="A MultiView layout opens the Composer: nothing changes on screen until Save &amp; Apply. Single View and Off apply now."
                               Style="{StaticResource Style.Text.Body}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,6" />
                    <ItemsControl x:Name="LayoutMenuItems" ItemsSource="{Binding LayoutMenu, Mode=OneWay}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="LayoutMenuTile"
                                        Style="{StaticResource Style.Button.LayoutMenuTile}"
                                        AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                                        ToolTip="{Binding Subtitle, Mode=OneWay}"
                                        Click="LayoutChoice_Click">
                                    <StackPanel>
                                        <views:LayoutSchematic LayoutId="{Binding Id, Mode=OneWay}"
                                                               Width="{StaticResource Size.Schematic.Menu.Width}"
                                                               Height="{StaticResource Size.Schematic.Menu.Height}"
                                                               HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LayoutMenuTitle"
                                                   Text="{Binding Title, Mode=OneWay}"
                                                   Style="{StaticResource Style.Text.Title}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <!-- The layout on screen, in words and an icon (an unrouted display shows nothing, so nothing is marked) -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    Visibility="{Binding IsOnScreen, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                                            <controls:MaterialIcon Kind="check" Width="{StaticResource Size.Icon.S}" Height="{StaticResource Size.Icon.S}" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Brush.Text.Accent}" />
                                            <TextBlock Text="On screen"
                                                       Style="{StaticResource Style.Text.Caption}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Text.Accent}"
                                                       Margin="4,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>

        <!-- The drag ghost is a CopyGhostAdorner in the window's adorner layer (code-behind), never a separate window -->
    </Grid>
</UserControl>
