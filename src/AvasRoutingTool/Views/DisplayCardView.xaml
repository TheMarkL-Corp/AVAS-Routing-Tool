<UserControl x:Class="AvasRoutingTool.Views.DisplayCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             MinWidth="320"
             AllowDrop="True"
             DragEnter="Card_DragOver"
             DragOver="Card_DragOver"
             DragLeave="Card_DragLeave"
             Drop="Card_Drop"
             PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
             PreviewMouseMove="Card_PreviewMouseMove"
             PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp"
             MouseLeftButtonUp="Card_MouseLeftButtonUp"
             PreviewKeyDown="Card_PreviewKeyDown"
             KeyDown="Card_KeyDown"
             PreviewTouchDown="Card_PreviewTouchDown">

    <UserControl.Resources>
        <!-- A dark panel over the card body that states a choice or a copy target state in words -->
        <Style x:Key="BodyOverlay" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="CardFrame"
                Background="{DynamicResource Brush.Surface.Card}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDragOver, Mode=OneWay}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRouted, Mode=OneWay}" Value="True" />
                                <Condition Binding="{Binding IsDragOver, Mode=OneWay}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Routed}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <!--
                Rows:
                0: Header (Status dot, device name, draft chip when staged, mode badge)
                1: Live video preview surface (occupies all remaining vertical height; hosts floating action strip)
                2: Telemetry info (IP, MAC, SOURCE, Canvas EDID info)
            -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card header: name and mode badge -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status indicator dot -->
                    <Ellipse Grid.Column="0"
                             Width="8" Height="8"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Offline}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Status.Online}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Strict BAVM Device Name -->
                    <TextBlock x:Name="DeviceNameText"
                               Grid.Column="1"
                               Text="{Binding DeviceName, Mode=OneWay}"
                               ToolTip="{Binding DeviceName, Mode=OneWay}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <!-- Routed status pill: the layout and its fill ("MATRIX 2X2 · 3/4") -->
                    <Border Grid.Column="2"
                            VerticalAlignment="Center"
                            CornerRadius="4"
                            Padding="6,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.Border.Default}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRouted, Mode=OneWay}" Value="True">
                                        <Setter Property="Background" Value="#263B82F6" />
                                        <Setter Property="BorderBrush" Value="#4D3B82F6" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMultiView, Mode=OneWay}" Value="True">
                                        <Setter Property="Background" Value="#263B82F6" />
                                        <Setter Property="BorderBrush" Value="#4D3B82F6" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock x:Name="ModeBadgeText" Text="{Binding ModeBadge, Mode=OneWay}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRouted, Mode=OneWay}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMultiView, Mode=OneWay}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>

                <!--
                    Live Video Preview Surface (Row 1).
                    Takes all remaining vertical height.
                    On a MultiView card a tap (or Enter when focused) opens the Composer on
                    what is on screen (MainViewModel.TapPictureAsync, spec 5.1); otherwise it is a tap on the card.
                -->
                <Border x:Name="PreviewSurface"
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        Focusable="True"
                        FocusVisualStyle="{x:Null}"
                        KeyDown="PreviewSurface_KeyDown"
                        AutomationProperties.Name="{Binding PictureAutomationName, Mode=OneWay}"
                        Background="#070A0F"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="6"
                        ClipToBounds="True">
                  <Grid>
                    <!-- Multiview: one drop zone + mirrored preview per window -->
                    <ItemsControl ItemsSource="{Binding Slots, Mode=OneWay}" Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMultiView, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:FractionalLayoutPanel
                                    AspectRatio="{Binding DataContext.CanvasAspect, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="controls:FractionalLayoutPanel.X" Value="{Binding NormalizedX, Mode=OneWay}" />
                                <Setter Property="controls:FractionalLayoutPanel.Y" Value="{Binding NormalizedY, Mode=OneWay}" />
                                <Setter Property="controls:FractionalLayoutPanel.W" Value="{Binding NormalizedWidth, Mode=OneWay}" />
                                <Setter Property="controls:FractionalLayoutPanel.H" Value="{Binding NormalizedHeight, Mode=OneWay}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="1"
                                        Background="#0B0F17"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        ClipToBounds="True"
                                        AllowDrop="True"
                                        DragEnter="Slot_DragOver"
                                        DragOver="Slot_DragOver"
                                        DragLeave="Slot_DragLeave"
                                        Drop="Slot_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAssigned, Mode=OneWay}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Routed}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDragOver, Mode=OneWay}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Image Source="{Binding PreviewBitmap, Mode=OneWay}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="LowQuality" />

                                        <!-- Source tag -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="4"
                                                Background="#D90B0F17"
                                                BorderBrush="#33FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="4,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAssigned, Mode=OneWay}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SourceName, Mode=OneWay}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>

                                        <!-- Assigned but no preview (non-AVAS source) -->
                                        <TextBlock Text="Preview not available"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsAssigned, Mode=OneWay}" Value="True" />
                                                                <Condition Binding="{Binding IsPreviewSupported, Mode=OneWay}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Empty window hint -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAssigned, Mode=OneWay}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding Label, Mode=OneWay}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                       HorizontalAlignment="Center"
                                                       Opacity="0.6" />
                                            <TextBlock Text="Drop source"
                                                       FontSize="9"
                                                       Foreground="#475569"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Single View surface (hidden while a multiview layout is active) -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMultiView, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- Actual Mirrored Video Image -->
                        <Image Source="{Binding PreviewBitmap, Mode=OneWay}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="LowQuality" />

                        <!-- Active Source overlay tag (visible when video is playing, docked bottom-left) -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="8,0,0,8"
                                Background="#D90B0F17"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsRouted, Mode=OneWay}" Value="True" />
                                                <Condition Binding="{Binding IsPreviewSupported, Mode=OneWay}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="● " Foreground="#10B981" FontSize="9" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveSourceName, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Routed to Non-AVAS Device Overlay (No preview stream available) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsRouted, Mode=OneWay}" Value="True" />
                                                <Condition Binding="{Binding IsPreviewSupported, Mode=OneWay}" Value="False" />
                                                <Condition Binding="{Binding IsExternalLayout, Mode=OneWay}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource Icon.Monitor}"
                                  Fill="{DynamicResource Brush.Accent.Primary}"
                                  Width="26" Height="26"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="Routed to Source"
                                       FontSize="10"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,2" />
                            <TextBlock Text="{Binding ActiveSourceName, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Preview Not Available (Non-AVAS Device)"
                                       FontSize="10"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Decoder runs a multiview layout set elsewhere (found when restoring state): read-only notice -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320" Margin="12"
                                    ToolTip="{Binding ExternalLayoutName, Mode=OneWay}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExternalLayout, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource Icon.Monitor}"
                                  Fill="{DynamicResource Brush.Accent.Primary}"
                                  Width="26" Height="26"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ExternalLayoutText, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="Drop a source to switch this display to Single View"
                                       FontSize="9"
                                       Foreground="#475569"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Unrouted / Drop Target Placeholder -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRouted, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Path Data="{StaticResource Icon.Monitor}"
                                  Fill="{DynamicResource Brush.Text.Muted}"
                                  Width="28" Height="28"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Opacity="0.35" />

                            <TextBlock Text="Drop Source Here to Route"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="Drag any TX card above or 'Off' to turn off"
                                       FontSize="9"
                                       Foreground="#475569"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Why the last layout / multiview action was refused (above both surfaces) -->
                    <Border x:Name="ErrorBanner"
                            VerticalAlignment="Bottom"
                            Margin="6"
                            Background="#E61F0A0A"
                            BorderBrush="#4DEF4444"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="ErrorBannerText"
                                   AutomationProperties.LiveSetting="Assertive"
                                   Text="{Binding LastError, Mode=OneWay}"
                                   Foreground="#FCA5A5"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!--
                        Progressive Disclosure: Auto-hiding Floating Action Dock on the video surface.
                        Hosts Layout, Copy layout, Turn Off, and blocked reason.
                        Appears on hover, focus, touch tap, or when a menu/copy is active.
                    -->
                    <Border x:Name="FloatingActionDock"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            Margin="6"
                            Padding="6"
                            Background="{DynamicResource Brush.Surface.Overlay}"
                            BorderBrush="{DynamicResource Brush.Border.Control}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardFrame}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=CardFrame}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCopySource, Mode=OneWay}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLayoutMenuOpen, Mode=OneWay}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTouchRevealed, RelativeSource={RelativeSource AncestorType=views:DisplayCardView}}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasDraft, Mode=OneWay}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Layout ▾ Button -->
                            <Button x:Name="LayoutButton"
                                    Grid.Row="0" Grid.Column="0"
                                    MinHeight="56"
                                    AutomationProperties.Name="{Binding DeviceName, Mode=OneWay, StringFormat='Layout for {0}'}"
                                    ToolTip="Choose a layout for this display"
                                    PreviewKeyDown="LayoutButton_PreviewKeyDown"
                                    PreviewMouseLeftButtonDown="LayoutButton_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="LayoutButton_PreviewMouseLeftButtonUp"
                                    Click="LayoutButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Composer}">
                                        <Setter Property="Padding" Value="8,6" />
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path x:Name="LayoutIcon"
                                          Data="{StaticResource Icon.Grid}"
                                          Fill="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="Layout ▾" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Copy layout Button -->
                            <Button x:Name="CopyLayoutHandle"
                                    Grid.Row="0" Grid.Column="2"
                                    MinHeight="56"
                                    IsEnabled="{Binding CanCopyFrom, Mode=OneWay}"
                                    AutomationProperties.Name="{Binding CopyHandleAutomationName, Mode=OneWay}"
                                    ToolTip="Drag onto another display to copy this picture there - or tap, then tap a display"
                                    ToolTipService.ShowOnDisabled="True"
                                    Click="CopyHandle_Click"
                                    PreviewMouseLeftButtonDown="CopyHandle_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="CopyHandle_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="CopyHandle_PreviewMouseLeftButtonUp">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Composer}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.CopyTarget}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.CopyAccent}" />
                                        <Setter Property="Padding" Value="8,6" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCopySource, Mode=OneWay}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Border.DropTarget}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDropTarget}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path x:Name="CopyIcon"
                                          Data="{StaticResource Icon.Copy}"
                                          Stroke="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="Copy layout" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!--
                                Draft chip: Composer changes that are not on screen; a tap resumes them (spec 5.1, 15).
                                Placed in the action strip, keeps touch height >= 56.
                            -->
                            <Button x:Name="DraftChip"
                                    Grid.Row="0" Grid.Column="3"
                                    Margin="6,0,0,0"
                                    Width="84"
                                    MinHeight="56"
                                    Cursor="Hand"
                                    AutomationProperties.Name="{Binding DeviceName, Mode=OneWay, StringFormat='Resume draft for {0}, not on screen'}"
                                    ToolTip="DRAFT - not on screen. Tap to resume it in the Composer."
                                    Click="DraftChip_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDraft, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Rectangle x:Name="DraftFrame"
                                                       Fill="{DynamicResource Brush.Surface.Staged}"
                                                       Stroke="{DynamicResource Brush.Status.Staged}"
                                                       StrokeThickness="1.5"
                                                       StrokeDashArray="4 3"
                                                       RadiusX="8" RadiusY="8" />
                                            <ContentPresenter Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DraftFrame" Property="Fill" Value="{DynamicResource Brush.Surface.StagedHover}" />
                                            </Trigger>
                                            <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                                                <Setter TargetName="DraftFrame" Property="Stroke" Value="{DynamicResource Brush.Focus.Ring}" />
                                                <Setter TargetName="DraftFrame" Property="StrokeThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="DRAFT &#183; Resume"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource Brush.Status.StagedChipText}" />
                            </Button>

                            <!-- Quick Power / Turn Off Button -->
                            <Button x:Name="TurnOffButton"
                                    Grid.Row="0" Grid.Column="4"
                                    Margin="6,0,0,0"
                                    MinHeight="48"
                                    MinWidth="48"
                                    HorizontalAlignment="Center"
                                    Command="{Binding UnrouteCommand, Mode=OneWay}"
                                    ToolTip="Turn off display feed / Unroute video"
                                    FocusVisualStyle="{StaticResource Style.FocusVisual.Ring}"
                                    AutomationProperties.Name="{Binding DeviceName, Mode=OneWay, StringFormat='Turn off {0}'}"
                                    Background="#26EF4444"
                                    Foreground="#EF4444"
                                    BorderBrush="#4DEF4444"
                                    BorderThickness="1"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Padding="10,6"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRouted, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="⏻" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Off" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Why Copy layout is off, in words ("RX1 shows nothing to copy") -->
                            <TextBlock x:Name="CopyFromBlockedLabel"
                                       Grid.Row="1" Grid.ColumnSpan="5"
                                       Text="{Binding CopyFromBlockedText, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Right"
                                       Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanCopyFrom, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                  </Grid>
                </Border>

                <!--
                    Card Telemetry (Row 2): line 1 IP / MAC and SOURCE - or, while a kept draft is based on an older picture, that
                    notice (one line, outside the picture, same height); line 2 the output format (always reserved).
                -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DraftNotice, Mode=OneWay}" Value="{x:Null}" />
                                            <Condition Binding="{Binding IsCopySource, Mode=OneWay}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding IpAddress, Mode=OneWay}" />
                        <Run Text=" &#183; " Foreground="{DynamicResource Brush.Text.Muted}" />
                        <Run Text="{Binding MacAddress, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Muted}" />
                    </TextBlock>

                    <!-- Active Source Label / Status -->
                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,1,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DraftNotice, Mode=OneWay}" Value="{x:Null}" />
                                            <Condition Binding="{Binding IsCopySource, Mode=OneWay}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="SOURCE: " />
                        <Run Text="{Binding SourceLabel, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" FontWeight="Medium" />
                    </TextBlock>

                    <!-- A copy replaced the screen the kept draft was made on -->
                    <TextBlock x:Name="DraftNoticeLine"
                               Grid.Row="0" Grid.ColumnSpan="2"
                               Text="{Binding DraftNotice, Mode=OneWay}"
                               ToolTip="{Binding DraftNotice, Mode=OneWay}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Status.StagedText}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DraftNotice, Mode=OneWay}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <!-- The copy tag takes the line while this display is the copy source -->
                                    <DataTrigger Binding="{Binding IsCopySource, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- This display is the copy source (armed by a tap, or being dragged): the tag takes line 1, outside the picture -->
                    <Border x:Name="CopySourceChip"
                            Grid.Row="0" Grid.ColumnSpan="2"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Border.DropTarget}"
                            CornerRadius="4"
                            Padding="8,0"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCopySource, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="COPYING FROM HERE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnDropTarget}" />
                    </Border>

                    <!-- Decoder output format from the display's EDID (multiview only) -->
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                               Text="{Binding CanvasInfo, Mode=OneWay}"
                               ToolTip="{Binding CanvasInfo, Mode=OneWay}"
                               FontSize="10"
                               Foreground="{DynamicResource Brush.Text.Accent}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!-- Hidden, not collapsed: the line keeps its height so every card has the same chrome -->
                                    <DataTrigger Binding="{Binding CanvasInfo, Mode=OneWay}" Value="">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!--
                    Card body overlays (picture and telemetry rows), above the live picture: the drop choice
                    and the copy target states. Always words, never colour alone.
                -->

                <!-- A source dropped / tapped on a MultiView card: it asks; nothing is replaced silently -->
                <Border x:Name="DropChoicePanel"
                        Grid.Row="1" Grid.RowSpan="2"
                        Background="{DynamicResource Brush.Surface.Overlay}"
                        BorderBrush="{DynamicResource Brush.Border.DropTarget}"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BodyOverlay}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropChoiceOpen, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel x:Name="DropChoiceContent" VerticalAlignment="Center" Margin="10,8">
                        <TextBlock x:Name="DropChoiceTitle"
                                   Text="{Binding DropChoiceSource.DeviceName, Mode=OneWay, StringFormat='Where should {0} go?'}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button x:Name="FullScreenButton"
                                    Style="{StaticResource Style.Button.Composer}"
                                    Background="{DynamicResource Brush.Action.Take}"
                                    BorderBrush="{DynamicResource Brush.Action.Take}"
                                    Foreground="{DynamicResource Brush.Text.OnAction}"
                                    Padding="8,6"
                                    Margin="0,0,5,0"
                                    AutomationProperties.Name="{Binding FullScreenAutomationName, Mode=OneWay}"
                                    Click="FullScreen_Click">
                                <TextBlock Text="Full screen (Single View)" TextWrapping="Wrap" TextAlignment="Center" />
                            </Button>
                            <Button x:Name="IntoBlockButton"
                                    Style="{StaticResource Style.Button.Composer}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource Brush.Border.DropTarget}"
                                    Foreground="{DynamicResource Brush.Text.CopyAccent}"
                                    Padding="8,6"
                                    Margin="5,0,0,0"
                                    AutomationProperties.Name="{Binding IntoBlockAutomationName, Mode=OneWay}"
                                    Click="IntoBlock_Click">
                                <TextBlock Text="Into a block…" TextWrapping="Wrap" TextAlignment="Center" />
                            </Button>
                        </UniformGrid>
                        <TextBlock Text="Full screen goes on screen now. Into a block opens the Composer."
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Copy target, allowed: "Release to copy here" + what will be copied (the view model's text) -->
                <Border x:Name="CopyTargetAllowedPanel"
                        Grid.Row="1" Grid.RowSpan="2"
                        Background="{DynamicResource Brush.Surface.CopyTarget}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BodyOverlay}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCopyTargetAllowed, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel x:Name="CopyTargetAllowedContent" VerticalAlignment="Top" Margin="12,14,12,8">
                        <TextBlock Text="Release to copy here"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.CopyAccent}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="CopyTargetAllowedText"
                                   Text="{Binding CopyTargetText, Mode=OneWay}"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.Text.OnCopyTarget}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Copy target, blocked: lock + the reason; no ring -->
                <Border x:Name="CopyTargetBlockedPanel"
                        Grid.Row="1" Grid.RowSpan="2"
                        Background="{DynamicResource Brush.Surface.Overlay}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BodyOverlay}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCopyTargetBlocked, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel x:Name="CopyTargetBlockedContent" VerticalAlignment="Top" Margin="12,14,12,8">
                        <Path x:Name="CopyTargetLock"
                              Data="{StaticResource Icon.Lock}"
                              Stroke="{DynamicResource Brush.Text.OnOverlay}"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              Width="26" Height="26"
                              Stretch="Uniform"
                              HorizontalAlignment="Center" />
                        <TextBlock x:Name="CopyTargetBlockedText"
                                   Text="{Binding CopyTargetText, Mode=OneWay}"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.Text.OnOverlay}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- After a copy onto this display: what it shows now, and Undo for 10 s (on top: Undo stays reachable) -->
                <Border x:Name="UndoToast"
                        Grid.Row="1"
                        VerticalAlignment="Bottom"
                        Margin="6"
                        Background="{DynamicResource Brush.Surface.UndoToast}"
                        BorderBrush="{DynamicResource Brush.Status.Online}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="10,4,4,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <!--
                                    CanUndoScreen (not the command's CanExecute), and only while the card shows no drop
                                    choice and no copy-target state: those win, and the toast's Undo never lies over a
                                    choice button. It comes back when they go, while its 10 s last.
                                -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanUndoScreen, Mode=OneWay}" Value="True" />
                                        <Condition Binding="{Binding IsDropChoiceOpen, Mode=OneWay}" Value="False" />
                                        <Condition Binding="{Binding IsCopyTargetAllowed, Mode=OneWay}" Value="False" />
                                        <Condition Binding="{Binding IsCopyTargetBlocked, Mode=OneWay}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button x:Name="UndoScreenButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Style.Button.Composer}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Status.Online}"
                                Foreground="{DynamicResource Brush.Text.UndoToast}"
                                Content="Undo"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Undo the copy"
                                Click="UndoScreen_Click" />
                        <TextBlock x:Name="UndoToastLabel"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding UndoToastText, Mode=OneWay}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.UndoToast}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!--
                    Keyboard focus on the picture: a 2 px ring over the picture and over any state panel lying on it. It is drawn
                    here rather than as a focus adorner so it also renders (and so a copy target reads as focused).
                -->
                <Border x:Name="PictureFocusRing"
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        BorderBrush="{DynamicResource Brush.Focus.Ring}"
                        BorderThickness="2"
                        CornerRadius="6"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding (views:InputModality.ShowsFocus), ElementName=PreviewSurface, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Border>

        <!-- Copy target, allowed: a cyan ring around the card (an overlay, so nothing moves) -->
        <Border x:Name="CopyTargetRing"
                BorderBrush="{DynamicResource Brush.Border.DropTarget}"
                BorderThickness="3"
                CornerRadius="8"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCopyTargetAllowed, Mode=OneWay}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- The header's Layout menu: six schematic tiles (the layout on screen marked) -->
        <Popup x:Name="LayoutMenuPopup"
               PlacementTarget="{Binding ElementName=LayoutButton}"
               Placement="Custom"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsLayoutMenuOpen, Mode=TwoWay}"
               Opened="LayoutMenu_Opened"
               Closed="LayoutMenu_Closed">
            <Border x:Name="LayoutMenuFrame"
                    Width="336"
                    Background="{DynamicResource Brush.Surface.Popup}"
                    BorderBrush="{DynamicResource Brush.Border.Control}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    PreviewKeyDown="LayoutMenuFrame_PreviewKeyDown">
                <StackPanel>
                    <TextBlock Text="{Binding DeviceName, Mode=OneWay, StringFormat='Layout for {0}'}"
                               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="A MultiView layout opens the Composer: nothing changes on screen until Take. Single View and Off apply now."
                               FontSize="13"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,6" />
                    <ItemsControl x:Name="LayoutMenuItems" ItemsSource="{Binding LayoutMenu, Mode=OneWay}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="LayoutMenuTile"
                                        MinHeight="88"
                                        Margin="4"
                                        Foreground="{DynamicResource Brush.Text.Primary}"
                                        Cursor="Hand"
                                        AutomationProperties.Name="{Binding Title, Mode=OneWay}"
                                        ToolTip="{Binding Subtitle, Mode=OneWay}"
                                        Click="LayoutMenuTile_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd"
                                                    Background="{DynamicResource Brush.Surface.Card}"
                                                    BorderBrush="{DynamicResource Brush.Border.Control}"
                                                    BorderThickness="2"
                                                    CornerRadius="8"
                                                    Padding="8,6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Id, Mode=OneWay}" Value="off">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Danger}" />
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Danger}" />
                                                </DataTrigger>
                                                <!-- Selected only when the display shows it: an unrouted display marks no tile -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected, Mode=OneWay}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.IsRouted, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                                </MultiDataTrigger>
                                                <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <views:LayoutSchematic LayoutId="{Binding Id, Mode=OneWay}" Width="72" Height="40" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LayoutMenuTitle"
                                                   Text="{Binding Title, Mode=OneWay}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <!-- The layout on screen, in words (an unrouted display shows nothing, so nothing is marked) -->
                                        <TextBlock Text="✓ On screen"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Text.Accent}"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, Mode=OneWay}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.IsRouted, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>

        <!-- The drag ghost is a CopyGhostAdorner in the window's adorner layer (code-behind), never a separate window -->
    </Grid>
</UserControl>
