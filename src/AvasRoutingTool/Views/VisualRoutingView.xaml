<UserControl x:Class="AvasRoutingTool.Views.VisualRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             Background="{StaticResource Brush.Background.Dark}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="330" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="330" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP ROW: Sources (TX) Section -->
        <Border Grid.Row="0" Margin="16,12,16,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <Grid Grid.Row="0" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Video}"
                              Fill="{StaticResource Brush.Accent.Primary}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                        <TextBlock Text="VIDEO SOURCES (TX)"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Drag an active source card to any target display"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />

                    <Border Grid.Column="2"
                            Background="{StaticResource Brush.Surface.Elevated}"
                            CornerRadius="12"
                            Padding="8,3">
                        <TextBlock FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush.Text.Secondary}">
                            <Run Text="DISCOVERED: " />
                            <Run Text="{Binding Sources.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Sources Carousel / Horizontal List -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveCardPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:SourceCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Subtle Divider -->
        <Border Grid.Row="1" Height="1" Background="{StaticResource Brush.Border.Default}" Margin="16,4" />

        <!-- MIDDLE ROW: Displays (RX) Section -->
        <Border Grid.Row="2" Margin="16,6,16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <Grid Grid.Row="0" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Monitor}"
                              Fill="{StaticResource Brush.Accent.Primary}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                        <TextBlock Text="TARGET DISPLAYS (RX)"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Drop source into a display card to switch video feed"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />

                    <Border Grid.Column="2"
                            Background="{StaticResource Brush.Surface.Elevated}"
                            CornerRadius="12"
                            Padding="8,3">
                        <TextBlock FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush.Text.Secondary}">
                            <Run Text="DISCOVERED: " />
                            <Run Text="{Binding Displays.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Displays Carousel / Horizontal List -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Displays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveCardPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:DisplayCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- BOTTOM ROW: Layouts Bar -->
        <views:LayoutsBarView Grid.Row="3" />
    </Grid>
</UserControl>
