<UserControl x:Class="AvasRoutingTool.Views.VisualRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             Background="{StaticResource Brush.Background.Dark}">

    <UserControl.Resources>
        <views:IsNullConverter x:Key="IsNull" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!--
                Sources: half the screen in the overview; a compact palette strip while the Composer is open (Ruling R21).
                No minimum heights: on the real window sizes (1264x755, 1008x615 content) two 330 px minimums pushed
                the layout bar off the window; each row scrolls its cards instead. While a copy is armed (or dragged) or
                a drop choice is open, the sources shrink to the compact palette and the layout bar steps aside, so the
                targets' words fit in the displays' view (Ruling R22).
            -->
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="*" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                                <Setter Property="Height" Value="Auto" />
                            </DataTrigger>
                            <!-- A copy armed / dragged or a drop choice open: the displays get the room (Ruling R22) -->
                            <DataTrigger Binding="{Binding IsCopyOrChoiceActive, Mode=OneWay}" Value="True">
                                <Setter Property="Height" Value="Auto" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP ROW: Sources (TX) Section (the Composer's palette while it is open) -->
        <Border Grid.Row="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="16,12,16,6" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                            <Setter Property="Margin" Value="16,8,16,2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCopyOrChoiceActive, Mode=OneWay}" Value="True">
                            <Setter Property="Margin" Value="16,8,16,2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <Grid Grid.Row="0" Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Video}"
                              Fill="{StaticResource Brush.Accent.Primary}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                        <TextBlock Text="VIDEO SOURCES (TX)"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Tap a source, then tap a display - or drag the source onto the display" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                                        <Setter Property="Text" Value="Tap a source, then tap the blocks it should fill" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Grid.Column="2"
                            Background="{StaticResource Brush.Surface.Elevated}"
                            CornerRadius="12"
                            Padding="8,3">
                        <TextBlock FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush.Text.Secondary}">
                            <Run Text="DISCOVERED: " />
                            <Run Text="{Binding Sources.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                        </TextBlock>
                    </Border>
                </Grid>

                <!--
                    Composer: the sources as a compact palette strip (tap arms, drag places; ring and badges stay).
                    Touch pans it sideways; a touch drag on a card therefore pans (tap-to-arm is the touch path).
                -->
                <ScrollViewer Grid.Row="1"
                              x:Name="CompactSourcePalette"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCopyOrChoiceActive, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding Sources}" Focusable="False" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:CompactSourceCardView Margin="0,0,10,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Sources Carousel / Horizontal List -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCopyOrChoiceActive, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveCardPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:SourceCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Subtle Divider -->
        <Border Grid.Row="1" Height="1" Background="{StaticResource Brush.Border.Default}" Margin="16,4" />

        <!-- MIDDLE ROW: Displays (RX) Section - replaced by the Composer while one is open -->
        <Border Grid.Row="2" Margin="16,6,16,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Arm banner (overview only; the Composer shows its own hint): one armed thing, one line - a source
                    being placed (ArmBannerText) or a display being copied (CopyArmBanner); the view model never sets both.
                -->
                <Border Grid.Row="0"
                        x:Name="ArmBanner"
                        Background="{StaticResource Brush.Surface.CopyTarget}"
                        BorderBrush="{StaticResource Brush.Border.DropTarget}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Padding="14,6"
                        Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ArmBannerText, Mode=OneWay}" Value="{x:Null}" />
                                        <Condition Binding="{Binding CopyArmBanner, Mode=OneWay}" Value="{x:Null}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ArmBannerText, Mode=OneWay}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.OnCopyTarget}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ArmBannerText, Mode=OneWay}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CopyArmBanner, Mode=OneWay}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.OnCopyTarget}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CopyArmBanner, Mode=OneWay}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="StopPlacingButton"
                                Style="{StaticResource Style.Button.Composer}"
                                Background="{StaticResource Brush.Border.DropTarget}"
                                BorderBrush="{StaticResource Brush.Border.DropTarget}"
                                Foreground="{StaticResource Brush.Text.OnDropTarget}"
                                Content="Stop"
                                Margin="12,0,0,0"
                                Click="StopPlacing_Click" />
                    </Grid>
                </Border>

                <!-- Section Header -->
                <Grid Grid.Row="1" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Monitor}"
                              Fill="{StaticResource Brush.Accent.Primary}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                        <TextBlock Text="TARGET DISPLAYS (RX)"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Layout ▾ picks a layout - Copy layout copies a display's picture onto another display"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="12,0,8,0" />

                    <Border Grid.Column="2"
                            Background="{StaticResource Brush.Surface.Elevated}"
                            CornerRadius="12"
                            Padding="8,3">
                        <TextBlock FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush.Text.Secondary}">
                            <Run Text="DISCOVERED: " />
                            <Run Text="{Binding Displays.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Displays Carousel / Horizontal List -->
                <ScrollViewer Grid.Row="2"
                              x:Name="DisplaysScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Displays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- The display card's chrome (56 px Layout header, Copy layout row) is taller than the source card's -->
                                <controls:AdaptiveCardPanel Spec="{x:Static controls:GridSpec.DisplayCard}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:DisplayCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- MIDDLE ROW while composing: the MultiView Composer for one display (DataContext = ActiveComposer) -->
        <views:MultiViewComposerView Grid.Row="2"
                                     x:Name="ComposerView"
                                     Margin="16,6,16,12"
                                     DataContext="{Binding ActiveComposer, Mode=OneWay}"
                                     Sources="{Binding DataContext.Sources, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:VisualRoutingView}}">
            <views:MultiViewComposerView.Style>
                <Style TargetType="views:MultiViewComposerView">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:MultiViewComposerView.Style>
        </views:MultiViewComposerView>

        <!-- BOTTOM ROW: Layouts Bar (the Composer has its own layout rail) -->
        <views:LayoutsBarView Grid.Row="3">
            <views:LayoutsBarView.Style>
                <Style TargetType="views:LayoutsBarView">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- Nothing on the bar applies while copying or choosing; its height goes to the displays -->
                        <DataTrigger Binding="{Binding IsCopyOrChoiceActive, Mode=OneWay}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:LayoutsBarView.Style>
        </views:LayoutsBarView>
    </Grid>
</UserControl>
