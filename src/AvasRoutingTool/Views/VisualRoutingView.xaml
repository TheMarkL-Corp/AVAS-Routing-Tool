<UserControl x:Class="AvasRoutingTool.Views.VisualRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             Background="{StaticResource Brush.Background.Dark}">

    <UserControl.Resources>
        <views:IsNullConverter x:Key="IsNull" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Sources: half the screen in the overview; a compact palette strip while the Composer is open (Ruling R21) -->
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="*" />
                        <Setter Property="MinHeight" Value="330" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                                <Setter Property="Height" Value="Auto" />
                                <Setter Property="MinHeight" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition Height="Auto" />
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="*" />
                        <Setter Property="MinHeight" Value="330" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                                <Setter Property="MinHeight" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP ROW: Sources (TX) Section (the Composer's palette while it is open) -->
        <Border Grid.Row="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="16,12,16,6" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                            <Setter Property="Margin" Value="16,8,16,2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <Grid Grid.Row="0" Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Video}"
                              Fill="{StaticResource Brush.Accent.Primary}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                        <TextBlock Text="VIDEO SOURCES (TX)"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Tap a source, then tap a display - or drag the source onto the display" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                                        <Setter Property="Text" Value="Tap a source, then tap the blocks it should fill" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Grid.Column="2"
                            Background="{StaticResource Brush.Surface.Elevated}"
                            CornerRadius="12"
                            Padding="8,3">
                        <TextBlock FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush.Text.Secondary}">
                            <Run Text="DISCOVERED: " />
                            <Run Text="{Binding Sources.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Composer: the sources as a compact palette strip (tap arms, drag places; ring and badges stay) -->
                <ScrollViewer Grid.Row="1"
                              x:Name="CompactSourcePalette"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding Sources}" Focusable="False" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:CompactSourceCardView Margin="0,0,10,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Sources Carousel / Horizontal List -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveCardPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:SourceCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Subtle Divider -->
        <Border Grid.Row="1" Height="1" Background="{StaticResource Brush.Border.Default}" Margin="16,4" />

        <!-- MIDDLE ROW: Displays (RX) Section - replaced by the Composer while one is open -->
        <Border Grid.Row="2" Margin="16,6,16,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Arm banner (overview only; the Composer shows its own hint): one armed thing, one line -->
                <Border Grid.Row="0"
                        Background="#082F3A"
                        BorderBrush="{StaticResource Brush.Border.DropTarget}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Padding="14,6"
                        Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ArmBannerText, Mode=OneWay}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ArmBannerText, Mode=OneWay}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#CFFAFE"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                x:Name="StopPlacingButton"
                                Style="{StaticResource Style.Button.Composer}"
                                Background="{StaticResource Brush.Border.DropTarget}"
                                BorderBrush="{StaticResource Brush.Border.DropTarget}"
                                Foreground="#04232B"
                                Content="Stop"
                                Margin="12,0,0,0"
                                Click="StopPlacing_Click" />
                    </Grid>
                </Border>

                <!-- Section Header -->
                <Grid Grid.Row="1" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Monitor}"
                              Fill="{StaticResource Brush.Accent.Primary}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                        <TextBlock Text="TARGET DISPLAYS (RX)"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Drop source into a display card to switch video feed"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />

                    <Border Grid.Column="2"
                            Background="{StaticResource Brush.Surface.Elevated}"
                            CornerRadius="12"
                            Padding="8,3">
                        <TextBlock FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush.Text.Secondary}">
                            <Run Text="DISCOVERED: " />
                            <Run Text="{Binding Displays.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Displays Carousel / Horizontal List -->
                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Displays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveCardPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:DisplayCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- MIDDLE ROW while composing: the MultiView Composer for one display (DataContext = ActiveComposer) -->
        <views:MultiViewComposerView Grid.Row="2"
                                     x:Name="ComposerView"
                                     Margin="16,6,16,12"
                                     DataContext="{Binding ActiveComposer, Mode=OneWay}"
                                     Sources="{Binding DataContext.Sources, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:VisualRoutingView}}">
            <views:MultiViewComposerView.Style>
                <Style TargetType="views:MultiViewComposerView">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:MultiViewComposerView.Style>
        </views:MultiViewComposerView>

        <!-- BOTTOM ROW: Layouts Bar (the Composer has its own layout rail) -->
        <views:LayoutsBarView Grid.Row="3">
            <views:LayoutsBarView.Style>
                <Style TargetType="views:LayoutsBarView">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveComposer, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:LayoutsBarView.Style>
        </views:LayoutsBarView>
    </Grid>
</UserControl>
