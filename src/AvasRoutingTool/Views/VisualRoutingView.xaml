<UserControl x:Class="AvasRoutingTool.Views.VisualRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource Brush.Background.Dark}"
             KeyDown="Root_KeyDown">

    <Grid x:Name="OverviewGrid">
        <Grid.RowDefinitions>
            <!--
                Sources: half the screen in the overview; a compact palette strip while the Composer is open (Ruling R21).
                No minimum heights: on the real window sizes (1264x755, 1008x615 content) two 330 px minimums pushed
                the layout off the window; each row scrolls its cards instead. Arming a source or a copy never changes
                the layout: the full source cards stay put. Only the Composer swaps in the compact palette.
            -->
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="2*" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsComposing, Mode=OneWay}" Value="True">
                                <Setter Property="Height" Value="Auto" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3.4*" />
        </Grid.RowDefinitions>

        <!-- TOP ROW: Sources (TX) Section (the Composer's palette while it is open) -->
        <Border Grid.Row="0" Margin="16,10,16,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <Grid Grid.Row="0" Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Video}" Style="{StaticResource Style.Icon.Section}" />
                        <TextBlock Text="VIDEO SOURCES (TX)"
                                   Style="{StaticResource Style.Text.Section}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Tap a source, then tap a display - or drag the source onto the display"
                               Style="{StaticResource Style.Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Visibility="{Binding IsComposing, Mode=OneWay, Converter={StaticResource Converter.Visible.False}}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    <TextBlock Grid.Column="1"
                               Text="Tap a source, then tap the blocks it should fill"
                               Style="{StaticResource Style.Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Visibility="{Binding IsComposing, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />

                    <ui:Badge Grid.Column="2" Style="{StaticResource Style.Badge.Info}">
                        <TextBlock>
                            <Run Text="DISCOVERED: " />
                            <Run Text="{Binding Sources.Count, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </ui:Badge>
                </Grid>

                <!--
                    Composer: the sources as a compact palette strip (tap arms, drag places; ring and badges stay).
                    Touch pans it sideways; a touch drag on a card therefore pans (tap-to-arm is the touch path).
                -->
                <ScrollViewer Grid.Row="1"
                              x:Name="CompactSourcePalette"
                              Visibility="{Binding IsComposing, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly">
                    <ItemsControl ItemsSource="{Binding Sources}" Focusable="False" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:CompactSourceCardView Margin="0,0,10,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Sources Carousel / Horizontal List -->
                <ScrollViewer Grid.Row="1"
                              Visibility="{Binding IsComposing, Mode=OneWay, Converter={StaticResource Converter.Visible.False}}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveCardPanel Spec="{x:Static controls:GridSpec.SourceCard}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:SourceCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Subtle Divider -->
        <Border x:Name="SectionDivider" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border.Default}" Margin="12,2" />

        <!-- MIDDLE ROW: Displays (RX) Section - replaced by the Composer while one is open -->
        <Border Grid.Row="2" Margin="16,6,16,12"
                Visibility="{Binding IsComposing, Mode=OneWay, Converter={StaticResource Converter.Visible.False}}">
            <Grid>
                <!--
                    Row 0 is the section header, and the arm banner takes its place in the same cell (critique M1: arming
                    must never move a card). The row's minimum is the banner's height, so the row is the same height idle or armed.
                -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="{StaticResource Size.Section.Header.Height}" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Arm banner (overview only; the Composer shows its own hint): one armed thing, one line - a source
                    being placed (ArmBannerText) or a display being copied (CopyArmBanner); the view model never sets both.
                -->
                <Border Grid.Row="0"
                        x:Name="ArmBanner"
                        VerticalAlignment="Center"
                        Style="{StaticResource Style.Banner.Arm}"
                        Visibility="{Binding HasArmBanner, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ArmBannerLabel"
                                       Text="{Binding ArmBannerText, Mode=OneWay}"
                                       Visibility="{Binding ArmBannerText, Mode=OneWay, Converter={StaticResource Converter.Visible.NotNull}}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource Style.Text.Title}"
                                       Foreground="{DynamicResource Brush.Text.OnCopyTarget}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CopyArmBannerLabel"
                                       Text="{Binding CopyArmBanner, Mode=OneWay}"
                                       Visibility="{Binding CopyArmBanner, Mode=OneWay, Converter={StaticResource Converter.Visible.NotNull}}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource Style.Text.Title}"
                                       Foreground="{DynamicResource Brush.Text.OnCopyTarget}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="StopPlacingButton"
                                Style="{StaticResource Style.Button.Composer}"
                                Background="{DynamicResource Brush.Border.DropTarget}"
                                BorderBrush="{DynamicResource Brush.Border.DropTarget}"
                                Foreground="{DynamicResource Brush.Text.OnDropTarget}"
                                Content="Stop"
                                Margin="12,0,0,0"
                                Click="StopPlacing_Click" />
                    </Grid>
                </Border>

                <!-- Section Header (hidden while the arm banner takes its row) -->
                <Grid Grid.Row="0" Margin="4,0" VerticalAlignment="Center"
                      Visibility="{Binding HasArmBanner, Mode=OneWay, Converter={StaticResource Converter.Visible.False}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Monitor}" Style="{StaticResource Style.Icon.Section}" />
                        <TextBlock Text="TARGET DISPLAYS (RX)"
                                   Style="{StaticResource Style.Text.Section}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="The Layout button picks a layout - Copy layout copies a display's picture onto another display"
                               Style="{StaticResource Style.Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="12,0,8,0" />

                    <ui:Badge Grid.Column="2" Style="{StaticResource Style.Badge.Info}">
                        <TextBlock>
                            <Run Text="DISCOVERED: " />
                            <Run Text="{Binding Displays.Count, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </ui:Badge>
                </Grid>

                <!-- Displays Carousel / Horizontal List -->
                <ScrollViewer Grid.Row="1"
                              x:Name="DisplaysScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Displays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- The display card's chrome (56 px Layout header, Copy layout row) is taller than the source card's -->
                                <controls:AdaptiveCardPanel Spec="{x:Static controls:GridSpec.DisplayCard}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:DisplayCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- MIDDLE ROW while composing: the MultiView Composer for one display (DataContext = ActiveComposer) -->
        <views:MultiViewComposerView Grid.Row="2"
                                     x:Name="ComposerView"
                                     Margin="16,6,16,12"
                                     DataContext="{Binding ActiveComposer, Mode=OneWay}"
                                     Visibility="{Binding Mode=OneWay, Converter={StaticResource Converter.Visible.NotNull}}"
                                     Sources="{Binding DataContext.Sources, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:VisualRoutingView}}" />
    </Grid>
</UserControl>
