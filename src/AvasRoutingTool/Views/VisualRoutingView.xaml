<UserControl x:Class="AvasRoutingTool.Views.VisualRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource Brush.Background.Dark}"
             KeyDown="Root_KeyDown">

    <Grid x:Name="OverviewGrid">
        <Grid.RowDefinitions>
            <!--
                Sources: as tall as the strip needs (Auto), so the displays get the rest of the height (critique M2). The strip is
                a dense wrap of tiles, capped at a share of the overview height (Size.Strip.Max.Fraction) before it scrolls; every tile stays realized.
                While the Composer is open its compact palette sits in the same row. Arming a source or a copy never changes the
                layout: the tiles stay put.
            -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP ROW: Sources (TX) Section (the Composer's palette while it is open) -->
        <Border Grid.Row="0" Margin="16,10,16,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <Grid Grid.Row="0" Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Video}" Style="{StaticResource Style.Icon.Section}" />
                        <TextBlock Text="Video sources (TX)"
                                   Style="{StaticResource Style.Text.Title}"
                                   AutomationProperties.HeadingLevel="Level2"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Tap a source, then tap a display - or drag the source onto the display"
                               Style="{StaticResource Style.Text.Caption}"
                               Visibility="{Binding IsComposing, Mode=OneWay, Converter={StaticResource Converter.Visible.False}}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    <TextBlock Grid.Column="1"
                               Text="Tap a source, then tap the blocks it should fill"
                               Style="{StaticResource Style.Text.Caption}"
                               Visibility="{Binding IsComposing, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />

                    <TextBlock Grid.Column="2"
                               Style="{StaticResource Style.Text.Caption}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding Sources.Count, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=" discovered" />
                    </TextBlock>
                </Grid>

                <!--
                    Composer: the sources as a compact palette strip (tap arms, drag places; ring and badges stay).
                    Touch pans it sideways; a touch drag on a card therefore pans (tap-to-arm is the touch path).
                -->
                <ScrollViewer Grid.Row="1"
                              x:Name="CompactSourcePalette"
                              Visibility="{Binding IsComposing, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly">
                    <ItemsControl ItemsSource="{Binding Sources}" Focusable="False" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:SourceCardView IsCompact="True" Margin="{StaticResource Size.Strip.TileMargin}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Sources Carousel / Horizontal List -->
                <!-- The overview strip: a plain CenteredWrapPanel (rows centred; not virtualized: every tile owns a live preview). It never takes more than Size.Strip.Max.Fraction of the overview height; beyond that it scrolls -->
                <ScrollViewer Grid.Row="1"
                              Visibility="{Binding IsComposing, Mode=OneWay, Converter={StaticResource Converter.Visible.False}}"
                              MaxHeight="{Binding ActualHeight, ElementName=OverviewGrid, Converter={StaticResource Converter.FractionOf}, ConverterParameter={StaticResource Size.Strip.Max.Fraction}}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:CenteredWrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:SourceCardView Margin="{StaticResource Size.Strip.TileMargin}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Subtle Divider -->
        <Border x:Name="SectionDivider" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border.Default}" Margin="12,2" />

        <!-- MIDDLE ROW: Displays (RX) Section - replaced by the Composer while one is open -->
        <Border Grid.Row="2" Margin="16,6,16,12"
                Visibility="{Binding IsComposing, Mode=OneWay, Converter={StaticResource Converter.Visible.False}}">
            <Grid>
                <!--
                    Row 0 is the section header, and the arm banner takes its place in the same cell (critique M1: arming
                    must never move a card). The row's minimum is the banner's height, so the row is the same height idle or armed.
                -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="{StaticResource Size.Section.Header.Height}" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Arm banner (overview only; the Composer shows its own hint): one armed thing, one line - a source
                    being placed (ArmBannerText) or a display being copied (CopyArmBanner); the view model never sets both.
                -->
                <Border Grid.Row="0"
                        x:Name="ArmBanner"
                        VerticalAlignment="Center"
                        Style="{StaticResource Style.Banner.Arm}"
                        Visibility="{Binding HasArmBanner, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
                    <Grid>
                        <!--
                            The 2 px ring, drawn beneath the content and over the banner's full size: the Stop button's own keyboard focus ring sits
                            on its outer 2 px and must draw over it. The content sits 14 px in (the 2 px ring + 12 px, as before) and keeps the full 48 px.
                        -->
                        <Border x:Name="ArmBannerRing"
                                Style="{StaticResource Style.Banner.Arm.Ring}" />
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ArmBannerLabel"
                                           Text="{Binding ArmBannerText, Mode=OneWay}"
                                           Visibility="{Binding ArmBannerText, Mode=OneWay, Converter={StaticResource Converter.Visible.NotNull}}"
                                           AutomationProperties.LiveSetting="Polite"
                                           Style="{StaticResource Style.Text.Title}"
                                           Foreground="{DynamicResource Brush.Text.OnCopyTarget}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CopyArmBannerLabel"
                                           Text="{Binding CopyArmBanner, Mode=OneWay}"
                                           Visibility="{Binding CopyArmBanner, Mode=OneWay, Converter={StaticResource Converter.Visible.NotNull}}"
                                           AutomationProperties.LiveSetting="Polite"
                                           Style="{StaticResource Style.Text.Title}"
                                           Foreground="{DynamicResource Brush.Text.OnCopyTarget}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="StopPlacingButton"
                                    Style="{StaticResource Style.Button.Composer}"
                                    Background="{DynamicResource Brush.Border.DropTarget}"
                                    BorderBrush="{DynamicResource Brush.Border.DropTarget}"
                                    Foreground="{DynamicResource Brush.Text.OnDropTarget}"
                                    Content="Stop"
                                    Margin="12,0,0,0"
                                    Click="StopPlacing_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Section Header (hidden while the arm banner takes its row) -->
                <Grid Grid.Row="0" Margin="4,0" VerticalAlignment="Center"
                      Visibility="{Binding HasArmBanner, Mode=OneWay, Converter={StaticResource Converter.Visible.False}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Monitor}" Style="{StaticResource Style.Icon.Section}" />
                        <TextBlock Text="Target displays (RX)"
                                   Style="{StaticResource Style.Text.Title}"
                                   AutomationProperties.HeadingLevel="Level2"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Tap a layout to change a display, or copy one display's picture onto another."
                               Style="{StaticResource Style.Text.Caption}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="12,0,8,0" />

                    <TextBlock Grid.Column="2"
                               Style="{StaticResource Style.Text.Caption}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding Displays.Count, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=" discovered" />
                    </TextBlock>
                </Grid>

                <!-- Displays Carousel / Horizontal List -->
                <ScrollViewer Grid.Row="1"
                              x:Name="DisplaysScroll"
                              Margin="0,8,0,0"
                              VerticalAlignment="Top"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource Style.ScrollViewer.VerticalOverlay}"
                              PanningMode="Both"
                              Focusable="False"
                              PreviewMouseWheel="DisplaysScroll_PreviewMouseWheel"
                              ScrollChanged="DisplaysScroll_ScrollChanged"
                              SizeChanged="DisplaysScroll_SizeChanged">
                    <ItemsControl ItemsSource="{Binding Displays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- The display card's chrome (56 px Layout header, Copy layout row) is taller than the source card's -->
                                <controls:AdaptiveCardPanel Spec="{x:Static controls:GridSpec.DisplayCard}" CenterVertically="False" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:DisplayCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Sideways arrows over the row's edges, centred on the card pictures (the margin is set in code); shown only when the row scrolls -->
                <Button Grid.Row="1"
                        x:Name="DisplaysScrollLeft"
                        Style="{StaticResource Style.Button.CarouselArrow}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"
                        IsEnabled="False"
                        ToolTip="Scroll displays left"
                        AutomationProperties.Name="Scroll displays left"
                        Click="DisplaysScrollLeft_Click">
                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="{StaticResource Size.Icon.M}" />
                </Button>
                <Button Grid.Row="1"
                        x:Name="DisplaysScrollRight"
                        Style="{StaticResource Style.Button.CarouselArrow}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        ToolTip="Scroll displays right"
                        AutomationProperties.Name="Scroll displays right"
                        Click="DisplaysScrollRight_Click">
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="{StaticResource Size.Icon.M}" />
                </Button>
            </Grid>
        </Border>

        <!-- MIDDLE ROW while composing: the MultiView Composer for one display (DataContext = ActiveComposer) -->
        <views:MultiViewComposerView Grid.Row="2"
                                     x:Name="ComposerView"
                                     Margin="16,6,16,12"
                                     DataContext="{Binding ActiveComposer, Mode=OneWay}"
                                     Visibility="{Binding Mode=OneWay, Converter={StaticResource Converter.Visible.NotNull}}"
                                     Sources="{Binding DataContext.Sources, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:VisualRoutingView}}" />

        <!--
            Rename error (DataContext = MainViewModel): why the last rename failed, over the bottom of the overview. An overlay in the outermost
            Grid across all rows, so showing or dismissing it moves nothing. An error, so the danger surface, border and text of the display
            card's error banner; the warning icon and the words carry it, not the colour. Dismiss is a 48 px icon button.
        -->
        <Border x:Name="RenameBanner"
                Grid.RowSpan="3"
                VerticalAlignment="Bottom"
                Margin="16,0,16,16"
                Padding="14,0,0,0"
                Background="{DynamicResource Brush.Surface.ScrimDanger}"
                BorderBrush="{DynamicResource Brush.Border.Danger}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding HasRenameBanner, Mode=OneWay, Converter={StaticResource Converter.Visible.True}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0"
                               Symbol="Warning24"
                               FontSize="{StaticResource Size.Icon.M}"
                               Foreground="{DynamicResource Brush.Text.OnScrimDanger}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                <TextBlock x:Name="RenameBannerText"
                           Grid.Column="1"
                           Text="{Binding RenameBanner, Mode=OneWay}"
                           AutomationProperties.LiveSetting="Assertive"
                           Style="{StaticResource Style.Text.Title}"
                           Foreground="{DynamicResource Brush.Text.OnScrimDanger}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,10" />

                <Button x:Name="RenameBannerDismiss"
                        Grid.Column="2"
                        Style="{StaticResource Style.Button.Ghost}"
                        Command="{Binding DismissRenameBannerCommand, Mode=OneWay}"
                        AutomationProperties.Name="Dismiss rename error"
                        ToolTip="Dismiss"
                        Foreground="{DynamicResource Brush.Text.OnScrimDanger}"
                        MinWidth="{StaticResource Size.Touch.Min}"
                        MinHeight="{StaticResource Size.Touch.Min}"
                        Padding="0"
                        Margin="6,0,0,0"
                        IsTabStop="True"
                        VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="{StaticResource Size.Icon.S}" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
