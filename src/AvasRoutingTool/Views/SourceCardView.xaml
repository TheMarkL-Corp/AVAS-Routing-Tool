<UserControl x:Class="AvasRoutingTool.Views.SourceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             MinWidth="320"
             Focusable="True"
             IsTabStop="True"
             FocusVisualStyle="{x:Null}"
             AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}"
             KeyDown="Card_KeyDown"
             PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
             MouseMove="Card_MouseMove"
             MouseLeftButtonUp="Card_MouseLeftButtonUp">

    <Grid>
    <Border Background="{DynamicResource Brush.Surface.Card}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Cursor="Hand">

        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Highlight}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" MinHeight="36" />
            </Grid.RowDefinitions>

            <!-- Card Header: status, name, info badge (IP / MAC / MCAST tooltip), link + online badges -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0"
                         Width="8" Height="8"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Status.Offline}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Status.Online}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Strict BAVM Device Name -->
                <TextBlock Grid.Column="1"
                           Text="{Binding DeviceName, Mode=OneWay}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!-- Info badge: network telemetry lives in its tooltip -->
                <Border x:Name="SourceInfoBadge"
                        Focusable="True"
                        KeyboardNavigation.IsTabStop="True"
                        AutomationProperties.Name="Device network telemetry: IP, MAC, multicast"
                        Grid.Column="2"
                        CornerRadius="10"
                        Padding="6,1"
                        Margin="6,0,0,0"
                        Background="{DynamicResource Brush.Surface.Elevated}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        Cursor="Help"
                        VerticalAlignment="Center">
                    <Border.ToolTip>
                        <TextBlock>
                            <Run Text="IP: " /><Run Text="{Binding IpAddress, Mode=OneWay}" /><Run Text=" · MAC: " /><Run Text="{Binding MacAddress, Mode=OneWay}" /><Run Text=" · MCAST: " /><Run Text="{Binding PreviewMulticastIp, Mode=OneWay}" />
                        </TextBlock>
                    </Border.ToolTip>
                    <TextBlock Text="ⓘ"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </Border>

                <!-- Link Mode Badge (Dual Link only) -->
                <Border Grid.Column="3"
                        Margin="6,0,0,0"
                        CornerRadius="4"
                        Padding="6,2"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.Surface.RoutedBadge}"
                        BorderBrush="{DynamicResource Brush.Border.RoutedBadge}"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDualLink, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="DUAL LINK"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.OnRoutedBadge}" />
                </Border>

                <!-- Online / Offline Badge -->
                <Border Grid.Column="4"
                        Margin="6,0,0,0"
                        CornerRadius="4"
                        Padding="6,2"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.OnlineBadge}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.OnlineBadge}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="10" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="OFFLINE" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                        <Setter Property="Text" Value="ONLINE" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Online}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- Live Video Preview Surface -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.Surface.PreviewTile}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                    <!-- Actual Video Image -->
                    <Image Source="{Binding PreviewBitmap, Mode=OneWay}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="LowQuality" />

                    <!-- Non-AVAS Device: Preview not supported banner -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewSupported, Mode=OneWay}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource Icon.Video}"
                              Fill="{DynamicResource Brush.Text.Muted}"
                              Width="22" Height="22"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Opacity="0.4" />
                        <TextBlock Text="Preview not supported"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="Non-AVAS Device"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- AVAS Standby placeholder if supported but not streaming -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Opacity="0.4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPreviewSupported, Mode=OneWay}" Value="True" />
                                            <Condition Binding="{Binding IsStreaming, Mode=OneWay}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource Icon.Video}"
                              Fill="{DynamicResource Brush.Text.Muted}"
                              Width="24" Height="24"
                              Stretch="Uniform"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="Preview Standby"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Routing state chips (kept on the picture so the footer stays one touch-safe row) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="6">
                        <Border x:Name="UsedInBlocksBadge"
                                Background="{DynamicResource Brush.Surface.Staged}"
                                BorderBrush="{DynamicResource Brush.Status.Staged}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsedInBlocks, Mode=OneWay}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.StagedChipText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding UsedInBlocks, Mode=OneWay, StringFormat='in {0} blocks'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsedInBlocks, Mode=OneWay}" Value="1">
                                                <Setter Property="Text" Value="in 1 block" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Tapped to place: the ring alone is colour, so it also says so -->
                        <Border Background="{DynamicResource Brush.Surface.CopyTarget}"
                                BorderBrush="{DynamicResource Brush.Border.DropTarget}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsArmed, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Placing" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.CopyAccent}" />
                        </Border>

                        <!-- Tap / drag hint (gives way to the badges: the card is narrow) -->
                        <Border Background="{DynamicResource Brush.Surface.Elevated}"
                                CornerRadius="4"
                                Padding="6,3"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsedInBlocks, Mode=OneWay}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsArmed, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="TAP OR DRAG TO ROUTE"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Touch-safe footer: stream state on the left, stream controls on the right -->
            <Grid Grid.Row="2" Margin="0,8,0,0" MinHeight="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="PREVIEW PAUSED" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewSupported, Mode=OneWay}" Value="False">
                                    <Setter Property="Text" Value="EXTERNAL SOURCE" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStreaming, Mode=OneWay}" Value="True">
                                    <Setter Property="Text" Value="{Binding Fps, Mode=OneWay, StringFormat='{}{0:F1} FPS'}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshStreamButton"
                            Command="{Binding RefreshPreviewCommand, Mode=OneWay}"
                            ToolTip="Force preview reset &amp; restart"
                            MinHeight="36"
                            Padding="10,6"
                            FontSize="12"
                            IsTabStop="True"
                            Content="↻ Refresh">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Secondary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewSupported, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="StopStreamButton"
                            Command="{Binding StopPreviewCommand, Mode=OneWay}"
                            ToolTip="Stop Preview Stream"
                            MinHeight="36"
                            Padding="10,6"
                            FontSize="12"
                            Margin="8,0,0,0"
                            IsTabStop="True"
                            Content="■ Stop">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Unroute}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStreaming, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="StartStreamButton"
                            Command="{Binding StartPreviewCommand, Mode=OneWay}"
                            ToolTip="Start Preview Stream"
                            MinHeight="36"
                            Padding="10,6"
                            FontSize="12"
                            Margin="8,0,0,0"
                            IsTabStop="True"
                            Content="▶ Start">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Primary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPreviewSupported, Mode=OneWay}" Value="True" />
                                            <Condition Binding="{Binding IsStreaming, Mode=OneWay}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <!-- Keyboard focus: a 2 px ring just inside the edge (inside the armed ring), drawn here so it also renders -->
    <Border x:Name="FocusRing"
            Margin="3"
            BorderBrush="{DynamicResource Brush.Focus.Ring}"
            BorderThickness="2"
            CornerRadius="6"
            IsHitTestVisible="False">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding (views:InputModality.ShowsFocus), RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>

    <!-- Armed ring (cyan, spec 9), drawn over the card edge so the card does not move -->
    <Border x:Name="ArmedRing"
            BorderBrush="{DynamicResource Brush.Border.DropTarget}"
            BorderThickness="3"
            CornerRadius="8"
            IsHitTestVisible="False">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsArmed, Mode=OneWay}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
    </Grid>
</UserControl>
