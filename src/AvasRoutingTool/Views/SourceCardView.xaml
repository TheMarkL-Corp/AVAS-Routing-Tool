<UserControl x:Class="AvasRoutingTool.Views.SourceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320"
             PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
             MouseMove="Card_MouseMove"
             MouseLeftButtonUp="Card_MouseLeftButtonUp">

    <Grid>
    <Border Background="{StaticResource Brush.Surface.Card}"
            BorderBrush="{StaticResource Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Cursor="Hand">

        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Highlight}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Card Header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status indicator dot -->
                <Ellipse Grid.Column="0"
                         Width="8" Height="8"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Brush.Status.Offline}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Status.Online}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Strict BAVM Device Name -->
                <TextBlock Grid.Column="1"
                           Text="{Binding DeviceName}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!-- Link Mode Badge (Single Link / Dual Link) -->
                <Border Grid.Column="2"
                        Margin="6,0,6,0"
                        CornerRadius="4"
                        Padding="6,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDualLink}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Background" Value="#1E14B8A6" />
                                    <Setter Property="BorderBrush" Value="#4D14B8A6" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDualLink}" Value="False" />
                                        <Condition Binding="{Binding IsPreviewSupported}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Background" Value="#1E334155" />
                                    <Setter Property="BorderBrush" Value="#334155" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding LinkMode}"
                               FontSize="10"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDualLink}" Value="True">
                                        <Setter Property="Foreground" Value="#14B8A6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- FPS Badge -->
                <Border Grid.Column="3"
                        Background="#263B82F6"
                        BorderBrush="#4D3B82F6"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Fps, StringFormat='{}{0:F1}'}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource Brush.Accent.Primary}" />
                        <TextBlock Text=" FPS"
                                   FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Muted}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Live Video Preview Surface -->
            <Border Grid.Row="1"
                    Background="#0B0F17"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                    <!-- Actual Video Image -->
                    <Image Source="{Binding PreviewBitmap}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="LowQuality" />

                    <!-- Non-AVAS Device: Preview not supported banner -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewSupported}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource Icon.Video}"
                              Fill="{StaticResource Brush.Text.Muted}"
                              Width="22" Height="22"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Opacity="0.4" />
                        <TextBlock Text="Preview not supported"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="Non-AVAS Device"
                                   FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- AVAS Standby placeholder if supported but not streaming -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Opacity="0.4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPreviewSupported}" Value="True" />
                                            <Condition Binding="{Binding IsStreaming}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource Icon.Video}"
                              Fill="{StaticResource Brush.Text.Muted}"
                              Width="24" Height="24"
                              Stretch="Uniform"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="Preview Standby"
                                   FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card Telemetry Row -->
            <Grid Grid.Row="2" Margin="0,6,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding IpAddress}"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding MacAddress}"
                               FontSize="10"
                               Foreground="{StaticResource Brush.Text.Muted}" />
                </StackPanel>

                <!-- Preview Multicast IP Badge -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock FontSize="10" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Right">
                        <Run Text="MCAST: " />
                        <Run Text="{Binding PreviewMulticastIp, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Secondary}" FontWeight="Medium" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Card Controls & Drag Handle Row -->
            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Preview Stream Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Refresh Button -->
                    <Button Command="{Binding RefreshPreviewCommand}"
                            ToolTip="Force preview reset &amp; restart"
                            Background="#1E293B"
                            Foreground="{StaticResource Brush.Text.Secondary}"
                            BorderBrush="{StaticResource Brush.Border.Default}"
                            BorderThickness="1"
                            FontSize="10"
                            FontWeight="Medium"
                            Padding="6,3"
                            Margin="0,0,4,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewSupported}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="9" Margin="0,0,3,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>

                    <!-- Start Preview Button -->
                    <Button Command="{Binding StartPreviewCommand}"
                            ToolTip="Start Preview Stream"
                            Background="#1E293B"
                            Foreground="#10B981"
                            BorderBrush="#10B981"
                            BorderThickness="1"
                            FontSize="10"
                            FontWeight="Medium"
                            Padding="6,3"
                            Margin="0,0,4,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPreviewSupported}" Value="True" />
                                            <Condition Binding="{Binding IsStreaming}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" FontSize="8" Margin="0,0,3,0" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>

                    <!-- Stop Preview Button -->
                    <Button Command="{Binding StopPreviewCommand}"
                            ToolTip="Stop Preview Stream"
                            Background="#1E293B"
                            Foreground="#EF4444"
                            BorderBrush="#EF4444"
                            BorderThickness="1"
                            FontSize="10"
                            FontWeight="Medium"
                            Padding="6,3"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏹" FontSize="8" Margin="0,0,3,0" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- In the Composer: how many staged blocks show this encoder -->
                    <Border x:Name="UsedInBlocksBadge"
                            Background="#2A1F08"
                            BorderBrush="{StaticResource Brush.Status.Staged}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsedInBlocks, Mode=OneWay}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#FDE68A">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding UsedInBlocks, Mode=OneWay, StringFormat='in {0} blocks'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsedInBlocks, Mode=OneWay}" Value="1">
                                            <Setter Property="Text" Value="in 1 block" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Tapped to place: the ring alone is colour, so it also says so -->
                    <Border Background="#082F3A"
                            BorderBrush="{StaticResource Brush.Border.DropTarget}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArmed, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Placing" FontSize="14" FontWeight="Bold" Foreground="#A5F3FC" />
                    </Border>

                    <!-- Tap / drag hint (gives way to the badges: the card is narrow) -->
                    <Border Background="{StaticResource Brush.Surface.Elevated}"
                            CornerRadius="4"
                            Padding="6,3"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsedInBlocks, Mode=OneWay}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsArmed, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="TAP OR DRAG TO ROUTE"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <!-- Armed ring (cyan, spec 9), drawn over the card edge so the card does not move -->
    <Border x:Name="ArmedRing"
            BorderBrush="{StaticResource Brush.Border.DropTarget}"
            BorderThickness="3"
            CornerRadius="8"
            IsHitTestVisible="False">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsArmed, Mode=OneWay}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
    </Grid>
</UserControl>
