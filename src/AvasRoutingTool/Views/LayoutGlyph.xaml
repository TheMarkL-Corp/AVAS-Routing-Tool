<UserControl x:Class="AvasRoutingTool.Views.LayoutGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             Focusable="False"
             IsHitTestVisible="False">

    <!--
        A layout drawn as outline cells only: no fill, no digits. The cells take the colour of this control's Foreground, which it
        inherits from the button it sits in (idle, hover, on screen), so the state is the button's colour, not a second one.
    -->
    <ItemsControl x:Name="CellsHost" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:FractionalLayoutPanel AspectRatio="{x:Static views:AspectRatioConverter.Default}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
            <StaticResource ResourceKey="Style.Item.Fractional.Cell" />
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource Style.Border.GlyphCell}"
                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
