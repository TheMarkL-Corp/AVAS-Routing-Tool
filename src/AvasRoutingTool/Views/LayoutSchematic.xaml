<UserControl x:Class="AvasRoutingTool.Views.LayoutSchematic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             Focusable="False"
             IsHitTestVisible="False">

    <!-- A layout preset drawn as its real block geometry (16:9 screen, letterbox gaps included). -->
    <Border Background="{DynamicResource Brush.Surface.Inset}"
            BorderBrush="{DynamicResource Brush.Border.Control}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="2">
        <Grid>
            <ItemsControl x:Name="CellsHost" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:FractionalLayoutPanel AspectRatio="{x:Static views:AspectRatioConverter.Default}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <StaticResource ResourceKey="Style.Item.Fractional.Cell" />
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="1.5"
                                Background="{DynamicResource Brush.Surface.SchematicActive}"
                                BorderBrush="{DynamicResource Brush.Accent.Primary}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <TextBlock Text="{Binding Number, Mode=OneWay}" Style="{StaticResource Style.Text.Schematic.Cell}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Off: a dark screen with the word, never colour alone -->
            <TextBlock x:Name="OffGlyph"
                       Text="OFF"
                       Style="{StaticResource Style.Text.Schematic.Off}"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
