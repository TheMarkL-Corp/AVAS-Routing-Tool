<UserControl x:Class="AvasRoutingTool.Views.PtzPadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             xmlns:visca="clr-namespace:AvasRoutingTool.Services.Visca">

    <!--
        Direction pad of the Room Cameras rail (RC10). A 3x3 grid: eight hold-to-move keys around the Home key.
        The DataContext is a RoomCameraViewModel. Each direction key presses MoveStartCommand with its PanTiltDirection
        and releases through MoveEndCommand (Stop); Home is a plain command. Sizes and states come from the central styles.
    -->
    <UniformGrid x:Name="KeyGrid" Rows="3" Columns="3">

        <Button Style="{StaticResource Style.Button.PtzKey}"
                MinWidth="{StaticResource Size.Camera.PadKey}"
                MinHeight="{StaticResource Size.Camera.PadKey}"
                views:HoldButton.PressCommand="{Binding MoveStartCommand}"
                views:HoldButton.ReleaseCommand="{Binding MoveEndCommand}"
                views:HoldButton.CommandParameter="{x:Static visca:PanTiltDirection.UpLeft}"
                AutomationProperties.Name="Pan up-left, hold to move"
                ToolTip="Pan and tilt up-left (hold)">
            <ui:SymbolIcon Symbol="ArrowUpLeft24" FontSize="{StaticResource Size.Icon.M}" />
        </Button>

        <Button Style="{StaticResource Style.Button.PtzKey}"
                MinWidth="{StaticResource Size.Camera.PadKey}"
                MinHeight="{StaticResource Size.Camera.PadKey}"
                views:HoldButton.PressCommand="{Binding MoveStartCommand}"
                views:HoldButton.ReleaseCommand="{Binding MoveEndCommand}"
                views:HoldButton.CommandParameter="{x:Static visca:PanTiltDirection.Up}"
                AutomationProperties.Name="Pan up, hold to move"
                ToolTip="Tilt up (hold)">
            <ui:SymbolIcon Symbol="ArrowUp24" FontSize="{StaticResource Size.Icon.M}" />
        </Button>

        <Button Style="{StaticResource Style.Button.PtzKey}"
                MinWidth="{StaticResource Size.Camera.PadKey}"
                MinHeight="{StaticResource Size.Camera.PadKey}"
                views:HoldButton.PressCommand="{Binding MoveStartCommand}"
                views:HoldButton.ReleaseCommand="{Binding MoveEndCommand}"
                views:HoldButton.CommandParameter="{x:Static visca:PanTiltDirection.UpRight}"
                AutomationProperties.Name="Pan up-right, hold to move"
                ToolTip="Pan and tilt up-right (hold)">
            <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="{StaticResource Size.Icon.M}" />
        </Button>

        <Button Style="{StaticResource Style.Button.PtzKey}"
                MinWidth="{StaticResource Size.Camera.PadKey}"
                MinHeight="{StaticResource Size.Camera.PadKey}"
                views:HoldButton.PressCommand="{Binding MoveStartCommand}"
                views:HoldButton.ReleaseCommand="{Binding MoveEndCommand}"
                views:HoldButton.CommandParameter="{x:Static visca:PanTiltDirection.Left}"
                AutomationProperties.Name="Pan left, hold to move"
                ToolTip="Pan left (hold)">
            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="{StaticResource Size.Icon.M}" />
        </Button>

        <Button Style="{StaticResource Style.Button.PtzHome}"
                MinWidth="{StaticResource Size.Camera.PadKey}"
                MinHeight="{StaticResource Size.Camera.PadKey}"
                Command="{Binding HomeCommand}"
                AutomationProperties.Name="Home camera, press"
                ToolTip="Send the camera to its home position">
            <ui:SymbolIcon Symbol="Home24" FontSize="{StaticResource Size.Icon.M}" />
        </Button>

        <Button Style="{StaticResource Style.Button.PtzKey}"
                MinWidth="{StaticResource Size.Camera.PadKey}"
                MinHeight="{StaticResource Size.Camera.PadKey}"
                views:HoldButton.PressCommand="{Binding MoveStartCommand}"
                views:HoldButton.ReleaseCommand="{Binding MoveEndCommand}"
                views:HoldButton.CommandParameter="{x:Static visca:PanTiltDirection.Right}"
                AutomationProperties.Name="Pan right, hold to move"
                ToolTip="Pan right (hold)">
            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="{StaticResource Size.Icon.M}" />
        </Button>

        <Button Style="{StaticResource Style.Button.PtzKey}"
                MinWidth="{StaticResource Size.Camera.PadKey}"
                MinHeight="{StaticResource Size.Camera.PadKey}"
                views:HoldButton.PressCommand="{Binding MoveStartCommand}"
                views:HoldButton.ReleaseCommand="{Binding MoveEndCommand}"
                views:HoldButton.CommandParameter="{x:Static visca:PanTiltDirection.DownLeft}"
                AutomationProperties.Name="Pan down-left, hold to move"
                ToolTip="Pan and tilt down-left (hold)">
            <ui:SymbolIcon Symbol="ArrowDownLeft24" FontSize="{StaticResource Size.Icon.M}" />
        </Button>

        <Button Style="{StaticResource Style.Button.PtzKey}"
                MinWidth="{StaticResource Size.Camera.PadKey}"
                MinHeight="{StaticResource Size.Camera.PadKey}"
                views:HoldButton.PressCommand="{Binding MoveStartCommand}"
                views:HoldButton.ReleaseCommand="{Binding MoveEndCommand}"
                views:HoldButton.CommandParameter="{x:Static visca:PanTiltDirection.Down}"
                AutomationProperties.Name="Pan down, hold to move"
                ToolTip="Tilt down (hold)">
            <ui:SymbolIcon Symbol="ArrowDown24" FontSize="{StaticResource Size.Icon.M}" />
        </Button>

        <Button Style="{StaticResource Style.Button.PtzKey}"
                MinWidth="{StaticResource Size.Camera.PadKey}"
                MinHeight="{StaticResource Size.Camera.PadKey}"
                views:HoldButton.PressCommand="{Binding MoveStartCommand}"
                views:HoldButton.ReleaseCommand="{Binding MoveEndCommand}"
                views:HoldButton.CommandParameter="{x:Static visca:PanTiltDirection.DownRight}"
                AutomationProperties.Name="Pan down-right, hold to move"
                ToolTip="Pan and tilt down-right (hold)">
            <!-- ArrowDownRight24 renders as a broken glyph: the up-right arrow turned a quarter turn clockwise -->
            <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="{StaticResource Size.Icon.M}" RenderTransformOrigin="0.5,0.5">
                <ui:SymbolIcon.RenderTransform>
                    <RotateTransform Angle="90" />
                </ui:SymbolIcon.RenderTransform>
            </ui:SymbolIcon>
        </Button>

    </UniformGrid>
</UserControl>
