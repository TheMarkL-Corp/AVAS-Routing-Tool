<Window x:Class="AvasRoutingTool.Views.LinkSwitchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="{StaticResource Size.Dialog.Settings.Width}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background.Dark}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Style="{StaticResource Style.Text.Lead}" TextWrapping="Wrap" />

        <TextBlock x:Name="AffectedText"
                   Grid.Row="1"
                   Style="{StaticResource Style.Text.Body}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource Style.Button.Secondary}"
                    MinWidth="{StaticResource Size.Button.Dialog.Min}"
                    MinHeight="{StaticResource Size.Touch.Min}"
                    Margin="0,0,10,0"
                    Click="Cancel_Click" />
            <Button x:Name="ConfirmButton"
                    Style="{StaticResource Style.Button.Primary}"
                    MinWidth="{StaticResource Size.Button.Dialog.Min}"
                    MinHeight="{StaticResource Size.Touch.Min}"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
