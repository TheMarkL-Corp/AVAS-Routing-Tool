<UserControl x:Class="AvasRoutingTool.Views.MultiViewComposerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             Foreground="{DynamicResource Brush.Text.Primary}">

    <!--
        The MultiView Composer for one display (spec 5.2): left rail = Step 1 layout tiles, centre = the staged canvas
        at the display's real aspect, right rail = ON SCREEN NOW, changes and (pinned) Take. DataContext =
        MultiViewComposerViewModel. Every control calls the view model; nothing reaches the device before Take.
    -->
    <UserControl.Resources>
        <views:AspectRatioConverter x:Key="AspectRatio" />
        <views:PaintOrderConverter x:Key="PaintOrder" />
        <views:HasItemsConverter x:Key="HasItems" />
        <views:IsNullConverter x:Key="IsNull" />
        <views:SameTextConverter x:Key="SameText" />
        <views:LessThanConverter x:Key="LessThan" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NegativeHalfConverter x:Key="NegativeHalf" />
        <!-- Icon.Lock comes from Resources/Icons.xaml (shared with the display card) -->

        <!-- Small dark chip over a preview (legible on any picture) -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Scrim}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Scrim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="RailCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,4,12" />
        </Style>

        <Style x:Key="RailHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>

        <!-- Step marker: number until the step is done, then a check (shape and text, not colour alone) -->
        <Style x:Key="StepDot" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <!-- Transparent background: a tap on any empty area stops placing / moving (spec 6) -->
    <!-- Any release anywhere in the view also ends the block drag gesture (no stale press can start a drag later) -->
    <Grid Background="Transparent" MouseLeftButtonUp="Root_MouseLeftButtonUp" PreviewMouseLeftButtonUp="Root_PreviewMouseLeftButtonUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header: which display, its output, and the way back ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding HeaderNotice, Mode=OneWay}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource Brush.Surface.Elevated}" CornerRadius="12" Padding="10,3" Margin="0,2,8,2" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OutputText, Mode=OneWay}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding OutputText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Soft}" />
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface.Elevated}" CornerRadius="12" Padding="10,3" Margin="0,2" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RateNote, Mode=OneWay}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RateNote, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Soft}" />
                    </Border>
                </WrapPanel>
                <TextBlock x:Name="PreviewCaption"
                           Style="{StaticResource Style.Text.ComposerLabel}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Text="Preview: low-rate monitoring pictures, fitted to each block without cropping. They are not the surgical feed." />
            </StackPanel>

            <Button x:Name="CloseComposerButton"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource Style.Button.Composer}"
                    Content="Back to displays"
                    ToolTip="Close the Composer. Changes that are not on screen are kept as a draft on the display card."
                    AutomationProperties.Name="Back to displays"
                    Click="Close_Click" />
        </Grid>

        <!-- ===== Body: left rail | canvas | right rail ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 280 / 320 (spec 5.2); narrower on a small window so the canvas keeps usable blocks (see code-behind) -->
                <ColumnDefinition x:Name="LeftRailColumn" Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="RightRailColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left rail: Step 1 layout, Step 2 place, Step 3 check and take ===== -->
            <ScrollViewer x:Name="LeftRailScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="0,0,4,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy, Mode=OneWay}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Step 1 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StepLayoutDone, Mode=OneWay}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Action.Take}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Take}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="1" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StepLayoutDone, Mode=OneWay}" Value="True">
                                                <Setter Property="Text" Value="✓" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAction}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock x:Name="StepLayoutHeading" Text="LAYOUT" Style="{StaticResource RailHeading}" VerticalAlignment="Center"
                                   AutomationProperties.Name="{Binding StepLayoutText, Mode=OneWay}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding LayoutOptions, Mode=OneWay}" Focusable="False" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="LayoutTile"
                                        Foreground="{DynamicResource Brush.Text.Primary}"
                                        MinHeight="96"
                                        Margin="0,0,0,8"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}"
                                        Click="LayoutTile_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd"
                                                    Background="{DynamicResource Brush.Surface.Card}"
                                                    BorderBrush="{DynamicResource Brush.Border.Control}"
                                                    BorderThickness="2"
                                                    CornerRadius="10"
                                                    Padding="10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsPending, Mode=OneWay}" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                                    <Setter TargetName="bd" Property="BorderThickness" Value="3" />
                                                </DataTrigger>
                                                <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <views:LayoutSchematic LayoutId="{Binding Id, Mode=OneWay}" VerticalAlignment="Center"
                                                               Width="{Binding SchematicWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:MultiViewComposerView}}"
                                                               Height="{Binding SchematicHeight, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:MultiViewComposerView}}" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Subtitle, Mode=OneWay}" Style="{StaticResource Style.Text.ComposerLabel}" />
                                            <TextBlock Text="✓ Selected" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Accent}" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Reading the display..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.CopyAccent}" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPending, Mode=OneWay}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Step 2 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StepPlaceDone, Mode=OneWay}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Action.Take}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Take}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="2" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StepPlaceDone, Mode=OneWay}" Value="True">
                                                <Setter Property="Text" Value="✓" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAction}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock x:Name="StepPlaceHeading" Text="PLACE SOURCES" Style="{StaticResource RailHeading}" VerticalAlignment="Center"
                                   AutomationProperties.Name="{Binding StepPlaceText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Style.Text.ComposerLabel}" Margin="0,0,0,6"
                               Text="Tap a source above, then its blocks - or tap an empty block." />

                    <!-- Sources a layout change left without a block -->
                    <StackPanel Margin="0,0,0,6">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UnplacedSources, Mode=OneWay, Converter={StaticResource HasItems}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Unplaced after the layout change - tap to place again:" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Status.StagedText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding UnplacedSources, Mode=OneWay}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="UnplacedChip"
                                            Style="{StaticResource Style.Button.Composer}"
                                            Margin="0,0,8,8"
                                            Background="{DynamicResource Brush.Surface.Staged}"
                                            BorderBrush="{DynamicResource Brush.Status.Staged}"
                                            Foreground="{DynamicResource Brush.Status.StagedChipText}"
                                            Content="{Binding SourceName, Mode=OneWay}"
                                            AutomationProperties.Name="{Binding SourceName, Mode=OneWay, StringFormat='Place {0} again - it has no block in this layout'}"
                                            Click="Unplaced_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Step 3 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanTake, Mode=OneWay}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Action.Take}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Take}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="3" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanTake, Mode=OneWay}" Value="True">
                                                <Setter Property="Text" Value="✓" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAction}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock x:Name="StepTakeHeading" Text="CHECK, THEN TAKE" Style="{StaticResource RailHeading}" VerticalAlignment="Center"
                                   AutomationProperties.Name="{Binding StepTakeText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Style.Text.ComposerLabel}" Text="Nothing changes on screen until Take." />
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Centre: the staged canvas ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Status line: what the frame shows, and Done placing / Cancel move -->
                <Grid Grid.Row="0" MinHeight="56" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="StagedLabel"
                                   Text="STAGED - not on screen yet"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Status.StagedText}"
                                   Visibility="{Binding IsStaged, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock x:Name="OnScreenLabel"
                                   Text="ON SCREEN - this is what the surgeon sees"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Accent}"
                                   Visibility="{Binding IsOnScreen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- Done placing / Cancel move (Disarm stops both) -->
                    <Button Grid.Column="1" x:Name="DoneButton" Click="Disarm_Click" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Composer}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Content" Value="Done placing" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MovingFromIndex, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Content" Value="Cancel move" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ArmedSource, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Content" Value="Done placing" />
                                        <Setter Property="Background" Value="{DynamicResource Brush.Border.DropTarget}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDropTarget}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- The screen: black canvas at the display's real aspect, framed by its state -->
                <Grid Grid.Row="1" x:Name="CanvasHost" Margin="8" Background="Transparent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy, Mode=OneWay}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <controls:FractionalLayoutPanel>
                        <controls:FractionalLayoutPanel.AspectRatio>
                            <MultiBinding Converter="{StaticResource AspectRatio}" Mode="OneWay">
                                <Binding Path="Draft.Plan.Width" Mode="OneWay" />
                                <Binding Path="Draft.Plan.Height" Mode="OneWay" />
                            </MultiBinding>
                        </controls:FractionalLayoutPanel.AspectRatio>
                        <Border controls:FractionalLayoutPanel.W="1" controls:FractionalLayoutPanel.H="1" Background="{DynamicResource Brush.Surface.PreviewMat}" />
                        <Rectangle x:Name="CanvasFrame"
                                   controls:FractionalLayoutPanel.W="1" controls:FractionalLayoutPanel.H="1"
                                   Margin="-6"
                                   RadiusX="10" RadiusY="10"
                                   StrokeThickness="3"
                                   IsHitTestVisible="False">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Border.Default}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnScreen, Mode=OneWay}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Brush.Status.Routed}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStaged, Mode=OneWay}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Brush.Status.Staged}" />
                                            <Setter Property="StrokeDashArray" Value="4 2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </controls:FractionalLayoutPanel>

                    <!-- Step 1 not done: say what to do -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="16">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Draft, Mode=OneWay}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Step 1 · Choose a layout on the left" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="The blocks appear here empty. Nothing changes on the surgeon's screen until you press Take."
                                   FontSize="15" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- The blocks -->
                    <ItemsControl x:Name="BlocksHost" ItemsSource="{Binding Blocks, Mode=OneWay}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:FractionalLayoutPanel>
                                    <controls:FractionalLayoutPanel.AspectRatio>
                                        <MultiBinding Converter="{StaticResource AspectRatio}" Mode="OneWay">
                                            <Binding Path="Draft.Plan.Width" Mode="OneWay" />
                                            <Binding Path="Draft.Plan.Height" Mode="OneWay" />
                                        </MultiBinding>
                                    </controls:FractionalLayoutPanel.AspectRatio>
                                </controls:FractionalLayoutPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="controls:FractionalLayoutPanel.X" Value="{Binding NormalizedX, Mode=OneWay}" />
                                <Setter Property="controls:FractionalLayoutPanel.Y" Value="{Binding NormalizedY, Mode=OneWay}" />
                                <Setter Property="controls:FractionalLayoutPanel.W" Value="{Binding NormalizedWidth, Mode=OneWay}" />
                                <Setter Property="controls:FractionalLayoutPanel.H" Value="{Binding NormalizedHeight, Mode=OneWay}" />
                                <Setter Property="Panel.ZIndex" Value="{Binding Index, Mode=OneWay, Converter={StaticResource PaintOrder}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Drop target: a source card (place) or another block (move / swap) -->
                                <Grid x:Name="BlockRoot"
                                      Margin="4"
                                      AllowDrop="True"
                                      DragEnter="Block_DragOver"
                                      DragOver="Block_DragOver"
                                      DragLeave="Block_DragLeave"
                                      Drop="Block_Drop">
                                    <!-- 1. The block itself: one tap = TapBlock (place / picker / strip / move target); drag = move -->
                                    <Button x:Name="BlockSurface"
                                            Foreground="{DynamicResource Brush.Text.Primary}"
                                            Click="Block_Click"
                                            PreviewMouseLeftButtonDown="BlockSurface_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="BlockSurface_PreviewMouseMove"
                                            LostMouseCapture="BlockSurface_LostMouseCapture"
                                            Cursor="Hand"
                                            FocusVisualStyle="{x:Null}"
                                            IsTabStop="{Binding IsTabStop, Mode=OneWay}"
                                            GotKeyboardFocus="BlockSurface_GotKeyboardFocus"
                                            AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{DynamicResource Brush.Surface.PreviewBackdrop}" CornerRadius="6" ClipToBounds="True">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid ClipToBounds="True">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailableForArmed, Mode=OneWay}" Value="False">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <!-- Live preview, fitted uniformly: never cropped or stretched -->
                                            <Image Source="{Binding PreviewBitmap, Mode=OneWay}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="LowQuality" />
                                            <!-- Placed non-AVAS source: no preview, say so with its name -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsPlaced, Mode=OneWay}" Value="True" />
                                                                    <Condition Binding="{Binding IsPreviewSupported, Mode=OneWay}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock x:Name="NoPreviewName" Text="{Binding SourceName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnScrim}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="NoPreviewLabel" Text="NO PREVIEW · non-AVAS source" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnPreview}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <!-- Empty block, nothing armed and no move: what a tap does -->
                                            <TextBlock x:Name="EmptyHint" Text="Tap to choose a source" FontSize="16" Foreground="{DynamicResource Brush.Text.OnPreview}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaced, Mode=OneWay}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.ArmedSource, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:MultiViewComposerView}, Converter={StaticResource IsNull}}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.MovingFromIndex, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:MultiViewComposerView}, Converter={StaticResource IsNull}}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>

                                    <!-- 2. State line: staged = dashed amber, on screen = solid blue, problem = red, selected = light blue -->
                                    <Rectangle RadiusX="6" RadiusY="6" IsHitTestVisible="False">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Stroke" Value="{DynamicResource Brush.Border.Control}" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State, Mode=OneWay}" Value="Staged">
                                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Status.Staged}" />
                                                        <Setter Property="StrokeThickness" Value="3" />
                                                        <Setter Property="StrokeDashArray" Value="4 2" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding State, Mode=OneWay}" Value="Live" />
                                                            <Condition Binding="{Binding IsPlaced, Mode=OneWay}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Status.Routed}" />
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding State, Mode=OneWay}" Value="Issue">
                                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Action.Danger}" />
                                                        <Setter Property="StrokeThickness" Value="3" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
                                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Focus.Ring}" />
                                                        <Setter Property="StrokeThickness" Value="3" />
                                                        <Setter Property="StrokeDashArray" Value="{x:Null}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMoveSource, Mode=OneWay}" Value="True">
                                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Border.DropTarget}" />
                                                        <Setter Property="StrokeThickness" Value="3" />
                                                        <Setter Property="StrokeDashArray" Value="2 2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <!-- 3. Armed and this block can take it: cyan ring + "+ Place TX2" -->
                                    <Grid IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ArmedSource, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:MultiViewComposerView}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAvailableForArmed, Mode=OneWay}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <!-- Already shows the armed source: nothing to offer -->
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource SameText}" Mode="OneWay">
                                                                <Binding Path="SourceMac" Mode="OneWay" />
                                                                <Binding Path="DataContext.ArmedSource.MacAddress" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=views:MultiViewComposerView}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Rectangle RadiusX="6" RadiusY="6" Fill="{DynamicResource Brush.Surface.ScrimTint}" Stroke="{DynamicResource Brush.Border.DropTarget}" StrokeThickness="3" />
                                        <Border x:Name="PlacePill" Background="{DynamicResource Brush.Surface.ScrimAccent}" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                                            <TextBlock x:Name="PlaceText" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnScrimAccent}" TextWrapping="Wrap" TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding DataContext.ArmedSource.DeviceName, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:MultiViewComposerView}, StringFormat='+ Place {0}'}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaced, Mode=OneWay}" Value="True">
                                                                <Setter Property="Text" Value="{Binding DataContext.ArmedSource.DeviceName, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:MultiViewComposerView}, StringFormat='Replace with {0}'}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- 3b. A drag over this block: cyan when it can take it -->
                                    <Rectangle x:Name="DropRing" RadiusX="6" RadiusY="6" Fill="{DynamicResource Brush.Surface.ScrimTint}" Stroke="{DynamicResource Brush.Border.DropTarget}"
                                               StrokeThickness="4" IsHitTestVisible="False" Visibility="Collapsed" />

                                    <!-- 4. Armed and this block cannot take it: lock + the reason, in words (chips hidden meanwhile) -->
                                    <Border Background="{DynamicResource Brush.Surface.Scrim}" CornerRadius="6" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailableForArmed, Mode=OneWay}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <!-- Top margin clears the block number; the reason trims (full text in the tooltip and the banner on tap) -->
                                        <DockPanel x:Name="UnavailableStack" Margin="12,48,12,6" MaxWidth="380" ToolTip="{Binding UnavailableReason, Mode=OneWay}">
                                            <Path x:Name="LockIcon"
                                                  DockPanel.Dock="Top"
                                                  Data="{StaticResource Icon.Lock}"
                                                  Stroke="{DynamicResource Brush.Text.OnScrim}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"
                                                  Width="22" Height="22"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center" />
                                            <TextBlock x:Name="ReasonText"
                                                       Text="{Binding UnavailableReason, Mode=OneWay}"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource Brush.Text.OnScrim}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Margin="0,4,0,0" />
                                        </DockPanel>
                                    </Border>

                                    <!-- 5. Moving: other blocks are destinations -->
                                    <Border x:Name="MovePill" Background="{DynamicResource Brush.Surface.ScrimAccent}" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.MovingFromIndex, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:MultiViewComposerView}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMoveSource, Mode=OneWay}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock x:Name="MoveText" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnScrimAccent}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Move here" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaced, Mode=OneWay}" Value="True">
                                                            <Setter Property="Text" Value="Swap here" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- 6. What blocks Take on this block (offline, size conflict) -->
                                    <Border x:Name="IssueBand" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="56,8,56,0"
                                            Background="{DynamicResource Brush.Surface.ScrimDanger}" BorderBrush="{DynamicResource Brush.Action.Danger}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,4" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IssueText, Mode=OneWay}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock x:Name="IssueTextBlock" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnAction}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                                            <Run Text="✕ " /><Run Text="{Binding IssueText, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>

                                    <!-- 7. Block number (28 px), top-left -->
                                    <Border x:Name="NumberChip" Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="10,0">
                                        <TextBlock x:Name="NumberText" Text="{Binding Label, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnScrim}" />
                                    </Border>

                                    <!-- 8. Source name pill and "Same as N" chip, bottom-left; output size bottom-right -->
                                    <Grid x:Name="PillRow" VerticalAlignment="Bottom" Margin="8" IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailableForArmed, Mode=OneWay}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The name gives way (ellipsis) on small blocks such as the PIP inset -->
                                        <Border x:Name="SourcePill" Grid.Column="0" Style="{StaticResource Chip}" Margin="0,0,6,0" HorizontalAlignment="Left"
                                                Visibility="{Binding IsPlaced, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock x:Name="SourcePillText" Text="{Binding SourceName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnScrim}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border x:Name="SameAsChip" Grid.Column="1" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Staged}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SameAsText, Mode=OneWay}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock x:Name="SameAsText" Text="{Binding SameAsText, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnScrim}" />
                                        </Border>
                                        <Border x:Name="SizeChip" Grid.Column="2" Style="{StaticResource Chip}" Padding="6,2">
                                            <TextBlock Text="{Binding SizeText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnScrim}" />
                                        </Border>
                                    </Grid>

                                    <!-- 10. Corner clear: 32 px glyph, 48 px hit area (transparent padding). Staged only, so one tap is safe. -->
                                    <Button x:Name="CornerClear"
                                            Width="48" Height="48"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,2,2,0"
                                            Cursor="Hand"
                                            IsTabStop="False"
                                            Command="{Binding ClearCommand, Mode=OneWay}"
                                            ToolTip="Clear this block (staged only)"
                                            AutomationProperties.Name="{Binding Number, Mode=OneWay, StringFormat='Clear block {0}'}"
                                            Visibility="{Binding IsPlaced, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Border x:Name="CornerClearGlyph"
                                                            Width="32" Height="32"
                                                            CornerRadius="16"
                                                            Background="{DynamicResource Brush.Surface.ScrimDanger}"
                                                            BorderBrush="{DynamicResource Brush.Text.DangerSoft}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnScrimDanger}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                                                        <Setter TargetName="CornerClearGlyph" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />
                                                        <Setter TargetName="CornerClearGlyph" Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- 8b. Keyboard focus: a 2 px ring in the block's margin (drawn here, not as an adorner, so it also renders), on the block the keyboard is on -->
                                    <Rectangle x:Name="BlockFocusRing" Margin="-3" RadiusX="8" RadiusY="8"
                                               Stroke="{DynamicResource Brush.Focus.Ring}" StrokeThickness="2" IsHitTestVisible="False">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding (views:InputModality.ShowsFocus), ElementName=BlockSurface, Mode=OneWay}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <!--
                                        9. Replace / Move strip (a tap on a placed block opens it; no hover anywhere). Centred on
                                        the block from a zero-size Canvas, so on a small block (a PIP inset) it may overhang the
                                        block instead of being clipped, and it is drawn above the corner clear.
                                    -->
                                    <Canvas Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border x:Name="Strip"
                                                Canvas.Left="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={StaticResource NegativeHalf}}"
                                                Canvas.Top="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={StaticResource NegativeHalf}}"
                                                Background="{DynamicResource Brush.Surface.FloatingStrip}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="10" Padding="6"
                                                Visibility="{Binding IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="ReplaceButton" Style="{StaticResource Style.Button.Composer}" Content="Replace" MinWidth="104" Margin="0,0,12,0"
                                                        AutomationProperties.Name="{Binding Number, Mode=OneWay, StringFormat='Replace the source of block {0}'}" Click="Replace_Click" />
                                                <Button x:Name="MoveButton" Style="{StaticResource Style.Button.Composer}" Content="Move" MinWidth="104"
                                                        AutomationProperties.Name="{Binding Number, Mode=OneWay, StringFormat='Move block {0} to another block'}" Click="Move_Click" />
                                            </StackPanel>
                                        </Border>
                                    </Canvas>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Tag, ElementName=BlockRoot}" Value="DropOk">
                                        <Setter TargetName="DropRing" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- Small blocks (under 240 px, e.g. a PIP inset or a 2x2 on a small window): smaller overlays, no size chip -->
                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=BlockRoot, Converter={StaticResource LessThan}, ConverterParameter=240}" Value="True">
                                        <Setter TargetName="NumberChip" Property="Margin" Value="4" />
                                        <Setter TargetName="NumberChip" Property="Padding" Value="6,0" />
                                        <Setter TargetName="NumberText" Property="FontSize" Value="18" />
                                        <Setter TargetName="PillRow" Property="Margin" Value="4" />
                                        <Setter TargetName="SourcePill" Property="Padding" Value="5,1" />
                                        <Setter TargetName="SourcePillText" Property="FontSize" Value="13" />
                                        <Setter TargetName="SameAsChip" Property="Padding" Value="5,1" />
                                        <Setter TargetName="SameAsText" Property="FontSize" Value="13" />
                                        <Setter TargetName="SizeChip" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="UnavailableStack" Property="Margin" Value="6,30,6,4" />
                                        <Setter TargetName="LockIcon" Property="Width" Value="16" />
                                        <Setter TargetName="LockIcon" Property="Height" Value="16" />
                                        <Setter TargetName="ReasonText" Property="FontSize" Value="13" />
                                        <Setter TargetName="PlacePill" Property="Padding" Value="8,4" />
                                        <Setter TargetName="PlaceText" Property="FontSize" Value="14" />
                                        <Setter TargetName="MovePill" Property="Padding" Value="8,4" />
                                        <Setter TargetName="MoveText" Property="FontSize" Value="14" />
                                        <!-- the hint wrapped over the number chip here (PIP inset at 1008x615): the "+ Place" pill and the tap say it -->
                                        <Setter TargetName="EmptyHint" Property="Visibility" Value="Collapsed" />
                                        <!-- the name is already in the pill: the centre says only what is missing -->
                                        <Setter TargetName="NoPreviewName" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="NoPreviewLabel" Property="Text" Value="NO PREVIEW" />
                                        <Setter TargetName="NoPreviewLabel" Property="FontSize" Value="13" />
                                        <Setter TargetName="IssueBand" Property="Margin" Value="4,30,4,0" />
                                        <Setter TargetName="IssueTextBlock" Property="FontSize" Value="13" />
                                        <Setter TargetName="Strip" Property="Padding" Value="4" />
                                        <Setter TargetName="ReplaceButton" Property="MinWidth" Value="0" />
                                        <Setter TargetName="ReplaceButton" Property="Padding" Value="10,6" />
                                        <Setter TargetName="ReplaceButton" Property="Margin" Value="0,0,6,0" />
                                        <Setter TargetName="MoveButton" Property="MinWidth" Value="0" />
                                        <Setter TargetName="MoveButton" Property="Padding" Value="10,6" />
                                        <Setter TargetName="CornerClear" Property="Margin" Value="0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <!-- ===== Right rail: ON SCREEN NOW and changes scroll; the banner, Take and its actions stay pinned ===== -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="RightRailScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel>
                        <Border Style="{StaticResource RailCard}">
                            <StackPanel>
                                <TextBlock Text="ON SCREEN NOW" Style="{StaticResource RailHeading}" Margin="0,0,0,8" />
                                <Grid x:Name="OnScreenPicture" AutomationProperties.Name="{Binding OnScreenSummary, Mode=OneWay}">
                                    <controls:FractionalLayoutPanel AspectRatio="1.7777777777777777" MinHeight="120">
                                        <Border controls:FractionalLayoutPanel.W="1" controls:FractionalLayoutPanel.H="1"
                                                Background="{DynamicResource Brush.Surface.PreviewMat}" BorderBrush="{DynamicResource Brush.Status.Routed}" BorderThickness="2" CornerRadius="6" />
                                    </controls:FractionalLayoutPanel>
                                    <ItemsControl ItemsSource="{Binding LiveBlocks, Mode=OneWay}" Focusable="False" IsHitTestVisible="False" Margin="2">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:FractionalLayoutPanel AspectRatio="1.7777777777777777" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="controls:FractionalLayoutPanel.X" Value="{Binding NormalizedX, Mode=OneWay}" />
                                                <Setter Property="controls:FractionalLayoutPanel.Y" Value="{Binding NormalizedY, Mode=OneWay}" />
                                                <Setter Property="controls:FractionalLayoutPanel.W" Value="{Binding NormalizedWidth, Mode=OneWay}" />
                                                <Setter Property="controls:FractionalLayoutPanel.H" Value="{Binding NormalizedHeight, Mode=OneWay}" />
                                                <Setter Property="Panel.ZIndex" Value="{Binding Index, Mode=OneWay, Converter={StaticResource PaintOrder}}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="1" Background="{DynamicResource Brush.Surface.PreviewTile}" BorderBrush="{DynamicResource Brush.Border.Control}" BorderThickness="1" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding PreviewBitmap, Mode=OneWay}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                                                        <TextBlock Text="{Binding SourceName, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnPreview}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPreviewSupported, Mode=OneWay}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Label, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnScrim}" Margin="4,2" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No MultiView on this screen" FontSize="14" Foreground="{DynamicResource Brush.Text.OnPreview}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LiveBlocks, Mode=OneWay, Converter={StaticResource HasItems}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding OutputText, Mode=OneWay}" Style="{StaticResource Style.Text.ComposerLabel}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RailCard}">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.StagedText}" Margin="0,0,0,6">
                                    <Run Text="CHANGES (" /><Run Text="{Binding ChangeCount, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                                <TextBlock Text="No staged changes.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.ComposerLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChangeLines, Mode=OneWay, Converter={StaticResource HasItems}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding ChangeLines, Mode=OneWay}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mode=OneWay}" FontSize="14" Foreground="{DynamicResource Brush.Text.Strong}" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <!-- The Composer's banner: placing / moving hint, refusals, Take result -->
                    <Border x:Name="BannerHost" BorderThickness="2" CornerRadius="10" Padding="10,6" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Info}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Banner.Kind, Mode=OneWay}" Value="None">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Banner.Kind, Mode=OneWay}" Value="Success">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.UndoToast}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Online}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Banner.Kind, Mode=OneWay}" Value="Warning">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Staged}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Staged}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Banner.Kind, Mode=OneWay}" Value="Error">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.DangerStrong}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Danger}" />
                                    </DataTrigger>
                                    <!-- An armed source draws the cyan of the blocks it can fill -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Banner.Kind, Mode=OneWay}" Value="Info" />
                                            <Condition Binding="{Binding ArmedSource, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.CopyTarget}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="15" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="i" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Banner.Kind, Mode=OneWay}" Value="Success">
                                                <Setter Property="Text" Value="✓" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.UndoToast}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Banner.Kind, Mode=OneWay}" Value="Warning">
                                                <Setter Property="Text" Value="!" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.StagedChipText}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Banner.Kind, Mode=OneWay}" Value="Error">
                                                <Setter Property="Text" Value="✕" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- A live region: hints, refusals and the Take result are read out when they appear; an error interrupts -->
                            <TextBlock x:Name="BannerText" Grid.Column="1" Text="{Binding Banner.Text, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Banner.Kind, Mode=OneWay}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.UndoToast}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Banner.Kind, Mode=OneWay}" Value="Warning">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.StagedChipText}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Banner.Kind, Mode=OneWay}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Danger}" />
                                                <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Banner.Kind, Mode=OneWay}" Value="Info" />
                                                    <Condition Binding="{Binding ArmedSource, Mode=OneWay, Converter={StaticResource IsNull}}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnCopyTarget}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button x:Name="TakeButton"
                            Style="{StaticResource Style.Button.Take}"
                            Content="{Binding TakeLabel, Mode=OneWay}"
                            IsEnabled="{Binding CanTake, Mode=OneWay}"
                            KeyboardNavigation.TabIndex="3"
                            AutomationProperties.Name="{Binding TakeAutomationName, Mode=OneWay}"
                            Click="Take_Click" />
                    <TextBlock x:Name="TakeBlockedReasonText"
                               Text="{Binding TakeBlockedReason, Mode=OneWay}"
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.ComposerLabel}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Soft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TakeBlockedReason, Mode=OneWay}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button x:Name="UndoButton"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            KeyboardNavigation.TabIndex="1"
                            AutomationProperties.Name="Undo - back to the previous picture"
                            Click="Undo_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Composer}">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Online}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanUndo, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- Wraps in the narrow (264 px) rail instead of clipping mid-word -->
                        <TextBlock Text="Undo - back to the previous picture" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>

                    <!-- Tab order of the right rail: Undo, Discard, Clear all, and Take last (review the changes, then take) -->
                    <Grid Margin="0,8,0,0" KeyboardNavigation.TabIndex="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DiscardButton" Grid.Column="0" Content="Discard"
                                ToolTip="Go back to what is on screen now"
                                Click="Discard_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Composer}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Draft, Mode=OneWay}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy, Mode=OneWay}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="ClearAllButton" Grid.Column="2" Content="Clear all"
                                ToolTip="Empty every block (staged only)"
                                Click="ClearAll_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Composer}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StepPlaceDone, Mode=OneWay}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy, Mode=OneWay}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== Block-first picker: anchored to the block, source tiles with their live thumbnail; capped and scrollable ===== -->
        <Popup x:Name="PickerPopup"
               Placement="Center"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="None"
               Closed="PickerPopup_Closed">
            <Border x:Name="PickerFrame"
                    Background="{DynamicResource Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    MaxWidth="760"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    PreviewKeyDown="PickerFrame_PreviewKeyDown">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PickerTitle" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Grid.Column="1" Style="{StaticResource Style.Button.Composer}" Content="Cancel" Click="PickerCancel_Click" />
                    </Grid>
                    <TextBlock x:Name="PickerEmpty" DockPanel.Dock="Top" Text="No sources discovered." Style="{StaticResource Style.Text.ComposerLabel}" Visibility="Collapsed" />
                    <ScrollViewer x:Name="PickerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <ItemsControl x:Name="PickerItems" Focusable="False" Margin="0,0,4,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="PickerTile"
                                            Foreground="{DynamicResource Brush.Text.Primary}"
                                            Width="220"
                                            MinHeight="160"
                                            Margin="0,0,12,12"
                                            Cursor="Hand"
                                            IsEnabled="{Binding IsEnabled, Mode=OneWay}"
                                            AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}"
                                            Click="PickerTile_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource Brush.Surface.Popup}" BorderBrush="{DynamicResource Brush.Border.Control}" BorderThickness="2" CornerRadius="10" Padding="10">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.DropTarget}" />
                                                    </Trigger>
                                                    <Trigger Property="views:InputModality.ShowsFocus" Value="True">
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <Border Height="112" Background="{DynamicResource Brush.Surface.PreviewBlack}" CornerRadius="6" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding Source.PreviewBitmap, Mode=OneWay}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled, Mode=OneWay}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.4" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <TextBlock Text="NO PREVIEW · non-AVAS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnPreview}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Source.IsPreviewSupported, Mode=OneWay}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Source.DeviceName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Source.LinkMode, Mode=OneWay}" Style="{StaticResource Style.Text.ComposerLabel}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Path Data="{StaticResource Icon.Lock}" Stroke="{DynamicResource Brush.Text.Strong}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"
                                                      Margin="0,2,6,0" VerticalAlignment="Top">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled, Mode=OneWay}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock Text="{Binding Note, Mode=OneWay}" FontSize="14" Foreground="{DynamicResource Brush.Text.Strong}" TextWrapping="Wrap" MaxWidth="180" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
