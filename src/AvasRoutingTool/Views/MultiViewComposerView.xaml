<UserControl x:Class="AvasRoutingTool.Views.MultiViewComposerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvasRoutingTool.Views"
             xmlns:controls="clr-namespace:AvasRoutingTool.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource Brush.Text.Primary}">

    <!--
        The MultiView Composer for one display (spec 5.2): left rail = Step 1 layout tiles, centre = the staged canvas
        at the display's real aspect, right rail = ON SCREEN NOW, changes and (pinned) Take. DataContext =
        MultiViewComposerViewModel. Every control calls the view model; nothing reaches the device before Take.
    -->
    <UserControl.Resources>
        <views:AspectRatioConverter x:Key="AspectRatio" />
        <views:PaintOrderConverter x:Key="PaintOrder" />
        <views:HasItemsConverter x:Key="HasItems" />
        <views:IsNullConverter x:Key="IsNull" />
        <views:SameTextConverter x:Key="SameText" />
        <views:LessThanConverter x:Key="LessThan" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NegativeHalfConverter x:Key="NegativeHalf" />


    </UserControl.Resources>

    <!-- Transparent background: a tap on any empty area stops placing / moving (spec 6) -->
    <!-- Any release anywhere in the view also ends the block drag gesture (no stale press can start a drag later) -->
    <Grid Background="Transparent" MouseLeftButtonUp="Root_MouseLeftButtonUp" PreviewMouseLeftButtonUp="Root_PreviewMouseLeftButtonUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header: which display, its output, and the way back ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding HeaderNotice, Mode=OneWay}" Style="{StaticResource Style.Text.Lead}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="OutputChip" Style="{StaticResource Style.Text.Meta}"
                               Text="{Binding OutputText, Mode=OneWay}"
                               Visibility="{Binding OutputText, Mode=OneWay, Converter={StaticResource Converter.Visible.NotEmpty}}" />
                    <TextBlock x:Name="RateChip" Style="{StaticResource Style.Text.Meta}"
                               Text="{Binding RateNote, Mode=OneWay}"
                               Visibility="{Binding RateNote, Mode=OneWay, Converter={StaticResource Converter.Visible.NotEmpty}}" />
                </WrapPanel>
                <TextBlock x:Name="PreviewCaption"
                           Style="{StaticResource Style.Text.ComposerLabel}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Text="Preview: low-rate monitoring pictures, fitted to each block without cropping. They are not the surgical feed." />
            </StackPanel>

            <Button x:Name="CloseComposerButton"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource Style.Button.Composer}"
                    ToolTip="Close the Composer. Changes that are not on screen are kept as a draft on the display card."
                    AutomationProperties.Name="Back to displays"
                    Click="Close_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="{StaticResource Size.Icon.M}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Back to displays" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== Body: left rail | canvas | right rail ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Rails are star columns clamped by tokens (240-320 / 264-360): they grow with the window and the canvas keeps the rest -->
                <ColumnDefinition x:Name="LeftRailColumn" Width="24*"
                                  MinWidth="{StaticResource Size.Composer.Rail.Left.Min}" MaxWidth="{StaticResource Size.Composer.Rail.Left.Max}" />
                <ColumnDefinition Width="52*" />
                <ColumnDefinition x:Name="RightRailColumn" Width="24*"
                                  MinWidth="{StaticResource Size.Composer.Rail.Right.Min}" MaxWidth="{StaticResource Size.Composer.Rail.Right.Max}" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left rail: Step 1 layout and the sources a layout change left unplaced ===== -->
            <ScrollViewer x:Name="LeftRailScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="0,0,4,0" Style="{StaticResource Style.Panel.BusyDisables}">

                    <!-- Step 1 -->
                    <controls:StepHeader x:Name="StepLayoutHeading" Style="{StaticResource Style.StepHeader}" Margin="0,0,0,6"
                                         Number="1" Title="LAYOUT" IsDone="{Binding StepLayoutDone, Mode=OneWay}"
                                         AutomationProperties.Name="{Binding StepLayoutText, Mode=OneWay}" />

                    <ItemsControl ItemsSource="{Binding LayoutOptions, Mode=OneWay}" Focusable="False" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="LayoutTile"
                                        Style="{StaticResource Style.Button.ComposerLayoutOption}"
                                        AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}"
                                        Click="LayoutTile_Click"
                                        MouseEnter="LayoutTile_Preview"
                                        GotKeyboardFocus="LayoutTile_Preview"
                                        MouseLeave="LayoutTile_PreviewEnd"
                                        LostKeyboardFocus="LayoutTile_PreviewEnd">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6*" />
                                            <ColumnDefinition Width="7*" />
                                        </Grid.ColumnDefinitions>
                                        <views:LayoutSchematic LayoutId="{Binding Id, Mode=OneWay}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title, Mode=OneWay}" Style="{StaticResource Style.Text.Lead}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Subtitle, Mode=OneWay}" Style="{StaticResource Style.Text.ComposerLabel}" />
                                            <StackPanel x:Name="SelectedRow" Orientation="Horizontal" Margin="0,2,0,0"
                                                        Visibility="{Binding IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="{StaticResource Size.Icon.S}" Foreground="{DynamicResource Brush.Text.Accent}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Selected" Style="{StaticResource Style.Text.Selected}" />
                                            </StackPanel>
                                            <TextBlock Text="Reading the display..." Style="{StaticResource Style.Text.Pending}" Margin="0,2,0,0"
                                                       Visibility="{Binding IsPending, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Sources a layout change left without a block -->
                    <StackPanel Margin="0,0,0,6"
                                Visibility="{Binding UnplacedSources, Mode=OneWay, Converter={StaticResource Converter.Visible.HasItems}}">
                        <TextBlock Text="Unplaced after the layout change - tap to place again:" Style="{StaticResource Style.Text.Notice.Staged}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding UnplacedSources, Mode=OneWay}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="UnplacedChip"
                                            Style="{StaticResource Style.Button.UnplacedChip}"
                                            Content="{Binding SourceName, Mode=OneWay}"
                                            AutomationProperties.Name="{Binding SourceName, Mode=OneWay, StringFormat='Place {0} again - it has no block in this layout'}"
                                            Click="Unplaced_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Centre: the staged canvas ===== -->
            <Grid Grid.Column="1" Margin="16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Status line: what the frame shows, and Done placing / Cancel move -->
                <Grid Grid.Row="0" MinHeight="{StaticResource Size.Touch.Min}" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Step 2 heads this row. The WrapPanel moves the status under the heading when the canvas is narrow (a 1024 px window) -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <controls:StepHeader x:Name="StepPlaceHeading" Style="{StaticResource Style.StepHeader}" Margin="0,0,12,0" VerticalAlignment="Center"
                                             Number="2" Title="PLACE SOURCES" IsDone="{Binding StepPlaceDone, Mode=OneWay}"
                                             AutomationProperties.Name="{Binding StepPlaceText, Mode=OneWay}"
                                             AutomationProperties.HelpText="Tap a source in the strip above, then its blocks - or tap an empty block." />

                        <StackPanel VerticalAlignment="Center">
                            <!-- A Grid, not a horizontal StackPanel: the word may wrap beside its dot, and a StackPanel would give it unlimited width -->
                            <Grid Visibility="{Binding IsStaged, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StagedDot" Style="{StaticResource Style.Shape.StagedDot}" />
                                <TextBlock x:Name="StagedLabel" Grid.Column="1"
                                           Text="STAGED - not on screen yet"
                                           Style="{StaticResource Style.Text.Status.Staged}" />
                            </Grid>
                            <TextBlock x:Name="OnScreenLabel"
                                       Text="ON SCREEN - this is what the surgeon sees"
                                       Style="{StaticResource Style.Text.Status.OnScreen}"
                                       Visibility="{Binding IsOnScreen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Done placing / Cancel move (Disarm stops both) -->
                    <Button Grid.Column="1" x:Name="DoneButton" Click="Disarm_Click" VerticalAlignment="Center" Style="{StaticResource Style.Button.Done}" />
                </Grid>

                <!-- The screen: black canvas at the display's real aspect, framed by its state -->
                <Grid Grid.Row="1" x:Name="CanvasHost" Margin="8" Background="Transparent" Style="{StaticResource Style.Panel.BusyDisables}">

                    <controls:FractionalLayoutPanel>
                        <controls:FractionalLayoutPanel.AspectRatio>
                            <MultiBinding Converter="{StaticResource AspectRatio}" Mode="OneWay">
                                <Binding Path="Draft.Plan.Width" Mode="OneWay" />
                                <Binding Path="Draft.Plan.Height" Mode="OneWay" />
                            </MultiBinding>
                        </controls:FractionalLayoutPanel.AspectRatio>
                        <Border controls:FractionalLayoutPanel.W="1" controls:FractionalLayoutPanel.H="1" Background="{DynamicResource Brush.Surface.PreviewMat}" />
                        <!-- Step 1 not done: a ghost of the layout under the pointer or the keyboard (default 2x2); view only, never staged -->
                        <views:LayoutSchematic x:Name="GhostSchematic" Style="{StaticResource Style.Panel.Ghost}"
                                               LayoutId="{Binding PreviewLayoutId, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:MultiViewComposerView}}"
                                               controls:FractionalLayoutPanel.W="1" controls:FractionalLayoutPanel.H="1" />
                        <Rectangle x:Name="CanvasFrame" Style="{StaticResource Style.Shape.CanvasFrame}"
                                   controls:FractionalLayoutPanel.W="1" controls:FractionalLayoutPanel.H="1" />
                    </controls:FractionalLayoutPanel>

                    <!-- Step 1 not done: say what to do -->
                    <Border Style="{StaticResource Style.Panel.Placeholder}"
                            Visibility="{Binding Draft, Mode=OneWay, Converter={StaticResource Converter.Visible.Null}}">
                        <StackPanel>
                            <TextBlock Text="Step 1 · Choose a layout on the left" Style="{StaticResource Style.Text.Lead}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="The blocks appear here empty. Nothing changes on the surgeon's screen until you press Take."
                                       Style="{StaticResource Style.Text.ComposerLabel}" TextAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- The blocks -->
                    <ItemsControl x:Name="BlocksHost" ItemsSource="{Binding Blocks, Mode=OneWay}" Focusable="False" ItemContainerStyle="{StaticResource Style.Item.Fractional.Block}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:FractionalLayoutPanel>
                                    <controls:FractionalLayoutPanel.AspectRatio>
                                        <MultiBinding Converter="{StaticResource AspectRatio}" Mode="OneWay">
                                            <Binding Path="Draft.Plan.Width" Mode="OneWay" />
                                            <Binding Path="Draft.Plan.Height" Mode="OneWay" />
                                        </MultiBinding>
                                    </controls:FractionalLayoutPanel.AspectRatio>
                                </controls:FractionalLayoutPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Drop target: a source card (place) or another block (move / swap) -->
                                <Grid x:Name="BlockRoot"
                                      Margin="4"
                                      AllowDrop="True"
                                      DragEnter="Block_DragOver"
                                      DragOver="Block_DragOver"
                                      DragLeave="Block_DragLeave"
                                      Drop="Block_Drop">
                                    <!-- 1. The block itself: one tap = TapBlock (place / picker / strip / move target); drag = move -->
                                    <Button x:Name="BlockSurface"
                                            Style="{StaticResource Style.Button.BlockSurface}"
                                            Click="Block_Click"
                                            PreviewMouseLeftButtonDown="BlockSurface_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="BlockSurface_PreviewMouseMove"
                                            LostMouseCapture="BlockSurface_LostMouseCapture"
                                            IsTabStop="{Binding IsTabStop, Mode=OneWay}"
                                            GotKeyboardFocus="BlockSurface_GotKeyboardFocus"
                                            AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}"
                                            ToolTip="{Binding DataContext.ArmedSource.DeviceName, Mode=OneWay, RelativeSource={RelativeSource AncestorType=views:MultiViewComposerView}}">
                                        <Grid Style="{StaticResource Style.Panel.BlockContent}">
                                            <!-- Live preview, fitted uniformly: never cropped or stretched -->
                                            <Image Source="{Binding PreviewBitmap, Mode=OneWay}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="LowQuality" />
                                            <!-- Placed non-AVAS source: no preview, say so with its name -->
                                            <StackPanel Style="{StaticResource Style.Panel.NoPreview}">
                                                <TextBlock x:Name="NoPreviewName" Text="{Binding SourceName, Mode=OneWay}" Style="{StaticResource Style.Text.Block.Title}" Foreground="{DynamicResource Brush.Text.OnScrim}" />
                                                <TextBlock x:Name="NoPreviewLabel" Text="NO PREVIEW · non-AVAS source" Style="{StaticResource Style.Text.Block.Caption}" Foreground="{DynamicResource Brush.Text.OnPreview}" />
                                            </StackPanel>
                                            <!-- Empty block, nothing armed and no move: what a tap does -->
                                            <TextBlock x:Name="EmptyHint" Text="Tap to choose a source" Style="{StaticResource Style.Text.Block.Hint}" Foreground="{DynamicResource Brush.Text.OnPreview}" />
                                        </Grid>
                                    </Button>

                                    <!-- 2. State line: staged = dashed amber, on screen = solid blue, problem = red, selected = light blue -->
                                    <Rectangle Style="{StaticResource Style.Shape.BlockState}" />

                                    <!-- 3. Armed and this block can take it: cyan ring + "+ Place TX2" -->
                                    <Grid Style="{StaticResource Style.Panel.PlaceOverlay}">
                                        <Rectangle x:Name="PlaceRing" Style="{StaticResource Style.Shape.PlaceRing}" />
                                        <Border x:Name="PlacePill" Style="{StaticResource Style.Pill.Action}" Background="{DynamicResource Brush.Surface.ScrimAccent}" Margin="8">
                                            <StackPanel>
                                                <TextBlock x:Name="PlaceVerbText" Style="{StaticResource Style.Text.Block.PlaceVerb}" Foreground="{DynamicResource Brush.Text.OnScrimAccent}" />
                                                <TextBlock x:Name="PlaceNameText" Style="{StaticResource Style.Text.Block.PlaceName}" Foreground="{DynamicResource Brush.Text.OnScrimAccent}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 3b. A drag over this block: cyan when it can take it -->
                                    <Rectangle x:Name="DropRing" RadiusX="6" RadiusY="6" Fill="{DynamicResource Brush.Surface.ScrimTint}" Stroke="{DynamicResource Brush.Border.DropTarget}"
                                               StrokeThickness="4" IsHitTestVisible="False" Visibility="Collapsed" />

                                    <!-- 4. Armed and this block cannot take it: lock + the reason, in words (chips hidden meanwhile) -->
                                    <Border Style="{StaticResource Style.Panel.UnavailableOverlay}" Background="{DynamicResource Brush.Surface.Scrim}">
                                        <DockPanel x:Name="UnavailableStack" Style="{StaticResource Style.Panel.UnavailableStack}" ToolTip="{Binding UnavailableReason, Mode=OneWay}">
                                            <ui:SymbolIcon x:Name="LockIcon" Symbol="LockClosed24" Style="{StaticResource Style.Icon.BlockLock}" Foreground="{DynamicResource Brush.Text.OnScrim}" />
                                            <TextBlock x:Name="ReasonText" Text="{Binding UnavailableReason, Mode=OneWay}" Style="{StaticResource Style.Text.Block.Reason}" Foreground="{DynamicResource Brush.Text.OnScrim}" />
                                        </DockPanel>
                                    </Border>

                                    <!-- 5. Moving: other blocks are destinations -->
                                    <Border x:Name="MovePill" Style="{StaticResource Style.Pill.Move}" Background="{DynamicResource Brush.Surface.ScrimAccent}">
                                        <TextBlock x:Name="MoveText" Style="{StaticResource Style.Text.Block.MoveAction}" Foreground="{DynamicResource Brush.Text.OnScrimAccent}" />
                                    </Border>

                                    <!-- 6. What blocks Take on this block (offline, size conflict) -->
                                    <Border x:Name="IssueBand" Style="{StaticResource Style.Panel.IssueBand}"
                                            Background="{DynamicResource Brush.Surface.ScrimDanger}" BorderBrush="{DynamicResource Brush.Action.Danger}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="{StaticResource Size.Icon.S}" Foreground="{DynamicResource Brush.Text.OnAction}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="IssueTextBlock" Text="{Binding IssueText, Mode=OneWay}" Style="{StaticResource Style.Text.Block.Chip}" Foreground="{DynamicResource Brush.Text.OnAction}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 7. Block number, top-left -->
                                    <Border x:Name="NumberChip" Style="{StaticResource Style.Chip.Number}">
                                        <TextBlock x:Name="NumberText" Text="{Binding Label, Mode=OneWay}" Style="{StaticResource Style.Text.Block.Number}" Foreground="{DynamicResource Brush.Text.OnScrim}" />
                                    </Border>

                                    <!-- 8. Source name pill and "Same as N" chip, bottom-left; output size bottom-right -->
                                    <Grid x:Name="PillRow" Style="{StaticResource Style.Panel.BlockPills}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The name gives way (ellipsis) on small blocks such as the PIP inset -->
                                        <Border x:Name="SourcePill" Grid.Column="0" Style="{StaticResource Style.Chip.Scrim}" Margin="0,0,6,0" HorizontalAlignment="Left"
                                                Visibility="{Binding IsPlaced, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock x:Name="SourcePillText" Text="{Binding SourceName, Mode=OneWay}" Style="{StaticResource Style.Text.Block.Pill}" Foreground="{DynamicResource Brush.Text.OnScrim}" />
                                        </Border>
                                        <Border x:Name="SameAsChip" Grid.Column="1" Style="{StaticResource Style.Chip.SameAs}" Margin="0,0,6,0">
                                            <TextBlock x:Name="SameAsText" Text="{Binding SameAsText, Mode=OneWay}" Style="{StaticResource Style.Text.Block.Chip}" Foreground="{DynamicResource Brush.Text.OnScrim}" />
                                        </Border>
                                        <Border x:Name="SizeChip" Grid.Column="2" Style="{StaticResource Style.Chip.Size}">
                                            <TextBlock Text="{Binding SizeText, Mode=OneWay}" Style="{StaticResource Style.Text.Block.Chip}" Foreground="{DynamicResource Brush.Text.OnScrim}" />
                                        </Border>
                                    </Grid>

                                    <!-- 10. Corner clear: 32 px glyph, 48 px hit area. Staged only, so one tap is safe. -->
                                    <Button x:Name="CornerClear"
                                            Style="{StaticResource Style.Button.CornerClear}"
                                            Command="{Binding ClearCommand, Mode=OneWay}"
                                            ToolTip="Clear this block (staged only)"
                                            AutomationProperties.Name="{Binding Number, Mode=OneWay, StringFormat='Clear block {0}'}"
                                            Visibility="{Binding IsPlaced, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- 8b. Keyboard focus ring on the block the keyboard is on -->
                                    <Rectangle x:Name="BlockFocusRing" Style="{StaticResource Style.Shape.BlockFocusRing}" />

                                    <!--
                                        9. Replace / Move strip (a tap on a placed block opens it; no hover anywhere). Centred on
                                        the block from a zero-size Canvas, so on a small block (a PIP inset) it may overhang the
                                        block instead of being clipped, and it is drawn above the corner clear.
                                    -->
                                    <Canvas Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border x:Name="Strip" Style="{StaticResource Style.Surface.FloatingStrip}"
                                                Canvas.Left="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={StaticResource NegativeHalf}}"
                                                Canvas.Top="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={StaticResource NegativeHalf}}"
                                                Visibility="{Binding IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <UniformGrid Columns="2">
                                                <Button x:Name="ReplaceButton" Style="{StaticResource Style.Button.Strip}" Content="Replace" Margin="0,0,4,0"
                                                        AutomationProperties.Name="{Binding Number, Mode=OneWay, StringFormat='Replace the source of block {0}'}" Click="Replace_Click" />
                                                <Button x:Name="MoveButton" Style="{StaticResource Style.Button.Strip}" Content="Move" Margin="4,0,0,0"
                                                        AutomationProperties.Name="{Binding Number, Mode=OneWay, StringFormat='Move block {0} to another block'}" Click="Move_Click" />
                                            </UniformGrid>
                                        </Border>
                                    </Canvas>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Tag, ElementName=BlockRoot}" Value="DropOk">
                                        <Setter TargetName="DropRing" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding (views:InputModality.ShowsFocus), ElementName=BlockSurface, Mode=OneWay}" Value="True">
                                        <Setter TargetName="BlockFocusRing" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- Small blocks (under 240 px, e.g. a PIP inset or a 2x2 on a small window): every overlay style reads BlockDensity.IsCompact -->
                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=BlockRoot, Converter={StaticResource LessThan}, ConverterParameter={x:Static views:BlockDensity.CompactBelow}}" Value="True">
                                        <Setter TargetName="BlockRoot" Property="views:BlockDensity.IsCompact" Value="True" />
                                        <Setter TargetName="NoPreviewLabel" Property="Text" Value="NO PREVIEW" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <!-- ===== Right rail: ON SCREEN NOW and changes scroll; the banner, Take and its actions stay pinned ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="RightRailScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <!-- At least as tall as the rail, so the Changes card stretches into the free height; taller content still scrolls -->
                    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ui:Card x:Name="OnScreenCard" Grid.Row="0" Style="{StaticResource Style.Card.Rail}">
                            <StackPanel>
                                <TextBlock Text="ON SCREEN NOW" Style="{StaticResource Style.Text.RailHeading}" Margin="0,0,0,8" />
                                <Grid x:Name="OnScreenPicture" AutomationProperties.Name="{Binding OnScreenSummary, Mode=OneWay}">
                                    <controls:FractionalLayoutPanel AspectRatio="{Binding LiveAspectRatio, Mode=OneWay}">
                                        <Border controls:FractionalLayoutPanel.W="1" controls:FractionalLayoutPanel.H="1"
                                                Background="{DynamicResource Brush.Surface.PreviewMat}" BorderBrush="{DynamicResource Brush.Status.Routed}" BorderThickness="2" CornerRadius="6" />
                                    </controls:FractionalLayoutPanel>
                                    <ItemsControl ItemsSource="{Binding LiveBlocks, Mode=OneWay}" Focusable="False" IsHitTestVisible="False" Margin="2"
                                                  ItemContainerStyle="{StaticResource Style.Item.Fractional.Block}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:FractionalLayoutPanel AspectRatio="{Binding LiveAspectRatio, Mode=OneWay}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Style.Surface.LiveTile}">
                                                    <Grid>
                                                        <Image Source="{Binding PreviewBitmap, Mode=OneWay}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                                                        <TextBlock Text="{Binding SourceName, Mode=OneWay}" Style="{StaticResource Style.Text.Tile.Name}" Foreground="{DynamicResource Brush.Text.OnPreview}"
                                                                   Visibility="{Binding IsPreviewSupported, Mode=OneWay, Converter={StaticResource Converter.Visible.False}}" />
                                                        <TextBlock Text="{Binding Label, Mode=OneWay}" Style="{StaticResource Style.Text.Tile.Label}" Foreground="{DynamicResource Brush.Text.OnScrim}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Empty mat: the display's name as a name plate, then the sentence -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding LiveBlocks, Mode=OneWay, Converter={StaticResource Converter.Visible.NoItems}}">
                                        <TextBlock x:Name="NamePlateText" Text="{Binding DisplayName, Mode=OneWay}" Style="{StaticResource Style.Text.Block.NamePlate}" Foreground="{DynamicResource Brush.Text.OnPreview}" />
                                        <TextBlock Text="No MultiView on this screen" Style="{StaticResource Style.Text.Title}" Foreground="{DynamicResource Brush.Text.OnPreview}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding OutputText, Mode=OneWay}" Style="{StaticResource Style.Text.ComposerLabel}" Margin="0,8,0,0" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card x:Name="ChangesCard" Grid.Row="1" Style="{StaticResource Style.Card.Rail.Fill}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- The dot shows only while there is something staged -->
                                    <Ellipse x:Name="ChangesDot" Style="{StaticResource Style.Shape.StagedDot}"
                                             Visibility="{Binding ChangeLines, Mode=OneWay, Converter={StaticResource Converter.Visible.HasItems}}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Style.Text.RailHeading.Staged}">
                                        <Run Text="CHANGES (" /><Run Text="{Binding ChangeCount, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="No staged changes." Style="{StaticResource Style.Text.ComposerLabel}"
                                           Visibility="{Binding ChangeLines, Mode=OneWay, Converter={StaticResource Converter.Visible.NoItems}}" />
                                <ItemsControl ItemsSource="{Binding ChangeLines, Mode=OneWay}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mode=OneWay}" Style="{StaticResource Style.Text.Change}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <!-- Step 3 heads the pinned cluster: the check and the Take below it -->
                    <controls:StepHeader x:Name="StepTakeHeading" Style="{StaticResource Style.StepHeader}" Margin="0,0,0,4"
                                         Number="3" Title="CHECK, THEN TAKE" IsDone="{Binding CanTake, Mode=OneWay}"
                                         AutomationProperties.Name="{Binding StepTakeText, Mode=OneWay}"
                                         AutomationProperties.HelpText="Nothing changes on screen until you press Take." />

                    <!-- The Composer's banner: placing / moving hint, refusals, Take result -->
                    <Border x:Name="BannerHost" Style="{StaticResource Style.Banner.Composer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Style="{StaticResource Style.Icon.Banner}" />
                            <!-- A live region: hints, refusals and the Take result are read out when they appear; an error interrupts -->
                            <TextBlock x:Name="BannerText" Grid.Column="1" Text="{Binding Banner.Text, Mode=OneWay}" Style="{StaticResource Style.Text.Banner}" />
                        </Grid>
                    </Border>

                    <Button x:Name="TakeButton"
                            Style="{StaticResource Style.Button.Take}"
                            Content="{Binding TakeLabel, Mode=OneWay}"
                            IsEnabled="{Binding CanTake, Mode=OneWay}"
                            KeyboardNavigation.TabIndex="3"
                            AutomationProperties.Name="{Binding TakeAutomationName, Mode=OneWay}"
                            Click="Take_Click" />
                    <TextBlock x:Name="TakeBlockedReasonText"
                               Text="{Binding TakeBlockedReason, Mode=OneWay}"
                               Style="{StaticResource Style.Text.Reason}" />

                    <Button x:Name="UndoButton"
                            Style="{StaticResource Style.Button.Undo}"
                            KeyboardNavigation.TabIndex="1"
                            AutomationProperties.Name="Undo - back to the previous picture"
                            Click="Undo_Click">
                        <!-- Wraps in the narrow (264 px) rail instead of clipping mid-word -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="{StaticResource Size.Icon.M}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Undo - back to the previous picture" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Tab order of the right rail: Undo, Discard, Clear all, and Take last (review the changes, then take) -->
                    <UniformGrid Columns="2" Margin="0,8,0,0" KeyboardNavigation.TabIndex="2">
                        <Button x:Name="DiscardButton" Style="{StaticResource Style.Button.Discard}" Margin="0,0,6,0" Content="Discard"
                                ToolTip="Go back to what is on screen now"
                                Click="Discard_Click" />
                        <Button x:Name="ClearAllButton" Style="{StaticResource Style.Button.ClearAll}" Margin="6,0,0,0" Content="Clear all"
                                ToolTip="Empty every block (staged only)"
                                Click="ClearAll_Click" />
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== Block-first picker: anchored to the block, source tiles with their live thumbnail; capped and scrollable ===== -->
        <Popup x:Name="PickerPopup"
               Placement="Center"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="None"
               Closed="PickerPopup_Closed">
            <Border x:Name="PickerFrame"
                    Style="{StaticResource Style.Surface.Popup}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    PreviewKeyDown="PickerFrame_PreviewKeyDown">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PickerTitle" Style="{StaticResource Style.Text.Lead}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Grid.Column="1" Style="{StaticResource Style.Button.Composer}" Content="Cancel" Click="PickerCancel_Click" />
                    </Grid>
                    <TextBlock x:Name="PickerEmpty" DockPanel.Dock="Top" Text="No sources discovered." Style="{StaticResource Style.Text.ComposerLabel}" Visibility="Collapsed" />
                    <ScrollViewer x:Name="PickerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <ItemsControl x:Name="PickerItems" Focusable="False" Margin="0,0,4,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="{StaticResource Size.Composer.Picker.Tile}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="PickerTile"
                                            Style="{StaticResource Style.Button.PickerTile}"
                                            IsEnabled="{Binding IsEnabled, Mode=OneWay}"
                                            AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}"
                                            Click="PickerTile_Click">
                                        <StackPanel>
                                            <controls:FractionalLayoutPanel AspectRatio="{x:Static views:AspectRatioConverter.Default}">
                                                <Border controls:FractionalLayoutPanel.W="1" controls:FractionalLayoutPanel.H="1"
                                                        Background="{DynamicResource Brush.Surface.PreviewBlack}" CornerRadius="6" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding Source.PreviewBitmap, Mode=OneWay}" Style="{StaticResource Style.Image.Preview}" />
                                                        <TextBlock Text="NO PREVIEW · non-AVAS" Style="{StaticResource Style.Text.Picker.NoPreview}" Foreground="{DynamicResource Brush.Text.OnPreview}" />
                                                    </Grid>
                                                </Border>
                                            </controls:FractionalLayoutPanel>
                                            <TextBlock Text="{Binding Source.DeviceName, Mode=OneWay}" Style="{StaticResource Style.Text.Picker.Name}" />
                                            <TextBlock Text="{Binding Source.LinkMode, Mode=OneWay}" Style="{StaticResource Style.Text.ComposerLabel}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <ui:SymbolIcon Symbol="LockClosed24" Style="{StaticResource Style.Icon.PickerLock}" />
                                                <TextBlock Text="{Binding Note, Mode=OneWay}" Style="{StaticResource Style.Text.Picker.Note}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
