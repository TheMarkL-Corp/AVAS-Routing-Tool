{
  // The ONE allowlist of the UI v2 guards (UiV2Guards.cs). Paths are relative to src/AvasRoutingTool.
  // Sessions only ADD entries: a migration task removes its file from "pending" first (the suite goes red), then migrates until green.

  // Every view file that breaks a rule today -> owner and task (plan task ids). A file is enforced as soon as it leaves this list.
  "pending": {
    "MainWindow.xaml": "Main Window session: A5 (app bar, brand), A6 (Logs)",
    "Views/VisualRoutingView.xaml": "Main Window session: A7",
    "Views/SourceCardView.xaml": "Main Window session: A8",
    "Views/DisplayCardView.xaml": "Main Window session: A9-A11",
    "Views/SettingsDialog.xaml": "Main Window session: A12",
    "Views/MultiViewComposerView.xaml": "Composer session: Tasks 4-10 (ratchet until Task 12)",
    "Views/CompactSourceCardView.xaml": "Composer session: Task 11",
    "Views/LayoutSchematic.xaml": "Composer session: Tasks 5b and 11"
  },

  // An element with a literal Width/Height that is a vector icon host (brand mark canvas, geometry placeholders).
  // { "file": "MainWindow.xaml", "contains": "<text of the element's opening tag>", "reason": "why a token cannot do" }
  "staticIcons": [],

  // A ListBox / ListView / DataGrid that is NOT virtualized. The card grids are ItemsControls (not covered by the rule) and stay
  // unvirtualized on purpose: each card owns a live RTP preview, so a card must stay realized (D11, zero socket leaks).
  "unvirtualizedLists": [],

  // An inline Style without BasedOn that cannot be a central style (for example RowDefinition.Style, an ItemContainerStyle).
  "inlineStyleExceptions": []
}
