index 0000000..5c11c80
--- /dev/null
+++ b/src/AvasRoutingTool/Resources/MaterialIcons.xaml
@@ -0,0 +1,38 @@
+<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
+                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
+                    xmlns:ctl="clr-namespace:AvasRoutingTool.Controls">
+
+    <!-- GENERATED by tools/icons/import-material-icons.ps1 - do not edit by hand.
+         Material Symbols Rounded, weight 400, outline, 24px (Apache-2.0, see THIRD-PARTY-NOTICES.md).
+         Geometry is in a 24 x 24 box; MaterialIcon scales it. Fill rule is NonZero (the F1 prefix; WPF defaults to EvenOdd). -->
+
+    <!-- Default size of MaterialIcon: Size.Icon.M. A style (setter) or a local Width/Height overrides it. -->
+    <Style TargetType="{x:Type ctl:MaterialIcon}">
+        <Setter Property="Width" Value="{DynamicResource Size.Icon.M}" />
+        <Setter Property="Height" Value="{DynamicResource Size.Icon.M}" />
