+            {
+                try { TestResources.Ensure(); body(); }
+                catch (Exception ex) { failure = ex; }
+            });
+            t.SetApartmentState(ApartmentState.STA);
+            t.Start();
+            t.Join();
+            if (failure != null) throw new Xunit.Sdk.XunitException("MaterialIcon failure: " + failure);
