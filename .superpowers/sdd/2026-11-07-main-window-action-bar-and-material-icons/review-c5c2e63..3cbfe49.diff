@@ -0,0 +1,77 @@
+# Converts an SVG path 'd' from the Material Symbols viewBox (0 -960 960 960) to a 24 x 24 box:
+# x' = x / 40, y' = (y + 960) / 40. Relative commands only scale; absolute ones also translate.
+# Supports M m L l H h V v C c S s Q q T t A a Z z. Any other command fails loudly.
+function Format-Num([double]$v) {
+    $r = [math]::Round($v, 4)
+    if ($r -eq 0) { return '0' }
+    return $r.ToString('0.####', [System.Globalization.CultureInfo]::InvariantCulture)
+}
+
+function ConvertTo-Material24Path([string]$d) {
+    $inv = [System.Globalization.CultureInfo]::InvariantCulture
+    $numRe = [regex]'\G[-+]?(?:\d*\.\d+|\d+\.?)(?:[eE][-+]?\d+)?'
+    $counts = @{ M=2; L=2; H=1; V=1; C=6; S=4; Q=4; T=2; A=7; Z=0 }
+    $pos = 0; $n = $d.Length
+    $out = New-Object System.Text.StringBuilder
+    $cmd = $null
+    $isFirst = $true; $firstRel = $false
+    function Skip-Sep { while ($script:pos -lt $script:n -and ($script:d[$script:pos] -eq ' ' -or $script:d[$script:pos] -eq ',' -or $script:d[$script:pos] -eq "`t" -or $script:d[$script:pos] -eq "`n" -or $script:d[$script:pos] -eq "`r")) { $script:pos++ } }
+    $script:pos = 0; $script:n = $n; $script:d = $d
+    while ($true) {
+        Skip-Sep
+        if ($script:pos -ge $n) { break }
+        $ch = $d[$script:pos]
+        if ([char]::IsLetter($ch)) {
+            if ('MmLlHhVvCcSsQqTtAaZz'.IndexOf($ch) -lt 0) { throw "Unsupported SVG path command '$ch'" }
+            $cmd = $ch; $script:pos++
+            # The first 'm' of a path is absolute (the current point starts at 0,0 of the viewBox origin), so it must be translated too.
+            $firstRel = $false
+            if ($isFirst -and $cmd -ceq 'm') { $cmd = 'M'; $firstRel = $true }
+            [void]$out.Append($cmd)
+            if ($cmd -eq 'Z' -or $cmd -eq 'z') { $cmd = $null; continue }
+        } elseif ($null -eq $cmd) {
+            throw "Path data has numbers without a command at index $($script:pos)"
+        }
+        $isFirst = $false
+        $up = [char]::ToUpper($cmd); $abs = ($cmd -ceq $up)
+        $cnt = $counts[[string]$up]
+        $nums = @()
+        for ($i = 0; $i -lt $cnt; $i++) {
+            Skip-Sep
+            if ($up -eq 'A' -and ($i -eq 3 -or $i -eq 4)) {
+                $f = $d[$script:pos]
+                if ($f -ne '0' -and $f -ne '1') { throw "Bad arc flag '$f' at index $($script:pos)" }
+                $nums += [double]::Parse([string]$f, $inv); $script:pos++
+            } else {
+                $m = $numRe.Match($d, $script:pos)
+                if (-not $m.Success) { throw "Expected a number at index $($script:pos)" }
+                $nums += [double]::Parse($m.Value, $inv); $script:pos += $m.Length
+            }
+        }
+        $vals = @()
+        for ($i = 0; $i -lt $cnt; $i++) {
+            $v = $nums[$i]
+            switch ($up) {
+                'H' { $v = $v / 40; if ($abs) { } }
+                'V' { $v = if ($abs) { ($v + 960) / 40 } else { $v / 40 } }
+                'A' {
+                    if ($i -le 1) { $v = $v / 40 }
+                    elseif ($i -eq 5) { $v = $v / 40 }
+                    elseif ($i -eq 6) { $v = if ($abs) { ($v + 960) / 40 } else { $v / 40 } }
+                }
+                default {
+                    if ($i % 2 -eq 0) { $v = $v / 40 } else { $v = if ($abs) { ($v + 960) / 40 } else { $v / 40 } }
+                }
+            }
+            $vals += (Format-Num $v)
+        }
+        [void]$out.Append(($vals -join ' '))
+        # implicit repeat: M becomes L, m becomes l
+        if ($cmd -ceq 'M') { $cmd = if ($firstRel) { 'l' } else { 'L' } } elseif ($cmd -ceq 'm') { $cmd = 'l' }
+        Skip-Sep
+        if ($script:pos -lt $n -and -not [char]::IsLetter($d[$script:pos])) { [void]$out.Append(' ') }
+        if ($script:pos -lt $n -and [char]::IsLetter($d[$script:pos])) { continue }
+        if ($script:pos -lt $n) { [void]$out.Append($cmd) }
+    }
+    return $out.ToString()
+}
diff --git a/tools/icons/import-material-icons.ps1 b/tools/icons/import-material-icons.ps1
new file mode 100644
index 0000000..33de1f7
--- /dev/null
+++ b/tools/icons/import-material-icons.ps1
@@ -0,0 +1,52 @@
+<#
+ Imports Material Symbols Rounded icons (weight 400, outline, 24px) from Google's open-source repository
+ (https://github.com/google/material-design-icons, Apache-2.0) and regenerates
+ src/AvasRoutingTool/Resources/MaterialIcons.xaml as 24 x 24 Geometry resources keyed MIcon.<name>.
+ Idempotent: SVGs already in tools/icons/svg are not downloaded again (use -Force to refresh).
+ Only raw.githubusercontent.com is contacted. Run from anywhere:  pwsh tools/icons/import-material-icons.ps1
+#>
+param([switch]$Force)
+$ErrorActionPreference = 'Stop'
+
+$Names = @(
+    'settings','sync','light_mode','dark_mode','cleaning_services','folder_open','edit','info','play_arrow','stop','check',
+    'lock','expand_more','content_copy','grid_view','power_settings_new','desktop_windows','videocam','chevron_left',
+    'chevron_right','close','warning'
+)
+
+. (Join-Path $PSScriptRoot 'SvgPathConverter.ps1')
+
+$svgDir = Join-Path $PSScriptRoot 'svg'
+$outFile = Join-Path $PSScriptRoot '..\..\src\AvasRoutingTool\Resources\MaterialIcons.xaml'
+New-Item -ItemType Directory -Force $svgDir | Out-Null
+
+$sb = New-Object System.Text.StringBuilder
+[void]$sb.AppendLine('<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"')
+[void]$sb.AppendLine('                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">')
+[void]$sb.AppendLine('')
+[void]$sb.AppendLine('    <!-- GENERATED by tools/icons/import-material-icons.ps1 - do not edit by hand.')
+[void]$sb.AppendLine('         Material Symbols Rounded, weight 400, outline, 24px (Apache-2.0, see THIRD-PARTY-NOTICES.md).')
+[void]$sb.AppendLine('         Geometry is in a 24 x 24 box; MaterialIcon scales it. Fill rule is NonZero (the F1 prefix; WPF defaults to EvenOdd). -->')
+[void]$sb.AppendLine('')
+
+foreach ($name in $Names) {
+    $file = Join-Path $svgDir "$name.svg"
+    if ($Force -or -not (Test-Path $file)) {
+        $url = "https://raw.githubusercontent.com/google/material-design-icons/master/symbols/web/$name/materialsymbolsrounded/${name}_24px.svg"
+        Write-Host "Downloading $url"
+        Invoke-WebRequest -Uri $url -OutFile $file -UseBasicParsing
+    }
+    $svg = [xml](Get-Content -Raw -Encoding UTF8 $file)
+    if ($svg.svg.viewBox -ne '0 -960 960 960') { throw "$name.svg: unexpected viewBox '$($svg.svg.viewBox)'" }
+    $paths = @($svg.svg.path)
+    if ($paths.Count -lt 1) { throw "$name.svg: no <path>" }
+    foreach ($p in $paths) { if ($p.'fill-rule' -eq 'evenodd') { throw "$name.svg: evenodd fill rule is not supported by this generator" } }
+    $d = 'F1 ' + (($paths | ForEach-Object { ConvertTo-Material24Path $_.d }) -join ' ')
+    [void]$sb.AppendLine("    <Geometry x:Key=`"MIcon.$name`">$d</Geometry>")
+}
+[void]$sb.AppendLine('')
+[void]$sb.AppendLine('</ResourceDictionary>')
+
+$utf8 = New-Object System.Text.UTF8Encoding($false)
+[System.IO.File]::WriteAllText([System.IO.Path]::GetFullPath($outFile), $sb.ToString().Replace("`r`n","`n"), $utf8)
+Write-Host "Wrote $($Names.Count) icons to $outFile"
